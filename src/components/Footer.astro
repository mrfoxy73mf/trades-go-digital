---
const today = new Date();
const isLettingDesk = Astro.url.pathname.startsWith("/tgd-lettingdesk");
const isTgdTrades = Astro.url.pathname === "/tgd" || Astro.url.pathname.startsWith("/tgd/");
---

<footer class:list={{ "footer-tgd-trades": isTgdTrades }}>
	<div class="footer-main">
		<a class="footer-brand" href="/" aria-label="Trades Go Digital home">
			<img src="/images/trades-go-digital-logo-stripe.png" alt="Trades Go Digital" />
		</a>
		<div class="footer-message">
			<strong>Practical software for working businesses.</strong>
			<span>Websites, business apps and straightforward UK support.</span>
		</div>
		<nav aria-label="Footer navigation">
			<a href="/#explore">Products</a><a href="/pricing">Pricing</a>
			<a href="/monthly-updates">Updates</a><a href="/contact">Contact</a>
		</nav>
		<a class="footer-cta" href={isLettingDesk ? "/tgd-lettingdesk/#enquire" : "/contact/#tgd-enquiry"}>
			{isLettingDesk ? "Enquire about LettingDesk" : "Talk to us"}
		</a>
	</div>
	<div class="footer-bottom">
		<span>&copy; {today.getFullYear()} Trades Go Digital Ltd.</span>
		<a href="mailto:hello@trades-go-digital.co.uk">hello@trades-go-digital.co.uk</a>
		<a href="/terms-and-conditions">Terms &amp; Conditions</a>
	</div>
</footer>

<style>
	footer{box-sizing:border-box;background:#07111f;color:#c7d8e8;border-top:1px solid rgba(109,199,255,.16);font-family:Inter,ui-sans-serif,system-ui,sans-serif}footer *{box-sizing:border-box}
	.footer-main{display:grid;grid-template-columns:auto minmax(210px,1fr) auto auto;align-items:center;gap:28px;width:min(1180px,calc(100% - 32px));margin:0 auto;padding:30px 0 22px}
	.footer-brand{display:inline-flex;padding:7px 10px;border-radius:9px;background:#fff}.footer-brand img{display:block;width:176px;height:auto}
	.footer-message{display:grid;gap:3px;min-width:0}.footer-message strong{color:#fff;font-size:.95rem}.footer-message span{color:#9fb0c3;font-size:.78rem}
	nav{display:flex;flex-wrap:wrap;gap:8px 18px;justify-content:center}a{color:#d8e6f3;font-size:.84rem;font-weight:800;text-decoration:none}a:hover{color:#fff}
	.footer-cta{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:10px 16px;border-radius:8px;background:#ff8a36;color:#07111f;white-space:nowrap}.footer-cta:hover{background:#ffa25e;color:#07111f}
	.footer-bottom{display:flex;align-items:center;justify-content:space-between;gap:16px 24px;width:min(1180px,calc(100% - 32px));margin:0 auto;padding:16px 0 22px;border-top:1px solid rgba(109,199,255,.12);color:#8194a9;font-size:.78rem}.footer-bottom a{color:inherit;font-size:inherit;overflow-wrap:anywhere}
	footer.footer-tgd-trades{background:rgba(3,5,8,.88);border-top-color:rgba(255,107,0,.34)}footer.footer-tgd-trades .footer-brand{display:inline-flex}
	@media(max-width:980px){.footer-main{grid-template-columns:auto 1fr auto}.footer-main nav{grid-column:1/-1;grid-row:2;justify-content:flex-start}}
	@media(max-width:680px){.footer-main{grid-template-columns:1fr;gap:17px;padding-top:24px}.footer-main nav{grid-column:auto;grid-row:auto;justify-content:flex-start}.footer-cta{width:100%}.footer-bottom{flex-direction:column;align-items:flex-start;gap:7px}}
	@media print{footer{display:none!important}}
</style>
