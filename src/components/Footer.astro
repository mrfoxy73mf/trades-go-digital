---
const today = new Date();
const isLettingDesk = Astro.url.pathname.startsWith("/tgd-lettingdesk");
const isTgdTrades = Astro.url.pathname === "/tgd" || Astro.url.pathname.startsWith("/tgd/");
---

<footer class:list={["site-footer", { "footer-tgd-trades": isTgdTrades }]}>
	<div class="footer-main">
		<a class="footer-brand" href="/" aria-label="Trades Go Digital home">
			<img src="/images/trades-go-digital-logo-stripe.png" alt="Trades Go Digital" />
		</a>
		<div class="footer-message">
			<strong>Practical software for working businesses.</strong>
			<span>Websites, business apps and straightforward UK support.</span>
		</div>
		<nav aria-label="Footer navigation">
			<a href="/#explore">Products</a><a href="/pricing">Pricing</a>
			<a href="/monthly-updates">Updates</a><a href="/contact">Contact</a>
		</nav>
		<a class="footer-cta" href={isLettingDesk ? "/tgd-lettingdesk/#enquire" : "/contact/#tgd-enquiry"}>
			{isLettingDesk ? "Enquire about LettingDesk" : "Talk to us"}
		</a>
	</div>
	<div class="footer-bottom">
		<span>&copy; {today.getFullYear()} Trades Go Digital Ltd.</span>
		<a href="mailto:hello@trades-go-digital.co.uk">hello@trades-go-digital.co.uk</a>
		<a href="/terms-and-conditions">Terms &amp; Conditions</a>
	</div>
</footer>

<style>
	footer.site-footer{box-sizing:border-box;background:transparent!important;color:#c7d8e8!important;border:0!important;padding:40px 16px!important;font-family:Inter,ui-sans-serif,system-ui,sans-serif}footer.site-footer *{box-sizing:border-box}
	footer.site-footer .footer-main{display:grid;grid-template-columns:auto minmax(210px,1fr) auto auto;align-items:center;gap:28px;width:min(1180px,100%)!important;margin:0 auto!important;padding:22px 24px 18px!important;background:rgba(7,17,31,.94)!important;border:0!important;border-radius:14px 14px 0 0!important;color:#c7d8e8!important;box-shadow:none!important}
	footer.site-footer .footer-brand{display:inline-flex!important;padding:5px 8px!important;border:0!important;border-radius:8px!important;background:#fff!important;box-shadow:none!important}footer.site-footer .footer-brand img{display:block;width:150px!important;height:auto}
	footer.site-footer .footer-message{display:grid;gap:3px;min-width:0}footer.site-footer .footer-message strong{color:#fff!important;font-size:.95rem}footer.site-footer .footer-message span{color:#9fb0c3!important;font-size:.78rem}
	footer.site-footer nav{display:flex;flex-wrap:wrap;gap:8px 18px;justify-content:center}footer.site-footer a{color:#d8e6f3!important;font-size:.84rem;font-weight:800;text-decoration:none}footer.site-footer a:hover{color:#ffad70!important}
	.footer-cta{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:10px 16px;border-radius:8px;background:#ff8a36;color:#07111f;white-space:nowrap}.footer-cta:hover{background:#ffa25e;color:#07111f}
	footer.site-footer .footer-bottom{display:flex;align-items:center;justify-content:space-between;gap:16px 24px;width:min(1180px,100%)!important;margin:0 auto!important;padding:14px 24px 18px!important;background:rgba(7,17,31,.94)!important;border:0!important;border-top:1px solid rgba(109,199,255,.16)!important;border-radius:0 0 14px 14px!important;color:#9fb0c3!important;font-size:.78rem;box-shadow:none!important}footer.site-footer .footer-bottom a{color:#d8e6f3!important;font-size:inherit;overflow-wrap:anywhere}
	@media(max-width:980px){footer.site-footer .footer-main{grid-template-columns:auto minmax(0,1fr) auto!important}footer.site-footer .footer-main nav{grid-column:1/-1;grid-row:2;justify-content:flex-start}}
	@media(max-width:680px){footer.site-footer{padding:24px 12px!important}footer.site-footer .footer-main{grid-template-columns:minmax(0,1fr)!important;gap:17px!important;padding:22px 20px 18px!important}footer.site-footer .footer-main>*{min-width:0;max-width:100%}footer.site-footer .footer-main nav{grid-column:auto;grid-row:auto;justify-content:flex-start}footer.site-footer .footer-cta{width:100%!important;white-space:normal!important}footer.site-footer .footer-bottom{flex-direction:column;align-items:flex-start;gap:7px;padding:14px 20px 18px!important}}
	@media print{footer{display:none!important}}
</style>
