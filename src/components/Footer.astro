---
const today = new Date();

const productLinks = [
	{ label: "TGD Trades", href: "/tgd" },
	{ label: "TAD The Business", href: "/tad-the-business" },
	{ label: "TGD LettingDesk", href: "/tgd-lettingdesk" },
	{ label: "SafeWork AI", href: "/health-and-safety" },
];

const toolLinks = [
	{ label: "PDF Maker", href: "/pdf-maker" },
	{ label: "Logo Maker", href: "/logo-maker" },
	{ label: "Business Tools", href: "/business-tools" },
	{ label: "Traffic Management", href: "/traffic-management" },
	{ label: "Monthly Updates", href: "/monthly-updates" },
];
---

<footer class="site-footer">
	<div class="footer-main">
		<section class="footer-brand" aria-label="Trades Go Digital">
			<a href="/" aria-label="Trades Go Digital home">
				<img src="/images/trades-go-digital-logo-stripe.png" alt="Trades Go Digital" />
			</a>
			<p>Practical software, documents and business tools built around real working days.</p>
			<a class="footer-cta" href="/contact">Contact Trades Go Digital</a>
		</section>

		<nav aria-label="Products">
			<h2>Business platforms</h2>
			{productLinks.map((link) => <a href={link.href}>{link.label}</a>)}
		</nav>

		<nav aria-label="Tools and resources">
			<h2>Tools &amp; resources</h2>
			{toolLinks.map((link) => <a href={link.href}>{link.label}</a>)}
		</nav>

		<nav aria-label="Company">
			<h2>Company</h2>
			<a href="/">Home</a>
			<a href="/pricing">Pricing</a>
			<a href="/contact">Contact</a>
			<a href="/contact#tgd-enquiry">Support Centre</a>
			<a href="/terms-and-conditions">Terms &amp; Conditions</a>
		</nav>
	</div>

	<div class="footer-bottom">
		<span>&copy; {today.getFullYear()} Trades Go Digital</span>
		<a href="mailto:hello@trades-go-digital.co.uk">hello@trades-go-digital.co.uk</a>
		<span>Built in the UK</span>
	</div>
</footer>

<style>
	.site-footer{box-sizing:border-box;background:#07111f;color:#c7d8e8;border-top:1px solid #6dc7ff24;padding:48px 16px 24px;font-family:Inter,ui-sans-serif,system-ui,sans-serif}.site-footer *{box-sizing:border-box}.footer-main{display:grid;grid-template-columns:minmax(250px,1.4fr) repeat(3,minmax(145px,.7fr));gap:32px;width:min(1180px,100%);margin:auto}.footer-brand{display:grid;align-content:start;justify-items:start;gap:16px}.footer-brand>a:first-child{display:inline-flex;padding:7px 10px;border-radius:10px;background:#fff}.footer-brand img{display:block;width:min(230px,70vw);height:auto}.footer-brand p{max-width:350px;margin:0;color:#aebdcc;line-height:1.6}.footer-cta{display:inline-flex;min-height:44px;align-items:center;justify-content:center;padding:11px 16px;border-radius:8px;background:#ff8a36;color:#07111f!important;font-weight:900}.site-footer nav{display:grid;align-content:start;gap:10px}.site-footer h2{margin:0 0 8px;color:#ffad70;font-size:.78rem;letter-spacing:.08em;text-transform:uppercase}.site-footer a{color:#d8e6f3;font-size:.88rem;font-weight:750;text-decoration:none}.site-footer a:hover{color:#ffad70}.footer-bottom{display:flex;align-items:center;justify-content:space-between;gap:16px;width:min(1180px,100%);margin:36px auto 0;padding-top:18px;border-top:1px solid #6dc7ff24;color:#91a4b8;font-size:.8rem}.footer-bottom a{font-size:inherit}@media(max-width:900px){.footer-main{grid-template-columns:1fr 1fr}.footer-brand{grid-column:1/-1}}@media(max-width:560px){.site-footer{padding:36px 18px 22px}.footer-main{grid-template-columns:1fr;gap:28px}.footer-brand{grid-column:auto}.footer-cta{width:100%}.footer-bottom{align-items:flex-start;flex-direction:column;gap:8px}}@media print{.site-footer{display:none!important}}
</style>
