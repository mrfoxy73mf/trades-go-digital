---
import { TGD_APP_URL } from "../consts";
const path = Astro.url.pathname.replace(/\/$/, "") || "/tgd";
const active = (href: string) => path === href;
---
<header class="tgd-navigation">
 <nav class="navigation-shell" aria-label="Primary navigation">
  <a class="navigation-brand" href="/tgd" aria-label="TGD Trades home"><img src="/images/trades-go-digital-icon-stripe.png" width="46" height="46" alt="" /><span>TGD <b>Trades</b><small>Your business office</small></span></a>
  <button class="navigation-toggle" type="button" aria-expanded="false" aria-controls="tgd-navigation-links" hidden>Menu <span aria-hidden="true">☰</span></button>
  <div class="navigation-links" id="tgd-navigation-links">
   <a class="navigation-link" href="/tgd" aria-current={active("/tgd") ? "page" : undefined}>TGD Trades</a>
   <a class="navigation-link" href="/pricing" aria-current={active("/pricing") ? "page" : undefined}>Pricing</a>
   <a class="navigation-link" href="/contact" aria-current={active("/contact") ? "page" : undefined}>Contact</a>
   <a class="navigation-link" href="/terms-and-conditions" aria-current={active("/terms-and-conditions") ? "page" : undefined}>Terms</a>
   <a class="navigation-cta" href={TGD_APP_URL}>Open TGD Trades<span aria-hidden="true">↗</span></a>
  </div>
 </nav>
</header>
<script>
 const header=document.querySelector<HTMLElement>('.tgd-navigation');
 if(header){
  const toggle=header.querySelector<HTMLButtonElement>('.navigation-toggle')!;
  toggle.hidden=false;header.classList.add('navigation-ready');
  const close=()=>{header.classList.remove('navigation-open');toggle.setAttribute('aria-expanded','false');};
  toggle.addEventListener('click',()=>{const open=header.classList.toggle('navigation-open');toggle.setAttribute('aria-expanded',String(open));});
  document.addEventListener('click',event=>{if(event.target instanceof Node&&!header.contains(event.target))close();});
  header.addEventListener('keydown',event=>{if(event.key==='Escape'){close();toggle.focus();}});
  header.querySelectorAll('a').forEach(link=>link.addEventListener('click',close));
  matchMedia('(min-width: 1081px)').addEventListener('change',close);
 }
</script>
<style>
.tgd-navigation{position:relative;z-index:50;background:#07111f!important;color:#f8fafc;border:0;box-shadow:0 5px 22px #07111f24;font-family:Inter,ui-sans-serif,system-ui,sans-serif}
.tgd-navigation *{box-sizing:border-box}.navigation-shell{position:relative;width:min(1440px,calc(100% - 48px));min-height:88px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:28px}
a{text-decoration:none;color:inherit}.navigation-brand{display:flex;align-items:center;gap:12px;flex-shrink:0;font-size:20px;font-weight:850;letter-spacing:-.5px;line-height:1.25}.navigation-brand img{border-radius:11px;background:white;object-fit:contain}.navigation-brand b{color:#ff8a36}.navigation-brand small{display:block;margin-top:5px;color:#aebdcc;font-size:10px;font-weight:600;letter-spacing:1.1px;text-transform:uppercase}
.navigation-links{display:flex;align-items:center;gap:6px}.navigation-link,summary{display:flex;align-items:center;gap:9px;padding:12px 14px;border-radius:8px;color:#d5dfeb;font-size:14px;font-weight:750;white-space:nowrap;cursor:pointer;line-height:1.5}
.navigation-link:hover,summary:hover,.navigation-link[aria-current],summary.apps-active{background:#ffffff0e;color:#ffad70}summary{list-style:none}summary::-webkit-details-marker{display:none}summary>span{font-size:20px;line-height:1}.navigation-apps[open] summary>span{transform:rotate(180deg)}
.navigation-apps{position:static}.apps-panel{position:absolute;top:calc(100% - 4px);right:0;left:auto;width:min(610px,100%);padding:22px;background:#fff;color:#07111f;border:1px solid #e4e9ef;border-radius:16px;box-shadow:0 20px 60px #0004}.apps-label{margin:0 0 14px;color:#687487;font-size:11px;font-weight:750;text-transform:uppercase;letter-spacing:.8px}.apps-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.apps-grid a{padding:14px;border-radius:9px;background:#f5f7fa}.apps-grid a:hover,.apps-grid a[aria-current]{background:#fff0e3}.apps-grid strong{display:flex;justify-content:space-between;gap:8px;font-size:14px}.apps-grid strong span{color:#b34b00}.apps-grid small{display:block;margin-top:5px;color:#526174;font-size:12px;line-height:1.5}.all-tools{display:flex;justify-content:space-between;margin-top:16px;padding:10px 14px 0;font-size:13px;font-weight:800;color:#a84400}
.navigation-cta{display:flex;align-items:center;justify-content:center;gap:14px;margin-left:12px;padding:13px 18px;border-radius:9px;background:#ff8a36;color:#07111f;font-size:13px;font-weight:850;white-space:nowrap}.navigation-cta:hover{background:#ffa25e}.navigation-toggle{display:none}a:focus-visible,summary:focus-visible,button:focus-visible{outline:3px solid #ff8a36;outline-offset:4px}
@media(max-width:1080px){.navigation-shell{flex-wrap:wrap;gap:0;min-height:80px;padding:16px 0}.navigation-toggle:not([hidden]){display:flex;align-items:center;gap:10px;border:1px solid #536174;border-radius:8px;padding:10px 14px;color:#fff;background:transparent;font:inherit;font-size:14px;cursor:pointer}.navigation-links{width:100%;align-items:stretch;flex-direction:column;padding-top:18px}.navigation-ready:not(.navigation-open) .navigation-links{display:none}.navigation-apps summary{justify-content:space-between}.apps-panel{position:static;width:100%;margin:8px 0;box-shadow:none}.navigation-cta{margin:10px 0 0}.navigation-link,summary{min-height:44px}}
@media(max-width:520px){.navigation-shell{position:relative;width:calc(100% - 28px)}.navigation-brand{font-size:17px;gap:9px}.navigation-brand img{width:40px;height:40px}.navigation-brand small{font-size:8px;letter-spacing:.6px}.apps-grid{grid-template-columns:1fr}.apps-panel{padding:14px}.navigation-toggle:not([hidden]){padding:9px 10px}}
@media print{.tgd-navigation{display:none!important}}
</style>
