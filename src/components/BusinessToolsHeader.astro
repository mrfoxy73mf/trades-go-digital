---
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const active = (href: string) => path === href;
---
<header class="tools-navigation"><nav aria-label="Business Tools navigation">
  <a class="tools-brand" href="/business-tools/" aria-label="Business Tools home"><img src="/images/trades-go-digital-icon-stripe.png" width="42" height="42" alt="" /><span><strong>Trades <b>Go</b> Digital</strong><small>Business Tools</small></span></a>
  <button class="tools-toggle" type="button" aria-expanded="false" aria-controls="business-tools-links">Menu <span aria-hidden="true">☰</span></button>
  <div class="tools-links" id="business-tools-links"><a href="/business-tools/" aria-current={active("/business-tools") ? "page" : undefined}>Business Tools</a><a href="/logo-maker/" aria-current={active("/logo-maker") ? "page" : undefined}>Logo Maker</a><a href="/pdf-maker/" aria-current={active("/pdf-maker") ? "page" : undefined}>PDF Maker</a><a href="/business-tools/support/" aria-current={active("/business-tools/support") ? "page" : undefined}>Support</a><a href="/business-tools/terms/" aria-current={active("/business-tools/terms") ? "page" : undefined}>Terms</a></div>
</nav></header>
<script>
 const header=document.querySelector<HTMLElement>('.tools-navigation');if(header){const button=header.querySelector<HTMLButtonElement>('.tools-toggle')!;const links=header.querySelector<HTMLElement>('.tools-links')!;button.addEventListener('click',()=>{const open=header.classList.toggle('is-open');button.setAttribute('aria-expanded',String(open))});links.querySelectorAll('a').forEach(link=>link.addEventListener('click',()=>{header.classList.remove('is-open');button.setAttribute('aria-expanded','false')}));}
</script>
<style>
.tools-navigation{position:relative;z-index:100;background:#07111f;color:#f8fafc;border-bottom:1px solid #1d3852;font-family:Inter,ui-sans-serif,system-ui,sans-serif}.tools-navigation *{box-sizing:border-box}.tools-navigation nav{width:min(1280px,calc(100% - 36px));min-height:78px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:28px}.tools-brand{display:flex;align-items:center;gap:11px;color:inherit;text-decoration:none;line-height:1.1}.tools-brand img{border-radius:9px;background:#fff;object-fit:contain}.tools-brand strong{font-size:17px}.tools-brand strong b{color:#ff7a1a}.tools-brand small{display:block;margin-top:5px;color:#7ddcff;font-size:9px;font-weight:850;letter-spacing:1.4px;text-transform:uppercase}.tools-links{display:flex;align-items:center;gap:5px}.tools-links>a{padding:10px 12px;border-radius:7px;color:#d5e1ed;text-decoration:none;font-size:13px;font-weight:750}.tools-links>a:hover,.tools-links>a[aria-current]{color:#fff;background:#ffffff12}.tools-toggle{display:none;border:1px solid #53697e;border-radius:7px;padding:9px 11px;background:transparent;color:#fff;font:inherit;font-weight:750}.tools-navigation a:focus-visible,.tools-toggle:focus-visible{outline:3px solid #48cfff;outline-offset:3px}@media(max-width:800px){.tools-navigation nav{min-height:70px;flex-wrap:wrap;padding:12px 0}.tools-toggle{display:block}.tools-links{display:none;width:100%;flex-direction:column;align-items:stretch;padding:8px 0}.is-open .tools-links{display:flex}.tools-links>a{min-height:44px;display:flex;align-items:center}}
</style>
