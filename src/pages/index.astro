---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { TGD_APP_URL } from "../consts";

export const prerender = false;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Trades Go Digital | Digital Growth for UK Trades Businesses</title>
    <meta
      name="description"
      content="Trades Go Digital helps UK trades businesses win more work, reduce admin and grow through practical digital solutions."
    />
  </head>
  <body>
    <Header />

    <main>
      <section class="hero">
        <div class="hero-bg"></div>
        <div class="container hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">Helping UK Trades Businesses Grow</p>
            <h1>Practical digital tools that help your business run cleaner, faster and smarter.</h1>
            <p class="hero-text">
              Trades Go Digital builds straightforward business software for UK trades and
              letting agencies—bringing jobs, customers, paperwork and day-to-day admin together.
            </p>
            <p class="hero-text">
              Less time chasing information. More time doing the work that moves your business forward.
            </p>
            <div class="hero-actions">
              <a class="button button-primary" href="/tgd/">See TGD Trades in action</a>
              <a class="button button-secondary" href={TGD_APP_URL}>Start with TGD Trades</a>
            </div>
            <ul class="hero-proof" aria-label="TGD Trades benefits">
              <li>Built around real working businesses</li>
              <li>Clear pricing</li>
              <li>Friendly UK support</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="section products-section">
        <div class="container">
          <div class="products-heading">
            <p class="eyebrow">Our Software</p>
            <h2>Practical business systems built around real work.</h2>
            <p>Choose the platform designed for your type of business.</p>
          </div>
          <div class="product-grid">
            <article class="product-card">
              <span class="product-tag">For UK trades</span>
              <h3>TGD Trades</h3>
              <p>Quotes, jobs, customers, paperwork, accounts and supplier orders connected in one business office.</p>
              <a class="button button-primary" href="/tgd/">Explore TGD Trades</a>
            </article>
            <article class="product-card lettingdesk-card">
              <span class="product-tag">For letting agencies</span>
              <h3>TGD LettingDesk</h3>
              <p>Properties, maintenance, contractors, rent, finances and customer portals connected in one agency platform.</p>
              <a class="button button-lettingdesk" href="/tgd-lettingdesk/">Explore TGD LettingDesk</a>
            </article>
          </div>
        </div>
      </section>

      <section class="section story-section">
        <div class="container story-copy">
          <p class="eyebrow">The Story</p>
          <h2>Why Trades Go Digital Exists</h2>
          <p class="story-lead">
            Trades Go Digital began with a simple request from a tradesperson who needed help
            organising jobs, customers, paperwork and enquiries.
          </p>
          <p>
            A few practical spreadsheets made an immediate difference. That showed me the real
            problem wasn't a lack of effort—it was having too many disconnected tools and too
            much information scattered across messages, notebooks and memory.
          </p>
          <p>
            That first solution grew into TGD Trades: practical business software shaped around how
            people actually work, designed to reduce admin and give owners more control of their day.
          </p>
        </div>
      </section>

      <section class="section problem-section">
        <div class="container story-copy">
          <p class="eyebrow">The Problem</p>
          <h2>The Problem I Kept Seeing</h2>
          <p class="standout-line">
            Small gaps in organisation were costing real money.
          </p>
          <p>
            Forgotten materials create extra journeys. Job details disappear into messages.
            Quotes, receipts and customer records get pushed to the end of an already long day.
            Each small gap costs time, fuel and profit.
          </p>
          <p>
            The answer is not another complicated app. It is one practical system that keeps
            the work connected and makes the next step easier.
          </p>
        </div>
      </section>

      <section class="section solution-section">
        <div class="container story-copy">
          <p class="eyebrow">The Solution</p>
          <h2>The Solution: TGD Trades</h2>
          <p>
            Instead of expecting tradespeople to juggle multiple apps, paperwork and
            disconnected systems, TGD Trades brings the business office together in one
            place. Jobs, customers, quotes, invoices, receipts, certificates and day-to-day
            admin can all stay organised around the way trade businesses actually work.
          </p>
          <p>Quote once, then keep the job, calendar, paperwork and business records connected.</p>

          <div class="magic-room">
            <h2>Welcome to TGD Trades</h2>
            <p>Explore the real screens and see how quotes, jobs, paperwork and your Business Office work together.</p>
            <a class="button button-primary" href="/tgd/">Explore TGD Trades</a>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #07111f;
    color: #edf6ff;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    line-height: 1.6;
  }

  :global(a) {
    color: inherit;
  }

  .container {
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
  }

  .products-section {
    background:
      radial-gradient(circle at 85% 20%, rgba(37, 99, 235, 0.18), transparent 26rem),
      #091727;
    border-block: 1px solid rgba(109, 199, 255, 0.14);
  }

  .products-heading {
    max-width: 780px;
    margin-bottom: 34px;
  }

  .products-heading h2 {
    margin-bottom: 14px;
  }

  .products-heading > p:last-child {
    margin: 0;
    color: #b8cadb;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  .product-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    padding: 34px;
    border: 1px solid rgba(109, 199, 255, 0.22);
    border-radius: 18px;
    background: linear-gradient(160deg, rgba(17, 42, 69, 0.95), rgba(5, 16, 29, 0.96));
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.28);
  }

  .product-card h3 {
    margin: 12px 0;
    font-size: clamp(1.7rem, 3vw, 2.5rem);
  }

  .product-card p {
    flex: 1;
    margin: 0 0 24px;
    color: #c3d2e1;
  }

  .product-tag {
    color: #69d5ff;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .lettingdesk-card {
    border-color: rgba(249, 115, 22, 0.42);
    background:
      radial-gradient(circle at 100% 0, rgba(249, 115, 22, 0.17), transparent 18rem),
      linear-gradient(160deg, rgba(20, 36, 64, 0.98), rgba(7, 18, 34, 0.98));
  }

  .lettingdesk-card .product-tag {
    color: #ff9a52;
  }

  .button-lettingdesk {
    background: linear-gradient(135deg, #f97316, #ff9c4a);
    color: #07111f;
  }

  .hero {
    position: relative;
    overflow: hidden;
    padding: 128px 0 92px;
    min-height: 100vh;
    background:
      radial-gradient(circle at 78% 18%, rgba(54, 178, 255, 0.28), transparent 30%),
      radial-gradient(circle at 20% 82%, rgba(214, 169, 53, 0.2), transparent 28%),
      linear-gradient(135deg, #0b1930 0%, #07111f 48%, #0c1725 100%);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(109, 199, 255, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(109, 199, 255, 0.08) 1px, transparent 1px);
    background-size: 70px 70px;
    mask-image: linear-gradient(to bottom, transparent, black 20%, black 72%, transparent);
    opacity: 0.24;
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 820px);
    gap: 56px;
    align-items: center;
  }

  .hero-copy {
    min-width: 0;
  }

  .eyebrow {
    margin: 0 0 14px;
    color: #d6a935;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    max-width: 780px;
    margin-bottom: 24px;
    color: #ffffff;
    font-size: clamp(2rem, 3.2vw, 2.7rem);
    line-height: 1.12;
    letter-spacing: 0;
  }

  h2 {
    margin-bottom: 18px;
    color: #ffffff;
    font-size: clamp(2.2rem, 4.2vw, 4rem);
    line-height: 1;
    letter-spacing: 0;
  }

  h3 {
    margin-bottom: 12px;
    color: #ffffff;
    font-size: 1.2rem;
    line-height: 1.2;
  }

  .hero-text {
    max-width: 650px;
    color: #c7d8e8;
    font-size: 1.17rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
    margin-top: 34px;
  }

  .button {
    display: inline-flex;
    max-width: 100%;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 14px 22px;
    border-radius: 8px;
    font-weight: 900;
    overflow-wrap: anywhere;
    text-align: center;
    text-decoration: none;
    transition:
      transform 160ms ease,
      border-color 160ms ease,
      background 160ms ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    background: linear-gradient(135deg, #f0c85a, #d6a935);
    color: #07111f;
    box-shadow: 0 16px 38px rgba(214, 169, 53, 0.24);
  }

  .pdf-card {
    border-color: rgba(214, 169, 53, 0.48);
    background:
      radial-gradient(circle at 100% 0, rgba(214, 169, 53, 0.18), transparent 18rem),
      linear-gradient(160deg, rgba(20, 36, 64, 0.98), rgba(7, 18, 34, 0.98));
  }

  .pdf-card .product-tag { color: #f0c85a; }

  .button-pdf {
    background: linear-gradient(135deg, #f0c85a, #d6a935);
    color: #07111f;
  }

  .button-secondary {
    border: 1px solid rgba(109, 213, 255, 0.55);
    background: rgba(7, 17, 31, 0.62);
    color: #ffffff;
  }

  .button-secondary:hover {
    border-color: #69d5ff;
    background: rgba(19, 44, 79, 0.92);
  }

  .hero-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin: 28px 0 0;
    padding: 0;
    color: #c7d8e8;
    font-size: 0.94rem;
    font-weight: 750;
    list-style: none;
  }

  .hero-proof li::before {
    content: "✓";
    margin-right: 8px;
    color: #69d5ff;
    font-weight: 950;
  }

  .section {
    padding: 94px 0;
  }

  .story-section {
    background: #ffffff;
    color: #0b1930;
  }

  .problem-section {
    background: #eef6ff;
    color: #0b1930;
  }

  .solution-section {
    background: #ffffff;
    color: #0b1930;
  }

  .story-copy {
    max-width: 860px;
  }

  .story-copy h2,
  .problem-section h2,
  .solution-section h2 {
    color: #0b1930;
  }

  .story-copy p:not(.eyebrow) {
    color: #334155;
    font-size: 1.08rem;
  }

  .story-copy .story-lead {
    color: #0b1930;
    font-size: 1.24rem;
    font-weight: 750;
  }

  .standout-line {
    max-width: 720px;
    margin: 30px 0;
    padding: 20px 24px;
    border-left: 5px solid #d6a935;
    border-radius: 8px;
    background: #ffffff;
    color: #0b1930 !important;
    font-size: clamp(1.35rem, 2.6vw, 2rem) !important;
    font-weight: 900;
    line-height: 1.2;
    box-shadow: 0 18px 45px rgba(12, 31, 55, 0.08);
  }

  .magic-room {
    margin-top: 52px;
    padding: 34px;
    border: 1px solid #d9e2ec;
    border-radius: 16px;
    background: #f8fbff;
    box-shadow: 0 24px 60px rgba(12, 31, 55, 0.08);
  }

  .magic-room h2 {
    font-size: clamp(2rem, 3.4vw, 3.2rem);
  }

  .magic-room .button {
    margin-top: 18px;
  }

  @media (max-width: 1080px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 760px) {
    .product-grid {
      grid-template-columns: 1fr;
    }

    .product-card {
      padding: 26px;
    }

    .hero {
      min-height: auto;
      padding: 58px 0 64px;
    }

    h1 {
      font-size: clamp(1.85rem, 8vw, 2.35rem);
    }

    h2 {
      font-size: 2.25rem;
    }

    .button {
      width: 100%;
      min-height: 50px;
      text-align: center;
    }

    .hero-proof {
      display: grid;
      gap: 8px;
    }

    .hero-grid {
      gap: 30px;
    }

    .section {
      padding: 62px 0;
    }
  }

  @media (max-width: 380px) {
    h1 {
      font-size: clamp(1.65rem, 7.5vw, 2rem);
    }
  }
</style>
