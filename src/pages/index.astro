---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

export const prerender = false;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Trades Go Digital | Business Software, Tools &amp; Services</title>
    <meta
      name="description"
      content="Explore TGD Trades, TAD The Business, Health and Safety, PDF Maker, Logo Maker and TGD LettingDesk. Find pricing, updates and support in one place."
    />
  </head>
  <body class="tgd-home-office">
    <Header />

<main>
<section class="hero"><div class="hero-bg" aria-hidden="true"></div><div class="container hero-grid"><div class="hero-copy">
<p class="eyebrow">Trades Go Digital / Your business, brought together</p>
<h1>From your first logo to your next job.<br />Find the tools for your business.</h1>
<p class="hero-text">Business software, branded documents, health and safety work packs and property management. Explore everything Trades Go Digital offers from one place.</p>
<p class="hero-text">Choose a tool for today, explore a business platform, or talk to us about something built around the way you work.</p>
<div class="hero-actions"><a class="button button-primary" href="#explore">Explore all tools &amp; services</a><a class="button button-secondary" href="/pricing/">View pricing</a></div>
<ul class="hero-proof" aria-label="Our approach"><li>Practical tools for working businesses</li><li>All pricing in one place</li><li>UK support</li></ul>
</div></div></section>
<section id="explore" class="section products-section"><div class="container"><div class="products-heading"><p class="eyebrow">Explore Trades Go Digital</p><h2>Every part of the website.<br />One place to start.</h2><p>Find out what each tool does, see the options and choose your next step.</p></div><div class="product-grid"><article class="product-card"><span class="product-tag">Business management</span><h3>TGD Trades</h3><p>Keep quotes, jobs, customers, accounts and supplier orders organised in your business office.</p><a class="button button-primary" href="/tgd/">Explore TGD Trades</a></article>
<article class="product-card"><span class="product-tag">Team and office</span><h3>TAD The Business</h3><p>Explore the multi-user trades platform for jobs, customer communication, expenses, wages and supplier paperwork.</p><a class="button button-primary" href="/tad-the-business/">Explore TAD The Business</a></article>
<article class="product-card"><span class="product-tag">Work packs and guidance</span><h3>Health &amp; Safety</h3><p>Meet SafeWork AI: draft work packs, risk assessments and method statements for review. Public app access is being prepared.</p><a class="button button-primary" href="/health-and-safety/">Explore Health &amp; Safety</a></article>
<article class="product-card"><span class="product-tag">Document studio</span><h3>PDF Maker</h3><p>Create quotes, invoices, receipts and job sign-off documents with a live A4 preview.</p><a class="button button-primary" href="/pdf-maker/">Open PDF Maker</a></article>
<article class="product-card"><span class="product-tag">Brand studio</span><h3>Logo Maker</h3><p>Create a business logo, try it on mockups and export your design. Use it to brand your documents.</p><a class="button button-primary" href="/logo-maker/">Open Logo Maker</a></article>
<article class="product-card"><span class="product-tag">Property management</span><h3>TGD LettingDesk</h3><p>Explore one agency platform for properties, maintenance, contractors, rent, finances and customer portals.</p><a class="button button-primary" href="/tgd-lettingdesk/">Explore TGD LettingDesk</a></article>
<article class="product-card"><span class="product-tag">Coming soon</span><h3>Demo Video Maker</h3><p>Turn your photos and video clips into a demo video with music, captions and previews. Currently in development.</p><a class="button button-primary" href="/monthly-updates/">Follow development updates</a></article>
<article class="product-card"><span class="product-tag">All costs in one place</span><h3>Pricing</h3><p>Compare software plans, individual tools, the Logo + PDF bundle and LettingDesk options. Find availability and pricing details together.</p><a class="button button-primary" href="/pricing/">View all pricing</a></article>
<article class="product-card"><span class="product-tag">News and progress</span><h3>Monthly Updates</h3><p>Follow software developments, AI projects and the latest news from Trades Go Digital.</p><a class="button button-primary" href="/monthly-updates/">Read the updates</a></article>
<article class="product-card"><span class="product-tag">Support and custom builds</span><h3>Contact</h3><p>Get help choosing a tool, ask about a website or automation, or discuss a custom business app built around your work.</p><a class="button button-primary" href="/contact/">Talk to Trades Go Digital</a></article></div></div></section>
<section class="section story-section"><div class="container"><p class="eyebrow">Make it work for your business</p><h2 class="journey-title">Start where you need help.</h2><div class="journey-grid">
<article><span class="product-tag">01 / Build your identity</span><h3>Look the part.</h3><p>Create your branding with <a href="/logo-maker/">Logo Maker</a>, then prepare branded paperwork in <a href="/pdf-maker/">PDF Maker</a>. The <a href="/pricing/#tools">bundle pricing</a> brings both tools together.</p></article>
<article><span class="product-tag">02 / Organise the work</span><h3>Keep the day moving.</h3><p>Explore <a href="/tgd/">TGD Trades</a> and <a href="/tad-the-business/">TAD The Business</a> for your business admin, or <a href="/tgd-lettingdesk/">TGD LettingDesk</a> for your agency.</p></article>
<article><span class="product-tag">03 / Prepare and grow</span><h3>Plan your next step.</h3><p>See what is being prepared for <a href="/health-and-safety/">Health &amp; Safety</a> and the <a href="/safework/">SafeWork work-pack builder</a>. Follow <a href="/monthly-updates/">updates</a> or <a href="/contact/">discuss a custom app</a>.</p></article>
</div></div></section>
<section class="section solution-section"><div class="container story-copy"><p class="eyebrow">About Trades Go Digital</p><h2>Built from a real business need.</h2><p>Trades Go Digital began with a tradesperson who needed help organising jobs, customers, paperwork and enquiries. A few practical spreadsheets grew into software shaped around everyday work.</p><p>Today, that same approach runs through our business platforms, document tools and custom builds: help people spend less time on admin and more time on their business.</p><div class="magic-room"><h2>Let’s find your next step.</h2><p>Compare the options on the pricing page, or tell us what your business needs and we’ll help you choose.</p><div class="hero-actions"><a class="button button-primary" href="/pricing/">Compare pricing</a><a class="button button-secondary" href="/contact/#tgd-enquiry">Talk to us</a></div><p class="terms-note">Read our <a href="/terms-and-conditions/">Terms &amp; Conditions</a> for the details of using our services.</p></div></div></section>
</main>
    <Footer />
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #07111f;
    color: #edf6ff;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    line-height: 1.6;
  }

  :global(a) {
    color: inherit;
  }

  .container {
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
  }

  .products-section {
    background:
      radial-gradient(circle at 85% 20%, rgba(37, 99, 235, 0.18), transparent 26rem),
      #091727;
    border-block: 1px solid rgba(109, 199, 255, 0.14);
  }

  .products-heading {
    max-width: 780px;
    margin-bottom: 34px;
  }

  .products-heading h2 {
    margin-bottom: 14px;
  }

  .products-heading > p:last-child {
    margin: 0;
    color: #b8cadb;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  .product-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    padding: 34px;
    border: 1px solid rgba(109, 199, 255, 0.22);
    border-radius: 18px;
    background: linear-gradient(160deg, rgba(17, 42, 69, 0.95), rgba(5, 16, 29, 0.96));
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.28);
  }

  .product-card h3 {
    margin: 12px 0;
    font-size: clamp(1.7rem, 3vw, 2.5rem);
  }

  .product-card p {
    flex: 1;
    margin: 0 0 24px;
    color: #c3d2e1;
  }

  .product-card .tool-price {
    flex: 0;
    margin: 0 0 14px;
    color: #ffffff;
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 950;
    line-height: 1;
  }

  .product-card .tool-price span {
    color: #f0c85a;
    font-size: 0.86rem;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .product-tag {
    color: #69d5ff;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .lettingdesk-card {
    border-color: rgba(249, 115, 22, 0.42);
    background:
      radial-gradient(circle at 100% 0, rgba(249, 115, 22, 0.17), transparent 18rem),
      linear-gradient(160deg, rgba(20, 36, 64, 0.98), rgba(7, 18, 34, 0.98));
  }

  .lettingdesk-card .product-tag {
    color: #ff9a52;
  }

  .button-lettingdesk {
    background: linear-gradient(135deg, #f97316, #ff9c4a);
    color: #07111f;
  }

  .hero {
    position: relative;
    overflow: hidden;
    padding: 128px 0 92px;
    min-height: 100vh;
    background:
      radial-gradient(circle at 78% 18%, rgba(54, 178, 255, 0.28), transparent 30%),
      radial-gradient(circle at 20% 82%, rgba(214, 169, 53, 0.2), transparent 28%),
      linear-gradient(135deg, #0b1930 0%, #07111f 48%, #0c1725 100%);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(109, 199, 255, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(109, 199, 255, 0.08) 1px, transparent 1px);
    background-size: 70px 70px;
    mask-image: linear-gradient(to bottom, transparent, black 20%, black 72%, transparent);
    opacity: 0.24;
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 820px);
    gap: 56px;
    align-items: center;
  }

  .hero-copy {
    min-width: 0;
  }

  .eyebrow {
    margin: 0 0 14px;
    color: #d6a935;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    max-width: 780px;
    margin-bottom: 24px;
    color: #ffffff;
    font-size: clamp(2rem, 3.2vw, 2.7rem);
    line-height: 1.12;
    letter-spacing: 0;
  }

  h2 {
    margin-bottom: 18px;
    color: #ffffff;
    font-size: clamp(2.2rem, 4.2vw, 4rem);
    line-height: 1;
    letter-spacing: 0;
  }

  h3 {
    margin-bottom: 12px;
    color: #ffffff;
    font-size: 1.2rem;
    line-height: 1.2;
  }

  .hero-text {
    max-width: 650px;
    color: #c7d8e8;
    font-size: 1.17rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
    margin-top: 34px;
  }

  .button {
    display: inline-flex;
    max-width: 100%;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 14px 22px;
    border-radius: 8px;
    font-weight: 900;
    overflow-wrap: anywhere;
    text-align: center;
    text-decoration: none;
    transition:
      transform 160ms ease,
      border-color 160ms ease,
      background 160ms ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    background: linear-gradient(135deg, #f0c85a, #d6a935);
    color: #07111f;
    box-shadow: 0 16px 38px rgba(214, 169, 53, 0.24);
  }

  .pdf-card {
    border-color: rgba(214, 169, 53, 0.48);
    background:
      radial-gradient(circle at 100% 0, rgba(214, 169, 53, 0.18), transparent 18rem),
      linear-gradient(160deg, rgba(20, 36, 64, 0.98), rgba(7, 18, 34, 0.98));
  }

  .pdf-card .product-tag { color: #f0c85a; }

  .button-pdf {
    background: linear-gradient(135deg, #f0c85a, #d6a935);
    color: #07111f;
  }

  .button-secondary {
    border: 1px solid rgba(109, 213, 255, 0.55);
    background: rgba(7, 17, 31, 0.62);
    color: #ffffff;
  }

  .button-secondary:hover {
    border-color: #69d5ff;
    background: rgba(19, 44, 79, 0.92);
  }

  .hero-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin: 28px 0 0;
    padding: 0;
    color: #c7d8e8;
    font-size: 0.94rem;
    font-weight: 750;
    list-style: none;
  }

  .hero-proof li::before {
    content: "✓";
    margin-right: 8px;
    color: #69d5ff;
    font-weight: 950;
  }

  .section {
    padding: 94px 0;
  }

  .story-section {
    background: #ffffff;
    color: #0b1930;
  }

  .problem-section {
    background: #eef6ff;
    color: #0b1930;
  }

  .solution-section {
    background: #ffffff;
    color: #0b1930;
  }

  .story-copy {
    max-width: 860px;
  }

  .story-copy h2,
  .problem-section h2,
  .solution-section h2 {
    color: #0b1930;
  }

  .story-copy p:not(.eyebrow) {
    color: #334155;
    font-size: 1.08rem;
  }

  .story-copy .story-lead {
    color: #0b1930;
    font-size: 1.24rem;
    font-weight: 750;
  }

  .standout-line {
    max-width: 720px;
    margin: 30px 0;
    padding: 20px 24px;
    border-left: 5px solid #d6a935;
    border-radius: 8px;
    background: #ffffff;
    color: #0b1930 !important;
    font-size: clamp(1.35rem, 2.6vw, 2rem) !important;
    font-weight: 900;
    line-height: 1.2;
    box-shadow: 0 18px 45px rgba(12, 31, 55, 0.08);
  }

  .magic-room {
    margin-top: 52px;
    padding: 34px;
    border: 1px solid #d9e2ec;
    border-radius: 16px;
    background: #f8fbff;
    box-shadow: 0 24px 60px rgba(12, 31, 55, 0.08);
  }

  .magic-room h2 {
    font-size: clamp(2rem, 3.4vw, 3.2rem);
  }

  .magic-room .button {
    margin-top: 18px;
  }

  @media (max-width: 1080px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 760px) {
    .product-grid {
      grid-template-columns: 1fr;
    }

    .product-card {
      padding: 26px;
    }

    .hero {
      min-height: auto;
      padding: 58px 0 64px;
    }

    h1 {
      font-size: clamp(1.85rem, 8vw, 2.35rem);
    }

    h2 {
      font-size: 2.25rem;
    }

    .button {
      width: 100%;
      min-height: 50px;
      text-align: center;
    }

    .hero-proof {
      display: grid;
      gap: 8px;
    }

    .hero-grid {
      gap: 30px;
    }

    .section {
      padding: 62px 0;
    }
  }

  @media (max-width: 380px) {
    h1 {
      font-size: clamp(1.65rem, 7.5vw, 2rem);
    }
  }
</style>

<style>
.hero{min-height:auto;padding:88px 0}.hero-grid{grid-template-columns:minmax(0,900px)}
#explore{scroll-margin-top:24px}.products-section{border:0}.product-card h3{font-size:1.8rem}.product-card p{flex:1}.product-card .button{font-size:.94rem}
.journey-title,.journey-grid h3{color:#0b1930}.journey-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:32px;margin-top:40px}.journey-grid h3{font-size:1.6rem;margin-top:14px}.journey-grid p{color:#334155}.journey-grid .product-tag{color:#9a4200}.journey-grid a,.terms-note a{text-decoration:underline;text-underline-offset:3px;font-weight:700}.magic-room .terms-note{margin:26px 0 0;font-size:.9rem}.magic-room .button{margin-top:0}a:focus-visible{outline:3px solid #f97316;outline-offset:5px}
@media(max-width:760px){.hero{padding:58px 0}.journey-grid{grid-template-columns:1fr;gap:24px}.magic-room{padding:24px}}
</style>

<style is:global>
body.tgd-home-office{position:relative;isolation:isolate;background:#edf0f2;color:#07111f}
body.tgd-home-office::before{content:"";position:fixed;inset:0;z-index:-1;pointer-events:none;background:linear-gradient(#ffffff0d,#ffffff0d),url('/images/tgd-home-office.png') center / cover no-repeat}
body.tgd-home-office main .hero,body.tgd-home-office main .section{background:transparent;border:0}
body.tgd-home-office .hero-bg{display:none}
body.tgd-home-office .hero-copy,body.tgd-home-office .products-heading,body.tgd-home-office .product-card,body.tgd-home-office .story-section>.container,body.tgd-home-office .solution-section>.container{background:rgba(255,255,255,.94);border:0;border-radius:16px;padding:32px;box-shadow:0 8px 28px #07111f18}
body.tgd-home-office .hero-copy{max-width:790px}
body.tgd-home-office main h1,body.tgd-home-office main h2,body.tgd-home-office main h3{color:#07111f}
body.tgd-home-office .hero-text,body.tgd-home-office .hero-proof,body.tgd-home-office .product-card p,body.tgd-home-office .products-heading>p:last-child{color:#334155}
body.tgd-home-office .eyebrow,body.tgd-home-office .product-tag{color:#984000}
body.tgd-home-office .hero-proof li::before{color:#984000}
body.tgd-home-office main .section{padding:44px 0}
body.tgd-home-office footer{background:transparent;border:0;color:#07111f}
body.tgd-home-office footer .footer-brand,body.tgd-home-office footer .footer-contact-list,body.tgd-home-office footer .footer-links,body.tgd-home-office footer .footer-bottom{background:rgba(255,255,255,.94);border:0;border-radius:12px;padding:24px;color:#334155}
body.tgd-home-office footer .footer-contact-list span,body.tgd-home-office footer .footer-contact-list a,body.tgd-home-office footer .footer-links a,body.tgd-home-office footer .footer-bottom a{color:#07111f}
body.tgd-home-office footer h2{color:#984000}
body.tgd-home-office footer .footer-contact-list p{border:0}
body.tgd-home-office footer a:hover{color:#984000}
@media(max-width:760px){body.tgd-home-office .hero-copy,body.tgd-home-office .products-heading,body.tgd-home-office .product-card,body.tgd-home-office .story-section>.container,body.tgd-home-office .solution-section>.container{padding:24px}body.tgd-home-office main .section{padding:28px 0}}
</style>

<style is:global>
body.tgd-home-office.tgd-home-office footer .footer-contact-list span,body.tgd-home-office.tgd-home-office footer .footer-contact-list a,body.tgd-home-office.tgd-home-office footer .footer-bottom a{color:#07111f}
</style>
