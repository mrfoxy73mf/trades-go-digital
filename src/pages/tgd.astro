---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, TGD_APP_URL } from "../consts";

export const prerender = false;

const heroButtons = [
	{
		label: "Dashboard",
		image: "/images/tgd-dashboard.png",
		alt: "TGD dashboard screen",
	},
	{
		label: "Quote Page",
		image: "/images/tgd-quote-page.png",
		alt: "TGD quote page screen",
	},
	{
		label: "Job Page",
		image: "/images/tgd-job-folder.png",
		alt: "TGD jobs screen",
	},
	{
		label: "Work Calendar",
		image: "/images/tgd-work-calendar.png",
		alt: "TGD work calendar screen",
	},
	{
		label: "Suppliers Page",
		image: "/images/tgd-suppliers-page.png",
		alt: "TGD suppliers page screen",
	},
	{
		label: "AI Assistant",
		image: "/images/tgd-ai-assistant.png",
		alt: "TGD AI Assistant screen",
	},
	{
		label: "Notebook",
		image: "/images/tgd-notebook.png",
		alt: "TGD notebook screen",
	},
	{
		label: "Business Office",
		image: "/images/tgd-business-office.png",
		alt: "TGD Business Office screen",
	},
	{
		label: "Vehicles and Logs",
		image: "/images/tgd-vehicles-logs.png",
		alt: "TGD vehicles and mileage logs screen",
	},
];

const paperworkItems = [
	{
		title: "Quote PDF",
		text: "Send a clear, professional quote to the customer.",
		image: "/images/tgd-quote-pdf.png",
		alt: "TGD quote PDF preview",
	},
	{
		title: "Job Sign-Off PDF",
		text: "Get the work signed off and keep the record with the job.",
		image: "/images/tgd-job-signoff-pdf.png",
		alt: "TGD job sign-off PDF preview",
	},
	{
		title: "Invoice PDF",
		text: "Create the invoice without typing everything again.",
		image: "/images/tgd-invoice-pdf.png",
		alt: "TGD invoice PDF preview",
	},
	{
		title: "Dividends",
		text: "Keep company paperwork ready for your accountant.",
		image: "/images/tgd-dividends-pdf.png",
		alt: "TGD dividends PDF preview",
	},
	{
		title: "Accountant",
		text: "Package the numbers your accountant needs.",
		image: "/images/tgd-accountant-pdf.png",
		alt: "TGD accountant report PDF preview",
	},
	{
		title: "Wage Slip",
		text: "Create clear wage records for the people you pay.",
		image: "/images/tgd-wage-slip.jpg",
		alt: "TGD wage slip preview",
	},
	{
		title: "Certificates & Sign-Offs",
		text: "Pick the right paperwork and keep certificates connected to the job.",
		label: "SCREEN",
		image: "/images/tgd-certificates-screen.jpg",
		alt: "TGD certificates and sign-off screen",
	},
];

const pricingFeatures = [
	"Quotes, invoices and digital customer sign-off",
	"Jobs, calendar, photos and paperwork in one place",
	"Voice-activated AI Assistant",
	"Business Office records and accountant exports",
	"Vehicle, mileage and expense tracking",
	"Works offline and syncs when signal returns",
	"Unlimited jobs, photos and PDFs",
	"Cancel anytime with no long contract",
];

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="TGD - Business Software Built for UK Tradesmen | Trades Go Digital"
			description="TGD is a business operating system for UK trades. One quote creates your job, calendar, PDFs, accounts and supplier orders automatically. Start your subscription online."
		/>
		<meta property="og:site_name" content={SITE_TITLE} />
		<meta property="og:locale" content="en_GB" />
	</head>
	<body>
		<Header />
		<main class="pt-landing">
			<section class="pt-intro" aria-labelledby="tgd-title">
				<div class="pt-container pt-intro-inner">
					<div class="pt-intro-copy">
						<p class="pt-eyebrow">TGD by Trades Go Digital</p>
						<h1 id="tgd-title">Run your trade business from one place.</h1>
						<p class="pt-intro-lead">
							TGD connects quotes, jobs, customers, paperwork, calendars and business records
							in one practical system built around the way UK trades actually work.
						</p>
						<div class="pt-intro-actions">
							<a class="pt-action pt-action-primary" href="#explore">Explore the app</a>
							<a class="pt-action pt-action-secondary" href="#pricing">See pricing</a>
						</div>
						<ul class="pt-intro-points" aria-label="TGD highlights">
							<li>Less repeated admin</li>
							<li>Clear records for every job</li>
							<li>Built for work on the move</li>
						</ul>
					</div>
					<div class="pt-intro-art">
						<img src="/images/tgd-orange-trade-poster.webp" alt="TGD Trades Go Digital runs the business" />
					</div>
				</div>
			</section>
			<section id="explore" class="pt-hero pt-section">
				<div class="pt-container pt-hero-inner">
					<div class="pt-hero-visual">
						<img
							id="pt-hero-preview"
							src="/images/tgd-office-drawers.png"
							alt="TGD Magic Room office with branded van"
						/>
						<div class="pt-hero-cabinet-note">Open a drawer</div>
						<div class="pt-hero-return-note" hidden>Press picture to return to office</div>
						<div class="pt-hero-menu" aria-label="TGD tools">
							{
								heroButtons.map((item) => (
									<button
										type="button"
										data-preview-src={item.image}
										data-preview-alt={item.alt}
									>
										<b>{item.label}</b>
									</button>
								))
							}
						</div>
					</div>
				</div>
				<section class="pt-image-caption" aria-label="TGD introduction">
					<h2>TGD - the business operating system built for UK trades</h2>
					<p>
						You already know how to run the job. TGD runs the office. Quote once,
						and every job, PDF, calendar entry, supplier email and tax record falls into place
						automatically, right from your phone.
					</p>
					<ul>
						<li><strong>Dashboard</strong> - today's jobs, this week's takings and what needs your attention.</li>
						<li><strong>Quotes</strong> - create once, then let TGD handle what happens next.</li>
						<li><strong>Jobs</strong> - every detail, note, photo and PDF lives with the job.</li>
						<li><strong>Work Calendar</strong> - accepted quotes can become booked work dates.</li>
						<li><strong>Suppliers</strong> - material lists and supplier invoices stay linked to the right job.</li>
						<li><strong>AI Assistant</strong> - ask about your business, your trade or the app.</li>
						<li><strong>Notebook</strong> - speak naturally and turn notes into proper messages.</li>
						<li><strong>Business Office</strong> - jobs, receipts, certificates and records organised together.</li>
						<li><strong>Vehicles and Mileage</strong> - log trips and keep mileage ready for your records.</li>
					</ul>
				</section>
			</section>

			<section id="paperwork" class="pt-section pt-paperwork">
				<div class="pt-container pt-paperwork-grid">
					<div class="pt-paperwork-visual">
						<div class="pt-paperwork-return-note" hidden>Press picture to return to files</div>
						<img
							id="pt-paperwork-preview"
							src="/images/tgd-phone-files.png"
							alt="TGD phone showing business document files"
						/>
						<p class="pt-scroll-hint">Scroll left to see PDFs</p>
						<div class="pt-paperwork-menu" aria-label="TGD paperwork previews">
							{
								paperworkItems.map((item) => (
									<button
										type="button"
										data-paperwork-src={item.image}
										data-paperwork-alt={item.alt}
									>
										<b>{item.title}</b>
										<span>{item.label || "PDF"}</span>
									</button>
								))
							}
						</div>
					</div>
				</div>
				<section class="pt-image-caption" aria-label="TGD paperwork">
					<h2>All your paperwork - done, organised and ready to hand over</h2>
					<p>
						Every quote, invoice, sign-off, wage slip and certificate is created from the data
						you already put in. No copying, no re-typing and no chasing bits of paper.
					</p>
					<ul>
						<li><strong>Quote PDF</strong> - sent with one tap.</li>
						<li><strong>Job Sign-Off PDF</strong> - customer sign-off kept with the job.</li>
						<li><strong>Invoice PDF</strong> - created without typing everything again.</li>
						<li><strong>Dividends PDF</strong> - company paperwork ready for your records.</li>
						<li><strong>Accountant Report PDF</strong> - a tidy bundle for your accountant.</li>
						<li><strong>Wage Slips</strong> - clear wage records for people you pay.</li>
						<li><strong>Certificates and Sign-Offs</strong> - regulated paperwork connected to the job.</li>
					</ul>
				</section>
			</section>

			<section id="features" class="pt-summary pt-section">
				<div class="pt-container">
					<p class="pt-eyebrow">One connected workflow</p>
					<h2>Do the job once. Keep the business moving.</h2>
					<p class="pt-summary-lead">
						When a quote is accepted, TGD keeps the next steps connected—job details,
						calendar, documents and customer records—without making you enter everything again.
					</p>
					<div class="pt-benefit-grid">
						<article><span>01</span><h3>Plan the work</h3><p>Keep quotes, jobs, dates, customers and notes together from the start.</p></article>
						<article><span>02</span><h3>Finish the paperwork</h3><p>Create clear quotes, invoices, sign-offs and records from information already entered.</p></article>
						<article><span>03</span><h3>Know where you stand</h3><p>See what is booked, outstanding and ready for your accountant without chasing folders.</p></article>
					</div>
					<div class="pt-reassurance">
						<strong>Built for real working days</strong>
						<span>Works offline</span><span>Voice-friendly</span><span>Phone and desktop</span><span>Cancel anytime</span>
					</div>
				</div>
			</section>

			<section id="pricing" class="pt-pricing pt-section" aria-labelledby="pricing-title">
				<div class="pt-container pt-pricing-grid">
					<div class="pt-price-card-new">
						<p class="pt-eyebrow">Subscription pricing</p>
						<h2 id="pricing-title">Simple pricing. The whole business office included.</h2>
						<div class="pt-price-new"><strong>&pound;28</strong><span>/month</span></div>
						<p class="pt-price-highlight">For your first three months.</p>
						<p class="pt-price-after-new">Then &pound;60 per month. Cancel anytime—no long contract.</p>
						<a class="pt-action pt-action-primary" href={TGD_APP_URL}>Start TGD subscription</a>
					</div>
					<div class="pt-included">
						<h3>Everything you need to run the job</h3>
						<ul>
							{pricingFeatures.map((item) => <li><span aria-hidden="true">✓</span>{item}</li>)}
						</ul>
					</div>
				</div>
			</section>

			<section id="waiting-list" class="pt-final-cta">
				<div class="pt-container">
					<p class="pt-eyebrow">Ready to begin?</p>
					<h2>Put TGD to work in your business.</h2>
					<p>Create your account in the TGD app, choose your subscription and let Stripe handle the payment securely.</p>
					<a class="pt-action pt-action-primary" href={TGD_APP_URL}>Open TGD and subscribe</a>
				</div>
			</section>
		</main>
		<Footer />
		<script>
			const previewImage = document.querySelector<HTMLImageElement>("#pt-hero-preview");
			const previewVisual = document.querySelector<HTMLElement>(".pt-hero-visual");
			const previewReturnNote = document.querySelector<HTMLElement>(".pt-hero-return-note");
			const previewMenu = document.querySelector<HTMLElement>(".pt-hero-menu");
			const previewButtons = document.querySelectorAll<HTMLButtonElement>(".pt-hero-menu button");
			const paperworkImage = document.querySelector<HTMLImageElement>("#pt-paperwork-preview");
			const paperworkFrame = document.querySelector<HTMLElement>(".pt-paperwork-visual");
			const paperworkMenu = document.querySelector<HTMLElement>(".pt-paperwork-menu");
			const paperworkReturnNote = document.querySelector<HTMLElement>(".pt-paperwork-return-note");
			const paperworkButtons = document.querySelectorAll<HTMLButtonElement>(".pt-paperwork-menu button");
			const isPhone = () => window.matchMedia("(max-width: 720px)").matches;
			const scrollSectionStart = (element?: HTMLElement | null) => {
				const section = element?.closest<HTMLElement>(".pt-section");
				if (!section) return;
				const reset = () => {
					section.scrollLeft = 0;
				};
				reset();
				requestAnimationFrame(reset);
				window.setTimeout(reset, 200);
				window.setTimeout(reset, 700);
			};
			const scrollSectionEnd = (element?: HTMLElement | null) => {
				const section = element?.closest<HTMLElement>(".pt-section");
				if (!section) return;
				const reset = () => {
					section.scrollLeft = section.scrollWidth;
				};
				reset();
				requestAnimationFrame(reset);
				window.setTimeout(reset, 200);
				window.setTimeout(reset, 700);
			};

			previewButtons.forEach((button) => {
				button.addEventListener("click", () => {
					const nextSrc = button.dataset.previewSrc;
					if (!previewImage || !nextSrc) return;

					previewImage.src = nextSrc;
					previewImage.alt = button.dataset.previewAlt || "TGD app screen";
					previewButtons.forEach((item) => item.classList.remove("is-active"));
					button.classList.add("is-active");
					previewVisual?.classList.add("is-preview-open");
					if (previewReturnNote) {
						previewReturnNote.hidden = false;
					}

					if (isPhone()) {
						previewImage.scrollIntoView({ behavior: "smooth", block: "center" });
					}
					scrollSectionStart(previewVisual);
				});
			});

			paperworkButtons.forEach((button) => {
				button.addEventListener("click", () => {
					const nextSrc = button.dataset.paperworkSrc;
					if (!paperworkImage || !nextSrc) return;

					paperworkImage.src = nextSrc;
					paperworkImage.alt = button.dataset.paperworkAlt || "TGD paperwork preview";
					if (paperworkFrame) {
						paperworkFrame.scrollTop = 0;
						paperworkFrame.classList.add("is-paperwork-open");
					}
					if (paperworkReturnNote) {
						paperworkReturnNote.hidden = false;
					}
					paperworkButtons.forEach((item) => item.classList.remove("is-active"));
					button.classList.add("is-active");

					if (isPhone()) {
						paperworkImage.scrollIntoView({ behavior: "smooth", block: "center" });
					}
					scrollSectionStart(paperworkFrame);
				});
			});

			paperworkImage?.addEventListener("click", () => {
				if (!paperworkMenu) return;

				paperworkImage.src = "/images/tgd-phone-files.png";
				paperworkImage.alt = "TGD phone showing business document files";
				if (paperworkFrame) {
					paperworkFrame.scrollTop = 0;
					paperworkFrame.classList.remove("is-paperwork-open");
				}
				if (paperworkReturnNote) {
					paperworkReturnNote.hidden = true;
				}
				paperworkButtons.forEach((item) => item.classList.remove("is-active"));

				if (isPhone()) {
					paperworkMenu.scrollIntoView({ behavior: "smooth", block: "start" });
				}
				scrollSectionEnd(paperworkFrame);
			});

			previewImage?.addEventListener("click", () => {
				if (!previewMenu) return;

				previewImage.src = "/images/tgd-office-drawers.png";
				previewImage.alt = "TGD Magic Room office with branded van";
				previewVisual?.classList.remove("is-preview-open");
				if (previewReturnNote) {
					previewReturnNote.hidden = true;
				}
				previewButtons.forEach((item) => item.classList.remove("is-active"));

				if (isPhone()) {
					previewMenu.scrollIntoView({ behavior: "smooth", block: "start" });
				}
			});
		</script>
	</body>
</html>

<style>
	body {
		margin: 0;
		background: #02050a;
		color: #102033;
		font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
	}

	html,
	body {
		overflow-x: hidden;
	}

	.pt-landing {
		--bg: #02050a;
		--bg-1: #070b12;
		--bg-2: #0d1420;
		--fg: #f8fafc;
		--muted: #cbd5e1;
		--dim: #94a3b8;
		--border: rgba(148, 163, 184, 0.22);
		--soft: rgba(148, 163, 184, 0.14);
		--accent: #ff6b00;
		--ok: #22c55e;
		background:
			radial-gradient(circle at 18% 0%, rgba(255, 107, 0, 0.16), transparent 30%),
			radial-gradient(circle at 88% 12%, rgba(59, 130, 246, 0.08), transparent 34%),
			linear-gradient(180deg, #02050a 0%, #050914 48%, #02050a 100%);
		color: var(--fg);
		overflow-x: hidden;
	}

	.pt-landing *,
	.pt-landing *::before,
	.pt-landing *::after {
		box-sizing: border-box;
	}

	.pt-container {
		width: min(1240px, calc(100% - 36px));
		margin: 0 auto;
	}

	.pt-section {
		position: relative;
		padding: 96px 0;
		border-bottom: 1px solid var(--soft);
	}

	.pt-hero {
		overflow: hidden;
		padding: 36px 0 76px;
	}

	.pt-hero-inner {
		position: relative;
		z-index: 2;
		display: block;
		width: min(1480px, calc(100% - 28px));
		margin: 0 auto;
	}

	.pt-logo {
		display: block;
		width: 82px;
		height: 82px;
		margin-bottom: 28px;
		border-radius: 50%;
		object-fit: cover;
		box-shadow: 0 24px 70px rgba(0, 0, 0, 0.45);
	}

	.pt-hero-visual {
		position: relative;
		display: grid;
		place-items: center;
	}

	.pt-hero-visual img {
		width: 100%;
		height: auto;
		border: 0;
		border-radius: 0;
		background: transparent;
		box-shadow: none;
		object-fit: contain;
	}

	.pt-hero-cabinet-note {
		display: none;
	}

	.pt-hero-return-note {
		position: absolute;
		left: 50%;
		bottom: 18px;
		z-index: 4;
		transform: translateX(-50%);
		padding: 8px 13px;
		border: 1px solid rgba(255, 159, 28, 0.45);
		border-radius: 999px;
		background: rgba(8, 13, 20, 0.82);
		color: #ffb14d;
		font-size: clamp(0.74rem, 0.85vw, 0.95rem);
		font-weight: 900;
		line-height: 1;
		box-shadow: 0 12px 30px rgba(0, 0, 0, 0.22);
		pointer-events: none;
	}

	.pt-hero-return-note[hidden],
	.pt-paperwork-return-note[hidden] {
		display: none;
	}

	.pt-hero-menu {
		position: absolute;
		inset: 0;
		z-index: 3;
		padding: 0;
		border: 0;
		background: transparent;
		box-shadow: none;
		pointer-events: none;
	}

	.pt-hero-menu button {
		position: absolute;
		left: 48.4%;
		width: 7.6%;
		height: 3.9%;
		appearance: none;
		display: flex;
		align-items: center;
		justify-content: flex-start;
		min-height: 0;
		padding: 0;
		border: 0;
		border-radius: 6px;
		background: transparent;
		color: transparent;
		cursor: pointer;
		font-size: 0;
		font-weight: 900;
		letter-spacing: 0;
		line-height: 1.1;
		text-align: left;
		text-transform: none;
		pointer-events: auto;
		box-shadow: none;
		transition:
			transform 180ms ease,
			border-color 180ms ease,
			background 180ms ease,
			box-shadow 180ms ease;
	}

	.pt-hero-menu button::before {
		display: none;
	}

	.pt-hero-menu button::after {
		display: none;
	}

	.pt-hero-menu button:hover,
	.pt-hero-menu button:focus-visible {
		transform: none;
		border-color: transparent;
		background: transparent;
		color: transparent;
		outline: none;
	}

	.pt-hero-menu button.is-active {
		border-color: transparent;
		background: transparent;
		color: transparent;
		box-shadow: none;
	}

	.pt-hero-menu button.is-active:hover,
	.pt-hero-menu button.is-active:focus-visible {
		border-color: transparent;
		background: transparent;
		box-shadow: none;
	}

	.pt-hero-visual.is-preview-open .pt-hero-menu {
		display: none;
	}

	.pt-hero-menu button:nth-child(1) {
		top: 21.1%;
	}

	.pt-hero-menu button:nth-child(2) {
		top: 28.3%;
	}

	.pt-hero-menu button:nth-child(3) {
		top: 35.5%;
	}

	.pt-hero-menu button:nth-child(4) {
		top: 42.7%;
	}

	.pt-hero-menu button:nth-child(5) {
		top: 49.9%;
	}

	.pt-hero-menu button:nth-child(6) {
		top: 57%;
	}

	.pt-hero-menu button:nth-child(7) {
		top: 64.2%;
	}

	.pt-hero-menu button:nth-child(8) {
		top: 71.3%;
	}

	.pt-hero-menu button:nth-child(9) {
		top: 78.5%;
	}

	.pt-hero-menu b {
		font: inherit;
	}

	.pt-hero-points {
		display: none;
		gap: 18px;
		padding: 0;
		border: 0;
		background: transparent;
		box-shadow: none;
	}

	.pt-hero-points span {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 12px;
		align-items: start;
		color: var(--fg);
		font-size: 1rem;
		font-weight: 850;
		line-height: 1.35;
	}

	.pt-hero-points b {
		color: var(--accent);
		font-size: 1.05rem;
		line-height: 1.35;
	}

	.pt-topline,
	.pt-eyebrow {
		display: flex;
		flex-wrap: wrap;
		gap: 18px;
		margin-bottom: 22px;
		color: var(--accent);
		font-size: 0.7rem;
		font-weight: 900;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	h1,
	h2,
	h3,
	p {
		margin-top: 0;
		overflow-wrap: anywhere;
	}

	h1 {
		max-width: 780px;
		margin-bottom: 32px;
		color: var(--fg);
		font-size: clamp(2.9rem, 7vw, 5.4rem);
		line-height: 1.06;
		letter-spacing: 0;
		text-wrap: balance;
	}

	h2 {
		max-width: 760px;
		margin-bottom: 22px;
		color: var(--fg);
		font-size: clamp(2.2rem, 5.4vw, 4rem);
		line-height: 1;
		letter-spacing: 0;
	}

	h2 span {
		color: var(--accent);
	}

	h3 {
		color: var(--fg);
		line-height: 1.25;
	}

	p {
		max-width: 680px;
		color: var(--muted);
