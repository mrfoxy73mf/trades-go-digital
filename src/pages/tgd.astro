	.pt-paperwork-grid {
		display: block;
		width: min(1480px, calc(100% - 28px));
		margin: 0 auto;
	}

	.pt-scroll-hint {
		display: none;
	}

	.pt-paperwork-punch {
		margin-top: 24px;
		color: var(--fg);
		font-weight: 900;
	}

	.pt-paperwork-menu {
		position: absolute;
		inset: 0;
		z-index: 3;
		pointer-events: none;
	}

	.pt-paperwork-menu button {
		position: absolute;
		width: 6%;
		height: 6%;
		appearance: none;
		display: block;
		min-height: 0;
		padding: 0;
		overflow: hidden;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: transparent;
		cursor: pointer;
		pointer-events: auto;
		text-align: left;
		box-shadow: none;
		transition:
			transform 180ms ease,
			border-color 180ms ease,
			background 180ms ease,
			box-shadow 180ms ease;
	}

	.pt-paperwork-menu button::before {
		display: none;
	}

	.pt-paperwork-menu button:hover,
	.pt-paperwork-menu button:focus-visible {
		transform: none;
		border-color: transparent;
		background: transparent;
		box-shadow: none;
		outline: none;
	}

	.pt-paperwork-menu button.is-active {
		border-color: transparent;
		background: transparent;
		color: transparent;
		box-shadow: none;
	}

	.pt-paperwork-menu button.is-active::before {
		display: none;
	}

	.pt-paperwork-menu b {
		color: inherit;
		font-size: 0;
		font-weight: 900;
		line-height: 1.25;
		letter-spacing: 0;
	}

	.pt-paperwork-menu span {
		display: none;
		align-items: center;
		min-height: 24px;
		padding: 4px 8px;
		border-radius: 999px;
		background: #111827;
		color: var(--dim);
		font-size: 0.62rem;
		font-weight: 950;
		letter-spacing: 0.08em;
	}

	.pt-paperwork-menu button.is-active span {
		display: none;
	}

	.pt-paperwork-menu button:nth-child(1) {
		left: 87.8%;
		top: 25.6%;
	}

	.pt-paperwork-menu button:nth-child(2) {
		left: 87.2%;
		top: 33.8%;
	}

	.pt-paperwork-menu button:nth-child(3) {
		left: 86.6%;
		top: 42%;
	}

	.pt-paperwork-menu button:nth-child(4) {
		left: 86%;
		top: 50.2%;
	}

	.pt-paperwork-menu button:nth-child(5) {
		left: 85.3%;
		top: 58.4%;
	}

	.pt-paperwork-menu button:nth-child(6) {
		left: 84.6%;
		top: 66.5%;
	}

	.pt-paperwork-menu button:nth-child(7) {
		left: 83.8%;
		top: 74.7%;
	}

	.pt-paperwork-visual {
		position: relative;
		display: block;
		max-height: none;
		overflow-y: auto;
		overflow-x: hidden;
		border: 0;
		border-radius: 0;
		background: transparent;
		box-shadow: none;
		scrollbar-gutter: stable;
