	.pt-paperwork-visual.is-paperwork-open {
		display: grid;
		place-items: center;
		width: min(520px, calc(100vw - 32px));
		height: min(76vh, 760px);
		max-width: 520px;
		max-height: 760px;
		overflow: hidden;
		background: #08101b;
	}

	.pt-paperwork-visual.is-paperwork-open > .pt-paperwork-preview {
		width: 100%;
		height: 100%;
		max-height: 100%;
		object-fit: contain;
		object-position: center;
		background: #fff;
		cursor: pointer;
	}

	.pt-paperwork-visual.is-paperwork-open .pt-paperwork-return-note {
		position: absolute;
		left: 50%;
		top: 14px;
		z-index: 6;
		transform: translateX(-50%);
		width: max-content;
		margin: 0;
	}

	.pt-pdf-machine {
		position: relative;
		display: grid;
		grid-template-columns: minmax(220px, 320px) minmax(0, 1fr);
		gap: clamp(24px, 4vw, 52px);
		align-items: center;
		width: min(1120px, calc(100% - 36px));
		margin: 0 auto;
		min-height: 0;
		padding: clamp(22px, 4vw, 42px);
		border: 1px solid rgba(255, 107, 0, 0.22);
		border-radius: 14px;
		background: rgba(3, 6, 11, 0.58);
		box-shadow: 0 30px 90px rgba(0, 0, 0, 0.42);
		overflow: visible;
		isolation: isolate;
	}

	.pt-pdf-machine::before {
		display: none;
	}

	.pt-pdf-machine::after {
		content: "Documents created and ready to send";
		position: static;
		grid-column: 1 / -1;
		z-index: 5;
		width: 100%;
		max-width: none;
		margin-top: -8px;
		color: var(--dim);
		font-size: 0.78rem;
		font-weight: 900;
		letter-spacing: 0.12em;
		text-align: center;
		text-transform: uppercase;
	}

	.pt-fake-phone {
		position: relative;
		left: auto;
		top: auto;
		z-index: 4;
		justify-self: center;
		width: 274px;
		height: 548px;
		transform: rotate(-1deg);
		padding: 24px 13px 28px;
		border: 3px solid #57606b;
		border-radius: 42px;
		background: linear-gradient(145deg, #151b23, #030507 62%);
