---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, TGD_APP_URL } from "../consts";

export const prerender = false;

const heroButtons = [
	{
		label: "Dashboard",
		image: "/images/tgd-dashboard.png",
		alt: "TGD Trades dashboard screen",
	},
	{
		label: "Quotes & Materials",
		image: "/images/tgd-quote-page.png",
		alt: "TGD Trades quote page screen",
	},
	{
		label: "Job Page",
		image: "/images/tgd-job-folder.png",
		alt: "TGD Trades jobs screen",
	},
	{
		label: "Work Calendar",
		image: "/images/tgd-work-calendar.png",
		alt: "TGD Trades work calendar screen",
	},
	{
		label: "Suppliers Page",
		image: "/images/tgd-suppliers-page.png",
		alt: "TGD Trades suppliers page screen",
	},
	{
		label: "AI Assistant",
		image: "/images/tgd-ai-assistant.png",
		alt: "TGD Trades AI Assistant screen",
	},
	{
		label: "Office Mailroom",
		image: "/images/tgd-office-mailroom-safe.png",
		alt: "TGD Trades Office Mailroom with AI receipt scanning and Business Office filing",
	},
	{
		label: "Business Office",
		image: "/images/tgd-business-office.png",
		alt: "TGD Trades Business Office screen",
	},
	{
		label: "Vehicles & Mileage",
		image: "/images/tgd-vehicles-logs.png",
		alt: "TGD Trades vehicles and mileage logs screen",
	},
];

const paperworkItems = [
	{
		title: "Quote PDF",
		text: "Send a clear, professional quote to the customer.",
		image: "/images/tgd-quote-pdf.png",
		alt: "TGD Trades quote PDF preview",
	},
	{
		title: "Job Sign-Off PDF",
		text: "Get the work signed off and keep the record with the job.",
		image: "/images/tgd-job-signoff-pdf.png",
		alt: "TGD Trades job sign-off PDF preview",
	},
	{
		title: "Invoice PDF",
		text: "Create the invoice without typing everything again.",
		image: "/images/tgd-invoice-pdf.png",
		alt: "TGD Trades invoice PDF preview",
	},
	{
		title: "Dividends",
		text: "Keep company paperwork ready for your accountant.",
		image: "/images/tgd-dividends-pdf.png",
		alt: "TGD Trades dividends PDF preview",
	},
	{
		title: "Accountant",
		text: "Package the numbers your accountant needs.",
		image: "/images/tgd-accountant-pdf.png",
		alt: "TGD Trades accountant report PDF preview",
	},
	{
		title: "Wage Slip",
		text: "Create clear wage records for the people you pay.",
		image: "/images/tgd-wage-slip.jpg",
		alt: "TGD Trades wage slip preview",
	},
	{
		title: "Certificates & Sign-Offs",
		text: "Pick the right paperwork and keep certificates connected to the job.",
		label: "SCREEN",
		image: "/images/tgd-certificates-screen.jpg",
		alt: "TGD Trades certificates and sign-off screen",
	},
];

const pricingFeatures = [
	"Run your jobs from phone, tablet or computer",
	"Keep customers informed through their own portal",
	"Reduce paperwork and repeated typing",
	"Keep supplier costs and material prices current",
	"Prepare accountant records automatically",
	"Keep working offline and sync automatically when reconnected",
	"Unlimited jobs, photos and PDFs—with no long contract",
];

const operationsFeatures = [
	{
		label: "OFFICE MAILROOM",
		title: "Supplier invoices and receipts land in the right place",
		text: "Each trader can use a private receipts address. Supplier PDFs and images are read, checked, held for review when figures do not match, and filed into Business Office with the matching expense and VAT records.",
	},
	{
		label: "CUSTOMER PORTAL",
		title: "Customers get a private link, not another account",
		text: "Share a secure branded portal where customers can view their job pack, open quotes, invoices and certificates, send messages, approve documents and see payment status.",
	},
	{
		label: "VAN STOCK",
		title: "Know what is already on the van",
		text: "Track stocktakes, low-stock warnings and material movements. Quote materials can come from supplier lists or van stock, with stock deducted when a quote becomes a job.",
	},
	{
		label: "PEOPLE",
		title: "Keep employee and subcontractor records together",
		text: "Store worker records, job allocation, wages, payslips and CIS deductions alongside the jobs and reports they belong to.",
	},
	{
		label: "ACCOUNTANT TOOLS",
		title: "Reports are built as the work happens",
		text: "Expenses, mileage, wages, invoices and VAT records feed accountant reports, CSV/PDF exports and tax-year records without hunting through old messages.",
	},
	{
		label: "INSTALLABLE APP",
		title: "Use it on phone, tablet or desktop",
		text: "Install TGD Trades from Safari, Chrome, Edge or your mobile browser. The app still connects to the secure backend, so the business data is not trapped on one device.",
	},
];

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="TGD Trades - Business Software Built for UK Tradesmen | Trades Go Digital"
			description="TGD Trades is a business operating system for UK trades. One quote creates your job, calendar, PDFs, accounts and supplier orders automatically. Start your subscription online."
		/>
		<meta property="og:site_name" content={SITE_TITLE} />
		<meta property="og:locale" content="en_GB" />
	</head>
	<body class="tgd-shared-background">
		<Header />
		<main class="pt-landing">
			<section class="pt-intro" aria-labelledby="tgd-title">
				<div class="pt-container pt-intro-inner">
					<div class="pt-intro-copy">
						<p class="pt-eyebrow">TGD Trades by Trades Go Digital</p>
						<h1 id="tgd-title">Quote the job once. Keep the whole business moving.</h1>
						<p class="pt-intro-lead">
							From customer acceptance to the calendar, invoice, sign-off and accounts,
							TGD Trades keeps every stage connected without entering the same details again.
						</p>
						<div class="pt-intro-actions">
							<a class="pt-action pt-action-primary" href="#explore">Explore the app</a>
							<a class="pt-action pt-action-secondary" href="/pricing#trades">See pricing</a>
						</div>
						<ul class="pt-intro-points" aria-label="TGD Trades highlights">
							<li>Win work and book it faster</li>
							<li>Less repeated admin</li>
							<li>Know what is paid and outstanding</li>
						</ul>
					</div>
					<div class="pt-intro-art">
						<img src="/images/tgd-orange-trade-poster.webp" alt="TGD Trades Go Digital runs the business" />
					</div>
				</div>
			</section>
			<section id="explore" class="pt-hero pt-section">
				<div class="pt-container pt-chain-heading">
			<p class="pt-eyebrow">Everything in its place</p>
			<h2>Everything you need—right where you need it.</h2>
			<p>Your jobs, customers, materials and paperwork—all organised and ready when you need them.</p>
				</div>
				<div class="pt-app-chain" aria-label="TGD Trades app screens">
					<div class="pt-app-chain-track">
						{[...heroButtons, ...heroButtons].map((item, index) => (
							<figure class="pt-app-chain-card" aria-hidden={index >= heroButtons.length ? "true" : undefined}>
								<div><img src={item.image} alt={index < heroButtons.length ? item.alt : ""} loading="lazy" /></div>
								<figcaption>{item.label}</figcaption>
							</figure>
						))}
					</div>
				</div>
				<div class="pt-container pt-chain-benefits" aria-label="TGD Trades key benefits">
					<span>Quote once</span><span>Book the work</span><span>Automate the paperwork</span><span>Know what is paid</span>
				</div>
			</section>

			<section class="pt-section pt-demo" aria-labelledby="demo-title">
				<div class="pt-container pt-demo-inner">
					<div class="pt-demo-copy">
						<p class="pt-eyebrow">See the connected workflow</p>
						<h2 id="demo-title">Take a guided tour of TGD Trades.</h2>
						<p id="demo-description">Watch how TGD Trades turns an accepted quote into booked work, organised paperwork and accounts ready for reporting.</p>
						<div class="pt-demo-selector" role="group" aria-label="Choose a TGD Trades demonstration">
							<button class="is-active" type="button" data-demo="tour" aria-pressed="true">Full TGD Tour</button>
						</div>
					</div>
					<div class="pt-demo-video">
						<video id="pt-demo-player" controls playsinline preload="metadata" poster="/images/tgd-trades-demo-poster.jpg">
							<source src="/videos/tgd-trades-demo-music.mp4?v=20260830-clear" type="video/mp4" />
							Your browser does not support embedded video.
						</video>
					</div>
				</div>
			</section>

			<section id="paperwork" class="pt-section pt-paperwork">
				<div class="pt-container pt-paperwork-heading">
					<p class="pt-eyebrow">Created from the job</p>
					<h2>Professional paperwork—straight from your phone.</h2>
					<p>Quotes, invoices, sign-offs, certificates and accountant records use information already held in TGD Trades—without entering everything again.</p>
				</div>
				<div class="pt-paperwork-grid">
					<div class="pt-paperwork-visual">
						<div class="pt-pdf-machine" aria-label="TGD Trades paperwork previews">
							<div class="pt-fake-phone" aria-label="TGD Trades mobile app creating business documents">
								<span class="pt-phone-speaker"></span>
								<div class="pt-phone-screen">
									<div class="pt-phone-brand">TGD</div>
									<small>BUSINESS OFFICE</small>
									<strong>Your paperwork</strong>
									<ul><li>Quotes</li><li>Invoices</li><li>Sign-offs</li><li>Reports</li></ul>
									<span>Ready to send</span>
								</div>
								<div class="pt-phone-home"></div>
							</div>
							<div class="pt-document-wall">
								{paperworkItems.map((item) => (
									<article class="pt-document-card">
										<img src={item.image} alt={item.alt} loading="lazy" />
										<div>
											<h3>{item.title}</h3>
											<p>{item.text}</p>
										</div>
									</article>
								))}
							</div>
						</div>
					</div>
				</div>
			</section>

			<section id="features" class="pt-summary pt-section">
				<div class="pt-container">
			<p class="pt-eyebrow">Built for working trades</p>
			<h2>Another tool for your toolbox.</h2>
			<p class="pt-summary-lead">
				Once your customer accepts the quote, TGD Trades gets the next steps ready
				and keeps you informed—all with a few taps.
					</p>
					<div class="pt-smart-features">
						<article>
							<span>CLIENT PORTAL</span>
							<h3>Give every customer one clear place</h3>
							<p>Customers can use a private magic link to see their job pack, send messages, approve paperwork, complete sign-offs and confirm payment status.</p>
						</article>
						<article>
							<span>AI MAILROOM</span>
							<h3>Supplier paperwork gets checked before filing</h3>
							<p>Supplier invoices and receipts can be read from email or upload. Complete documents file automatically; missing or inconsistent figures stay in Needs Review.</p>
						</article>
						<article>
							<span>MATERIAL PRICES</span>
							<h3>Your quote list stays connected</h3>
							<p>Upload materials and prices once. Quote materials can use supplier prices or van stock, so the quote stays clean while the buying list stays useful.</p>
						</article>
						<article>
							<span>ACCOUNTANT</span>
							<h3>Monthly reports without the monthly chase</h3>
							<p>Expenses, wages, mileage, VAT records and invoices feed reports your accountant can use, with PDF and CSV exports when needed.</p>
						</article>
					</div>
					<div class="pt-reassurance">
						<strong>Built for real working days</strong>
						<span>Works offline</span><span>Voice-friendly</span><span>Phone and desktop</span><span>Installable app</span>
					</div>
				</div>
			</section>

			<section class="pt-section pt-operations" aria-labelledby="operations-title">
				<div class="pt-container">
					<p class="pt-eyebrow">More than job sheets</p>
					<h2 id="operations-title">Run the back office from the same app.</h2>
					<p class="pt-operations-lead">TGD Trades connects the everyday work on site with the records your business needs later: customers, staff, suppliers, stock, wages, tax and accountant paperwork.</p>
					<div class="pt-operations-grid">
						{operationsFeatures.map((item) => (
							<article>
								<span>{item.label}</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))}
					</div>
				</div>
			</section>

			<section id="pricing" class="pt-section"><div class="pt-container"><h2>Choose your TGD Trades subscription.</h2><p>See the introductory offer and ongoing subscription on our pricing page.</p><a class="pt-action pt-action-primary" href="/pricing#trades">View TGD Trades pricing</a></div></section>

			<section class="pt-section pt-faq" aria-labelledby="faq-title">
				<div class="pt-container">
					<p class="pt-eyebrow">Straight answers</p>
					<h2 id="faq-title">Before you get started</h2>
					<div class="pt-faq-grid">
						<article><h3>Can I use it on site?</h3><p>Yes. TGD Trades is designed for phones, tablets and computers, so your job details stay close wherever you are working.</p></article>
						<article><h3>Does it replace my accountant?</h3><p>No. It keeps your records organised and produces clear reports that make working with your accountant easier.</p></article>
						<article><h3>What happens to supplier emails?</h3><p>The AI Mailroom reads attached invoices and receipts, files them in the Business Office and helps keep connected material prices current.</p></article>
			<article><h3>Am I tied into a contract?</h3><p>No. You can cancel anytime—there is no long-term contract.</p></article>
					</div>
				</div>
			</section>

			<section id="waiting-list" class="pt-final-cta">
				<div class="pt-container">
					<p class="pt-eyebrow">Ready to begin?</p>
					<h2>Put TGD Trades to work in your business.</h2>
					<p>Create your account in the TGD Trades app, choose your subscription and let Stripe handle the payment securely.</p>
					<a class="pt-action pt-action-primary" href={TGD_APP_URL}>Open TGD Trades and subscribe</a>
				</div>
			</section>
		</main>
		<Footer />
		<script>
			const demoPlayer = document.querySelector<HTMLVideoElement>("#pt-demo-player");
			const demoTitle = document.querySelector<HTMLElement>("#demo-title");
			const demoDescription = document.querySelector<HTMLElement>("#demo-description");
			const demoButtons = document.querySelectorAll<HTMLButtonElement>("[data-demo]");
			const demos = {
				tour: {
					title: "Take a guided tour of TGD Trades.",
					description: "Watch how TGD Trades turns an accepted quote into booked work, organised paperwork and accounts ready for reporting.",
					src: "/videos/tgd-trades-demo-music.mp4?v=20260830-clear",
					poster: "/images/tgd-trades-demo-poster.jpg",
				},
			};

			demoButtons.forEach((button) => {
				button.addEventListener("click", () => {
					const key = button.dataset.demo as keyof typeof demos;
					const demo = demos[key];
					if (!demo || !demoPlayer || !demoTitle || !demoDescription) return;
					demoPlayer.pause();
					demoPlayer.src = demo.src;
					demoPlayer.poster = demo.poster;
					demoPlayer.load();
					demoTitle.textContent = demo.title;
					demoDescription.textContent = demo.description;
					demoButtons.forEach((item) => {
						const active = item === button;
						item.classList.toggle("is-active", active);
						item.setAttribute("aria-pressed", String(active));
					});
				});
			});

			const paperworkImage = document.querySelector<HTMLImageElement>("#pt-paperwork-preview");
			const paperworkFrame = document.querySelector<HTMLElement>(".pt-paperwork-visual");
			const paperworkMenu = document.querySelector<HTMLElement>(".pt-pdf-machine");
			const paperworkReturnNote = document.querySelector<HTMLElement>(".pt-paperwork-return-note");
			const paperworkButtons = document.querySelectorAll<HTMLButtonElement>(".pt-pdf-stream-button");
			const isPhone = () => window.matchMedia("(max-width: 720px)").matches;
			const scrollSectionStart = (element?: HTMLElement | null) => {
				const section = element?.closest<HTMLElement>(".pt-section");
				if (!section) return;
				const reset = () => {
					section.scrollLeft = 0;
				};
				reset();
				requestAnimationFrame(reset);
				window.setTimeout(reset, 200);
				window.setTimeout(reset, 700);
			};
			const scrollSectionEnd = (element?: HTMLElement | null) => {
				const section = element?.closest<HTMLElement>(".pt-section");
				if (!section) return;
				const reset = () => {
					section.scrollLeft = section.scrollWidth;
				};
				reset();
				requestAnimationFrame(reset);
				window.setTimeout(reset, 200);
				window.setTimeout(reset, 700);
			};

			paperworkButtons.forEach((button) => {
				button.addEventListener("click", () => {
					const nextSrc = button.dataset.paperworkSrc;
					if (!paperworkImage || !nextSrc) return;

					paperworkImage.src = nextSrc;
					paperworkImage.alt = button.dataset.paperworkAlt || "TGD Trades paperwork preview";
					paperworkImage.hidden = false;
					if (paperworkMenu) paperworkMenu.hidden = true;
					if (paperworkFrame) {
						paperworkFrame.scrollTop = 0;
						paperworkFrame.classList.add("is-paperwork-open");
					}
					if (paperworkReturnNote) {
						paperworkReturnNote.hidden = false;
					}
					paperworkButtons.forEach((item) => item.classList.remove("is-active"));
					button.classList.add("is-active");

					if (isPhone()) {
						paperworkImage.scrollIntoView({ behavior: "smooth", block: "center" });
					}
					scrollSectionStart(paperworkFrame);
				});
			});

			paperworkImage?.addEventListener("click", () => {
				if (!paperworkMenu) return;

				paperworkImage.hidden = true;
				paperworkImage.alt = "TGD Trades paperwork preview";
				paperworkMenu.hidden = false;
				if (paperworkFrame) {
					paperworkFrame.scrollTop = 0;
					paperworkFrame.classList.remove("is-paperwork-open");
				}
				if (paperworkReturnNote) {
					paperworkReturnNote.hidden = true;
				}
				paperworkButtons.forEach((item) => item.classList.remove("is-active"));

				if (isPhone()) {
					paperworkMenu.scrollIntoView({ behavior: "smooth", block: "start" });
				}
				scrollSectionEnd(paperworkFrame);
			});

		</script>
	</body>
</html>

<style>
	body {
		margin: 0;
		background: #02050a;
		color: #102033;
		font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
	}

	html,
	body {
		overflow-x: hidden;
	}

	.pt-landing {
		--bg: #02050a;
		--bg-1: #070b12;
		--bg-2: #0d1420;
		--fg: #f8fafc;
		--muted: #cbd5e1;
		--dim: #94a3b8;
		--border: rgba(148, 163, 184, 0.22);
		--soft: rgba(148, 163, 184, 0.14);
		--accent: #ff6b00;
		--ok: #22c55e;
		background:
			linear-gradient(180deg, rgba(2, 5, 10, 0.12), rgba(2, 5, 10, 0.48) 52%, rgba(2, 5, 10, 0.7)),
			url("/images/tgd-tools-background.png") center top / cover fixed,
			#05080d;
		color: var(--fg);
		overflow-x: hidden;
	}

	.pt-landing > section {
		background: transparent;
	}

	.pt-landing *,
	.pt-landing *::before,
	.pt-landing *::after {
		box-sizing: border-box;
	}

	.pt-container {
		width: min(1240px, calc(100% - 36px));
		margin: 0 auto;
	}

	.pt-section {
		position: relative;
		padding: 96px 0;
		border-bottom: 0;
	}

	.pt-hero {
		overflow: hidden;
		padding: 76px 0;
	}

	.pt-chain-heading {
		margin-bottom: 34px;
		text-align: center;
	}

	.pt-chain-heading .pt-eyebrow,
	.pt-chain-heading h2,
	.pt-chain-heading p {
		justify-content: center;
		margin-right: auto;
		margin-left: auto;
	}

	.pt-chain-heading h2 {
		max-width: 880px;
	}

	.pt-app-chain {
		position: relative;
		overflow: hidden;
		width: 100%;
		padding: 12px 0 20px;
	}

	.pt-app-chain::before,
	.pt-app-chain::after {
		content: "";
		position: absolute;
		top: 0;
		bottom: 0;
		z-index: 2;
		width: min(9vw, 150px);
		pointer-events: none;
	}

	.pt-app-chain::before {
		left: 0;
		background: linear-gradient(90deg, #05080d, rgba(5, 8, 13, 0));
	}

	.pt-app-chain::after {
		right: 0;
		background: linear-gradient(270deg, #05080d, rgba(5, 8, 13, 0));
	}

	.pt-app-chain-track {
		display: flex;
		gap: 18px;
		width: max-content;
		padding-left: 18px;
		animation: pt-app-chain-scroll 68s linear infinite;
		will-change: transform;
	}

	.pt-app-chain:hover .pt-app-chain-track {
		animation-play-state: paused;
	}

	.pt-app-chain-card {
		flex: 0 0 clamp(300px, 34vw, 470px);
		margin: 0;
		padding: 8px;
		border: 1px solid rgba(255, 107, 0, 0.38);
		border-radius: 14px;
		background: rgba(4, 8, 13, 0.92);
		box-shadow: 0 22px 54px rgba(0, 0, 0, 0.38);
	}

	.pt-app-chain-card > div {
		display: grid;
		place-items: center;
		height: 270px;
		overflow: hidden;
		border-radius: 9px;
		background: #eef2f6;
	}

	.pt-app-chain-card img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.pt-app-chain-card figcaption {
		padding: 13px 10px 8px;
		color: var(--fg);
		font-size: 0.86rem;
		font-weight: 900;
		letter-spacing: 0.08em;
		text-align: center;
		text-transform: uppercase;
	}

	.pt-chain-benefits {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 10px;
		margin-top: 24px;
	}

	.pt-chain-benefits span {
		padding: 9px 14px;
		border: 1px solid rgba(255, 107, 0, 0.28);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.04);
		color: var(--muted);
		font-size: 0.86rem;
		font-weight: 850;
	}

	.pt-chain-benefits span::before {
		content: "✓";
		margin-right: 7px;
		color: #26bfff;
	}

	@keyframes pt-app-chain-scroll {
		to { transform: translateX(calc(-50% - 9px)); }
	}

	.pt-hero-inner {
		position: relative;
		z-index: 2;
		display: block;
		width: min(1480px, calc(100% - 28px));
		margin: 0 auto;
	}

	.pt-logo {
		display: block;
		width: 82px;
		height: 82px;
		margin-bottom: 28px;
		border-radius: 50%;
		object-fit: cover;
		box-shadow: 0 24px 70px rgba(0, 0, 0, 0.45);
	}

	.pt-hero-visual {
		position: relative;
		display: grid;
