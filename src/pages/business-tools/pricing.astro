---
import BaseHead from "../../components/BaseHead.astro";
import BusinessToolsHeader from "../../components/BusinessToolsHeader.astro";
import BusinessToolsFooter from "../../components/BusinessToolsFooter.astro";
const prices=[
	{name:"Logo + standard PDF",price:"£7.99",description:"One logo and one standard business document",items:["SVG and PNG logo files","Quote, invoice, receipt or sign-off","Save £1.99 compared with separate purchases"],href:"/logo-maker/?bundle=standard",button:"Create the bundle",featured:true,badge:"BEST VALUE"},
	{name:"Logo + Permit",price:"£8.99",description:"One logo and one permit document",items:["SVG and PNG logo files","One finished permit PDF","Save £1.99 compared with separate purchases"],href:"/logo-maker/?bundle=permit",button:"Create the permit bundle"},
	{name:"Logo + RAMS",price:"£12.99",description:"One logo and one four-page RAMS pack",items:["SVG and PNG logo files","Four-page RAMS PDF pack","Save £1.99 compared with separate purchases"],href:"/logo-maker/?bundle=rams",button:"Create the RAMS bundle"},
 {name:"Logo download",price:"£4.99",description:"One finished logo design",items:["SVG and PNG download","High-resolution PNG option","Transparent-background option"],href:"/logo-maker/",button:"Create a logo"},
 {name:"Standard PDF",price:"£4.99",description:"One finished business document",items:["Quote or invoice","Receipt or job sign-off","Branded, print-ready PDF"],href:"/pdf-maker/",button:"Create a document"},
 {name:"Permit",price:"£5.99",description:"One finished permit document",items:["Multiple permit types","Site controls and authorisation","Print-ready permit PDF"],href:"/pdf-maker/?document=permit",button:"Create a permit"},
 {name:"RAMS pack",price:"£9.99",description:"One four-page RAMS pack",items:["Risk assessment","Method statement","Briefing and approval records"],href:"/pdf-maker/?document=rams",button:"Create a RAMS pack",featured:true,badge:"FULL SAFETY PACK"}
];
---
<!doctype html><html lang="en-GB"><head><BaseHead title="Business Tools Pricing | Trades Go Digital" description="Simple one-off pricing for Trades Go Digital Logo Maker and PDF Maker downloads." /></head><body><BusinessToolsHeader/><main><section class="hero"><p>BUSINESS TOOLS PRICING</p><h1>Pay only for the file you need.</h1><span>No subscription. Preview and prepare your work before opening secure checkout.</span></section><section class="pricing"><div class="heading"><p>ONE-OFF PURCHASES</p><h2>Clear prices for every download.</h2></div><div class="grid">{prices.map(card=><article class:list={{featured:card.featured}}>{card.badge&&<b>{card.badge}</b>}<h3>{card.name}</h3><div class="price">{card.price}</div><p>{card.description}</p><ul>{card.items.map(item=><li>{item}</li>)}</ul><a href={card.href}>{card.button}</a></article>)}</div><p class="note">Prices are shown in GBP. The selected PDF type sets the price automatically before checkout. Always review generated documents before relying on or issuing them.</p></section><section class="explain"><div><p>HOW PAYMENT WORKS</p><h2>Create first. Pay when it is ready.</h2></div><ol><li><b>1</b><span><strong>Build your file</strong><small>Use the editor and live preview before paying.</small></span></li><li><b>2</b><span><strong>Check the price</strong><small>The checkout button shows the correct price for your selected file.</small></span></li><li><b>3</b><span><strong>Pay securely</strong><small>Complete the one-off payment through Stripe.</small></span></li><li><b>4</b><span><strong>Download</strong><small>Return to the tool and save the unlocked file.</small></span></li></ol></section></main><BusinessToolsFooter/></body></html>
<style>:global(*){box-sizing:border-box}:global(body){margin:0;background:#eef3f7;color:#07111f;font-family:Inter,ui-sans-serif,system-ui,sans-serif;line-height:1.6}:global(a){color:inherit}.hero,.pricing,.explain{width:min(1280px,calc(100% - 32px));margin:auto}.hero{padding:86px 64px;margin-top:42px;border-radius:18px;background:radial-gradient(circle at 90% 10%,#1b5688,transparent 38%),linear-gradient(135deg,#07111f,#102c49);color:#fff}.hero p,.heading p,.explain>div>p{margin:0;color:#55d3ff;font-size:12px;font-weight:900;letter-spacing:1.6px}.hero h1{max-width:900px;margin:10px 0 18px;font-size:clamp(46px,7vw,82px);line-height:.98}.hero span{color:#c5d5e3;font-size:18px}.pricing{padding:90px 0}.heading h2,.explain h2{margin:6px 0;font-size:clamp(34px,5vw,55px);line-height:1.08}.heading p{color:#007da9}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px;margin-top:38px}.grid article{position:relative;display:flex;flex-direction:column;padding:30px;border:1px solid #d3dee8;border-radius:16px;background:#fff;box-shadow:0 15px 40px #07111f12}.grid article.featured{border:2px solid #ff6b00;background:#fffaf6}.grid article>b{position:absolute;top:0;right:20px;padding:6px 10px;border-radius:0 0 7px 7px;background:#ff6b00;font-size:10px;letter-spacing:1px}.grid h3{margin:0;font-size:23px}.price{margin:12px 0 0;font-size:48px;font-weight:950;letter-spacing:-2px}.grid p{min-height:52px;color:#526377}.grid ul{min-height:130px;margin:10px 0 25px;padding:0;list-style:none}.grid li{margin:9px 0;color:#33465a}.grid li:before{content:"✓";margin-right:9px;color:#0086b7;font-weight:900}.grid a{margin-top:auto;padding:12px 15px;border-radius:8px;background:#07111f;color:#fff;text-align:center;text-decoration:none;font-weight:900}.featured a{background:#ff6b00;color:#07111f}.note{max-width:900px;margin:25px auto 0;color:#5b6b7c;text-align:center}.explain{display:grid;grid-template-columns:.8fr 1.2fr;gap:60px;padding:60px;margin-bottom:80px;border-radius:18px;background:#07111f;color:#fff}.explain ol{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:0;padding:0;list-style:none}.explain li{display:flex;gap:13px;padding:17px;border:1px solid #365b78;border-radius:10px;background:#ffffff08}.explain li>b{display:grid;place-items:center;width:36px;height:36px;flex:none;border-radius:50%;background:#55d3ff;color:#07111f}.explain li span{display:grid}.explain small{color:#b8cad8}@media(max-width:1000px){.grid{grid-template-columns:1fr 1fr}.explain{grid-template-columns:1fr}}@media(max-width:620px){.hero{padding:50px 26px}.grid,.explain ol{grid-template-columns:1fr}.grid ul,.grid p{min-height:0}.explain{padding:36px 24px}}</style>
