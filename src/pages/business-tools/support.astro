---
import BaseHead from "../../components/BaseHead.astro";
import BusinessToolsHeader from "../../components/BusinessToolsHeader.astro";
import BusinessToolsFooter from "../../components/BusinessToolsFooter.astro";
---
<!doctype html><html lang="en-GB"><head><BaseHead title="Business Tools Support | Trades Go Digital" description="Help with the Trades Go Digital Logo Maker and PDF Maker." /></head><body><BusinessToolsHeader /><main>
<section class="hero"><div><p class="eyebrow">BUSINESS TOOLS SUPPORT</p><h1>Help with Logo Maker and PDF Maker.</h1><p>Find quick answers or contact us if a payment, download or tool is not working correctly.</p></div><div class="actions"><a href="#quick-help">View quick help</a><a class="outline" href="mailto:support@trades-go-digital.co.uk?subject=Business%20Tools%20support">Email support</a></div></section>
<section id="quick-help" class="content"><div><p class="eyebrow dark">QUICK HELP</p><h2>Choose the tool you need help with.</h2></div><div class="cards"><article><span>01</span><h3>Logo Maker</h3><p>Create and adjust a logo, transfer it to PDF Maker, or download the paid SVG and PNG files.</p><ul><li>Your design saves in the browser on the device you are using.</li><li>Changing a paid design may require a new download purchase.</li><li>Use in PDF Maker transfers the current logo on the same device.</li></ul><a href="/logo-maker/">Open Logo Maker</a></article><article><span>02</span><h3>PDF Maker</h3><p>Create quotes, invoices, receipts, sign-off sheets, RAMS and permits using the live preview.</p><ul><li>Review every document carefully before downloading or sending it.</li><li>PDF information saves in the browser on the device you are using.</li><li>Use the zoom control to review the page; it does not change the downloaded PDF.</li></ul><a href="/pdf-maker/">Open PDF Maker</a></article></div></section>
<section class="help"><div><p class="eyebrow">PAYMENTS AND DOWNLOADS</p><h2>Before contacting support</h2></div><ol><li><b>1</b><span><strong>Keep the checkout page open</strong><small>After payment, allow the website to return you to the tool so the download can unlock.</small></span></li><li><b>2</b><span><strong>Use the same browser and device</strong><small>Your current design and payment confirmation are linked to that browser session.</small></span></li><li><b>3</b><span><strong>Tell us what happened</strong><small>Include the tool, approximate payment time, browser and a screenshot—but never send card details.</small></span></li></ol></section>
<section class="contact"><div><p class="eyebrow dark">STILL NEED HELP?</p><h2>Contact Business Tools support.</h2><p>Email <a href="mailto:support@trades-go-digital.co.uk">support@trades-go-digital.co.uk</a> with “Logo Maker” or “PDF Maker” in the subject. Include the email used at checkout and a short description of the problem.</p></div><a href="mailto:support@trades-go-digital.co.uk?subject=Business%20Tools%20support">Email support</a></section>
</main><BusinessToolsFooter /></body></html>
<style>:global(*){box-sizing:border-box}:global(body){margin:0;background:#eef3f7;color:#07111f;font-family:Inter,ui-sans-serif,system-ui,sans-serif;line-height:1.6}:global(a){color:inherit}.hero,.content,.help,.contact{width:min(1180px,calc(100% - 32px));margin:auto}.hero{display:flex;align-items:end;justify-content:space-between;gap:40px;padding:80px 56px;margin-top:42px;border-radius:18px;background:linear-gradient(135deg,#07111f,#123759);color:#fff}.hero h1{max-width:760px;margin:8px 0 14px;font-size:clamp(40px,6vw,70px);line-height:1}.hero p:not(.eyebrow){max-width:720px;color:#c7d7e5}.eyebrow{margin:0;color:#58d5ff;font-size:12px;font-weight:900;letter-spacing:1.5px}.eyebrow.dark{color:#007ca7}.actions{display:flex;flex-wrap:wrap;gap:10px}.actions a,.cards a,.contact>a{display:inline-flex;justify-content:center;padding:12px 18px;border-radius:8px;background:#ff6b00;color:#07111f;font-weight:900;text-decoration:none;white-space:nowrap}.actions .outline{border:1px solid #71879b;background:transparent;color:#fff}.content{padding:90px 0}.content h2,.help h2,.contact h2{margin:7px 0;font-size:clamp(32px,4vw,50px);line-height:1.1}.cards{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:35px}.cards article{padding:34px;border:1px solid #d7e1ea;border-radius:16px;background:#fff;box-shadow:0 14px 38px #07111f12}.cards span{color:#ff6b00;font-weight:900}.cards h3{margin:5px 0;font-size:30px}.cards p,.cards li,.contact p{color:#4a5c70}.cards li{margin:8px 0}.help{display:grid;grid-template-columns:.8fr 1.2fr;gap:70px;padding:64px;border-radius:18px;background:#07111f;color:#fff}.help ol{display:grid;gap:12px;margin:0;padding:0;list-style:none}.help li{display:flex;gap:15px;padding:18px;border:1px solid #3c607c;border-radius:10px;background:#ffffff08}.help li b{display:grid;place-items:center;width:38px;height:38px;flex:none;border-radius:50%;background:#55d3ff;color:#07111f}.help li span{display:grid}.help small{color:#b7c9d8}.contact{display:flex;align-items:center;justify-content:space-between;gap:35px;padding:70px 0}.contact>div{max-width:780px}.contact p a{text-decoration:underline}@media(max-width:780px){.hero,.contact{align-items:flex-start;flex-direction:column}.hero{padding:46px 28px}.cards,.help{grid-template-columns:1fr}.help{gap:30px;padding:38px 26px}.contact{padding:55px 0}}</style>
