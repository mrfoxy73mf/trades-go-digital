---
import BaseHead from "../../components/BaseHead.astro";
import BusinessToolsHeader from "../../components/BusinessToolsHeader.astro";
import BusinessToolsFooter from "../../components/BusinessToolsFooter.astro";
const sections=[
 {title:"Using Business Tools",text:["These terms apply only to the Trades Go Digital Logo Maker and PDF Maker. They do not replace the separate terms that apply to TGD Trades or other Trades Go Digital services.","You may use the tools for lawful personal or business purposes. You must not interfere with the website, attempt to bypass payment controls, or use the tools to create misleading, unlawful or infringing material."]},
 {title:"Your content and files",text:["You remain responsible for business names, logos, wording, customer information and other content you enter or upload. You confirm that you have permission to use that content.","Tool data is primarily saved in your browser on the device you are using. Clear browser storage, private browsing, device changes or browser settings may remove saved work. Download and keep copies of files you need."]},
 {title:"Logo Maker downloads",text:["You can preview and edit a logo before purchase. The price and available formats are shown before checkout. A successful payment unlocks the purchased design for download in the stated formats.","If you materially change an unlocked design, the changed design may require a new purchase. Transfer into PDF Maker or an eligible work pack may be offered separately and does not automatically include standalone download rights."]},
 {title:"PDF Maker downloads",text:["The PDF Maker creates documents from the information you provide. The price is shown before checkout. You must review names, addresses, totals, VAT, dates, safety information and all other content before downloading, issuing or relying on a document.","Templates are general productivity tools and are not legal, tax, accounting, health-and-safety or other professional advice. You remain responsible for ensuring each document is accurate and suitable for its intended purpose."]},
 {title:"Payments, problems and refunds",text:["Payments are processed by the payment provider shown at checkout. Trades Go Digital does not receive your full card details.","If payment succeeds but the download does not unlock, contact support with the checkout email, tool used and approximate transaction time. Do not send card details. Refund requests will be assessed in accordance with applicable UK consumer law and the circumstances of the purchase." ]},
 {title:"Availability and responsibility",text:["We aim to keep the tools available and working correctly but cannot promise uninterrupted or error-free access. Features, templates and prices may change; the current price will be shown before payment.","Nothing in these terms excludes liability that cannot legally be excluded. Subject to applicable law, Trades Go Digital is not responsible for business losses caused by inaccurate user input, failure to review a document, loss of browser-stored work or use of a generated file for an unsuitable purpose."]},
 {title:"Privacy and contact",text:["We use information needed to operate the tools, process and verify payments, provide support, prevent misuse and meet legal obligations. Browser storage may hold your current designs locally. Payment providers process payment information under their own privacy terms.","For Business Tools support or privacy questions, email support@trades-go-digital.co.uk. These terms are governed by the law of England and Wales, subject to any mandatory rights you have under applicable consumer law."]}
];
---
<!doctype html><html lang="en-GB"><head><BaseHead title="Business Tools Terms | Trades Go Digital" description="Terms for the Trades Go Digital Logo Maker and PDF Maker." /></head><body><BusinessToolsHeader /><main><header><p>BUSINESS TOOLS</p><h1>Terms for Logo Maker and PDF Maker</h1><span>Last updated: 10 November 2026</span></header><div class="layout"><nav aria-label="On this page"><strong>On this page</strong>{sections.map((section,index)=><a href={`#section-${index+1}`}>{section.title}</a>)}</nav><article><p class="intro">These focused terms cover the Business Tools area only. The main Trades Go Digital website and TGD Trades retain their own support information and terms.</p>{sections.map((section,index)=><section id={`section-${index+1}`}><span>{String(index+1).padStart(2,"0")}</span><div><h2>{section.title}</h2>{section.text.map(paragraph=><p>{paragraph}</p>)}</div></section>)}</article></div></main><BusinessToolsFooter /></body></html>
<style>:global(*){box-sizing:border-box}:global(html){scroll-behavior:smooth}:global(body){margin:0;background:#eef3f7;color:#07111f;font-family:Inter,ui-sans-serif,system-ui,sans-serif;line-height:1.7}:global(a){color:inherit}main{width:min(1180px,calc(100% - 32px));margin:auto;padding:44px 0 90px}header{padding:62px;border-radius:18px;background:linear-gradient(135deg,#07111f,#123759);color:#fff}header p{margin:0;color:#55d3ff;font-size:12px;font-weight:900;letter-spacing:1.6px}header h1{max-width:850px;margin:9px 0 18px;font-size:clamp(40px,6vw,68px);line-height:1}header span{color:#b9cad8}.layout{display:grid;grid-template-columns:260px 1fr;gap:60px;padding-top:56px}.layout>nav{position:sticky;top:20px;display:grid;align-self:start;gap:8px;padding:22px;border:1px solid #d6e0e9;border-radius:12px;background:#fff}.layout>nav strong{margin-bottom:6px}.layout>nav a{padding:7px 0;color:#536477;font-size:14px;text-decoration:none}.layout>nav a:hover{color:#e85f00}article{display:grid;gap:10px}.intro{margin:0 0 20px;padding:22px;border-left:6px solid #ff6b00;background:#fff;color:#3f5266}article section{display:grid;grid-template-columns:54px 1fr;gap:20px;padding:32px 0;border-bottom:1px solid #cbd6e0;scroll-margin-top:20px}article section>span{color:#ff6b00;font-weight:900}h2{margin:0;font-size:29px}article p{color:#43566b}@media(max-width:760px){main{padding-top:20px}header{padding:40px 26px}.layout{grid-template-columns:1fr;gap:28px}.layout>nav{position:static}article section{grid-template-columns:1fr;gap:4px}}</style>
