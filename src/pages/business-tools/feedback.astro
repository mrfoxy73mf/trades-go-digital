---
import BaseHead from "../../components/BaseHead.astro";
import BusinessToolsHeader from "../../components/BusinessToolsHeader.astro";
import BusinessToolsFooter from "../../components/BusinessToolsFooter.astro";
---
<!doctype html><html lang="en-GB"><head><BaseHead title="Business Tools Feedback | Trades Go Digital" description="Share feedback and improvement ideas for the Trades Go Digital Logo Maker and PDF Maker." /></head><body><BusinessToolsHeader/><main><section class="hero"><div><p>YOUR FEEDBACK</p><h1>Help us improve the tools.</h1><span>Tell us what works, what feels difficult and what would make Logo Maker or PDF Maker better for your business.</span></div><div class="score"><strong>2</strong><span>focused business tools</span><small>Built to improve from real user feedback</small></div></section><section class="workspace"><div class="intro"><p>SHARE YOUR EXPERIENCE</p><h2>What should we improve next?</h2><p>This form is for ideas and general feedback. If something is broken or a payment has failed, please use <a href="/business-tools/support/">Business Tools Support</a>.</p><ul><li>Tell us which tool you used</li><li>Rate the overall experience</li><li>Select the areas that need attention</li><li>Describe the change that would help you</li></ul></div><form id="feedback-form"><input class="trap" name="website" tabindex="-1" autocomplete="off"/><fieldset><legend>Which tool are you reviewing?</legend><div class="choices"><label><input type="radio" name="tool" value="Logo Maker" required/><span>Logo Maker</span></label><label><input type="radio" name="tool" value="PDF Maker"/><span>PDF Maker</span></label><label><input type="radio" name="tool" value="Both tools"/><span>Both tools</span></label></div></fieldset><fieldset><legend>How would you rate your experience?</legend><div class="ratings">{[1,2,3,4,5].map(number=><label><input type="radio" name="rating" value={number} required/><span><b>{number}</b><small>{number===1?"Poor":number===2?"Needs work":number===3?"Okay":number===4?"Good":"Excellent"}</small></span></label>)}</div></fieldset><fieldset><legend>What could be improved?</legend><div class="checks">{["Ease of use","Layout and readability","Templates","Logo design options","PDF document options","Mobile experience","Speed","Pricing","Payment and download","Help and guidance"].map(item=><label><input type="checkbox" name="categories" value={item}/><span>{item}</span></label>)}</div></fieldset><label class="comments">Your feedback<textarea name="comments" minlength="10" maxlength="4000" rows="7" required placeholder="Tell us what happened, what you expected, or what would make the tool easier to use."></textarea></label><div class="contact"><label>Email address — optional<input name="email" type="email" maxlength="254" autocomplete="email" placeholder="Only needed if you would like a reply"/></label><label class="permission"><input name="contact" type="checkbox"/><span>You may contact me about this feedback.</span></label></div><button type="submit">Send feedback</button><p id="status" role="status" aria-live="polite"></p></form><section id="thanks" class="thanks" hidden><p>FEEDBACK RECEIVED</p><h2>Thank you for helping us improve.</h2><strong id="reference"></strong><span>Your feedback has been sent to the Trades Go Digital team.</span><button id="another" type="button">Send more feedback</button></section></section></main><BusinessToolsFooter/><script>
const form=document.querySelector('#feedback-form'),status=document.querySelector('#status'),thanks=document.querySelector('#thanks');form.addEventListener('submit',async event=>{event.preventDefault();const button=form.querySelector('button[type="submit"]');button.disabled=true;status.textContent='Sending your feedback…';const data=new FormData(form),payload={tool:data.get('tool'),rating:Number(data.get('rating')),categories:data.getAll('categories'),comments:data.get('comments'),email:data.get('email'),contact:data.has('contact'),website:data.get('website')};try{const response=await fetch('/api/business-tools-feedback',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(payload)}),body=await response.json();if(!response.ok)throw new Error(body.error||'Feedback could not be sent.');document.querySelector('#reference').textContent=body.reference;form.hidden=true;thanks.hidden=false;}catch(error){status.textContent=error instanceof Error?error.message:'Feedback could not be sent.';}finally{button.disabled=false;}});document.querySelector('#another').addEventListener('click',()=>{form.reset();status.textContent='';thanks.hidden=true;form.hidden=false;});
</script></body></html>
<style>:global(*){box-sizing:border-box}:global(body){margin:0;background:#eef3f7;color:#07111f;font-family:Inter,ui-sans-serif,system-ui,sans-serif;line-height:1.6}:global(a){color:inherit}.hero,.workspace{width:min(1280px,calc(100% - 32px));margin:auto}.hero{display:grid;grid-template-columns:1fr 260px;gap:50px;align-items:center;padding:74px 64px;margin-top:42px;border-radius:18px;background:radial-gradient(circle at 90% 20%,#185182,transparent 36%),linear-gradient(135deg,#07111f,#102c49);color:#fff}.hero p,.intro>p,.thanks>p{margin:0;color:#55d3ff;font-size:12px;font-weight:900;letter-spacing:1.6px}.hero h1{margin:8px 0 16px;font-size:clamp(46px,6vw,76px);line-height:1}.hero div>span{display:block;max-width:760px;color:#c6d6e4;font-size:18px}.score{display:grid;padding:28px;border:1px solid #477493;border-radius:14px;background:#ffffff0b}.score strong{color:#ff7a1a;font-size:66px;line-height:1}.score span{font-weight:850}.score small{margin-top:10px;color:#9fb5c7}.workspace{display:grid;grid-template-columns:420px minmax(0,1fr);gap:65px;padding:80px 0}.intro{align-self:start;position:sticky;top:24px}.intro>p{color:#007da9}.intro h2,.thanks h2{margin:7px 0 15px;font-size:42px;line-height:1.08}.intro>p:not(:first-child),.intro li{color:#526377}.intro ul{padding-left:20px}.intro li{margin:9px 0}form{display:grid;gap:26px;padding:38px;border:1px solid #d5dfe8;border-radius:16px;background:#fff;box-shadow:0 18px 50px #07111f12}fieldset{margin:0;padding:0;border:0}legend,.comments,.contact>label:first-child{display:block;margin-bottom:12px;font-weight:900}.choices,.ratings,.checks{display:grid;gap:10px}.choices{grid-template-columns:repeat(3,1fr)}.ratings{grid-template-columns:repeat(5,1fr)}.checks{grid-template-columns:1fr 1fr}.choices label,.ratings label,.checks label{cursor:pointer}.choices input,.ratings input,.checks input{position:absolute;opacity:0}.choices span,.checks span{display:block;height:100%;padding:13px;border:1px solid #cbd6e0;border-radius:9px;background:#f8fafc;font-weight:750}.ratings span{display:grid;place-items:center;min-height:84px;padding:10px;border:1px solid #cbd6e0;border-radius:9px;background:#f8fafc}.ratings b{font-size:24px}.ratings small{color:#617286}.choices input:checked+span,.ratings input:checked+span,.checks input:checked+span{border-color:#ff6b00;background:#fff2e8;box-shadow:inset 0 -3px #ff6b00}textarea,input[type=email]{width:100%;margin-top:8px;padding:13px;border:1px solid #bac7d4;border-radius:8px;font:inherit}.contact{display:grid;grid-template-columns:1fr auto;gap:20px;align-items:end}.permission{display:flex;align-items:center;gap:9px;padding-bottom:12px}.permission input{width:18px;height:18px}form>button,.thanks button{width:max-content;padding:13px 21px;border:0;border-radius:8px;background:#ff6b00;color:#07111f;font:inherit;font-weight:900;cursor:pointer}form>button:disabled{opacity:.6}.trap{position:absolute;left:-9999px}.thanks{grid-column:2;padding:50px;border:2px solid #ff6b00;border-radius:16px;background:#fff}.thanks>p{color:#007da9}.thanks strong,.thanks>span{display:block}.thanks strong{margin:22px 0 5px;font-size:24px}.thanks>span{margin-bottom:24px;color:#526377}@media(max-width:900px){.hero,.workspace{grid-template-columns:1fr}.score{display:none}.intro{position:static}.thanks{grid-column:auto}}@media(max-width:620px){.hero{padding:48px 26px}.workspace{padding:45px 0}.choices,.ratings,.checks,.contact{grid-template-columns:1fr}.ratings{grid-template-columns:repeat(5,1fr)}.ratings small{display:none}form{padding:25px 20px}}</style>
