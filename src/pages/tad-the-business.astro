---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE } from "../consts";

const featureCards = [
	["Dashboard", "Income, profit, paid and outstanding figures, recent work, schedules and alerts."],
	["Jobs", "Private and agency jobs with labour, materials, VAT, photos, notes and status tracking."],
	["Quotes & invoices", "Itemised documents, live totals, PDF output, email delivery, public links and quote-to-job conversion."],
	["Customers", "Contact records, job history and secure customer portals."],
	["Materials & suppliers", "Catalogue, stock quantities, supplier details, receipt matching and job material allocation."],
	["Employees", "Worker records, wages, job allocation, payslips and CIS deductions."],
];

const officeCards = [
	{
		title: "Office Mailroom",
		text: "Supplier invoices and receipts can arrive by email or upload. Complete paperwork can be filed into Business Office, while anything unclear stays in Needs Review.",
	},
	{
		title: "Customer Portal",
		text: "Customers can open a private branded link to view their job pack, approve documents, send messages and check payment status.",
	},
	{
		title: "Accountant Tools",
		text: "Expenses, mileage, wages, invoices, VAT records and tax-year paperwork feed reports and exports for the accountant.",
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="TAD The Business - UK Trades Business Management App | Trades Go Digital"
			description="TAD The Business is a multi-user app platform for UK trades, bringing jobs, customers, quotes, invoices, expenses, wages, supplier paperwork and customer communication into one system."
		/>
		<meta property="og:site_name" content={SITE_TITLE} />
		<meta property="og:locale" content="en_GB" />
	</head>
	<body>
		<Header />
		<main class="tad-page">
			<section class="tad-hero" aria-labelledby="tad-title">
				<div class="tad-container tad-hero-grid">
					<div class="tad-copy">
						<p class="tad-eyebrow">New app platform</p>
						<h1 id="tad-title">TAD The Business</h1>
						<p class="tad-lead">
							A multi-user business platform for UK tradespeople, built to keep jobs, customers,
							quotes, invoices, expenses, supplier paperwork, wages, tax records and customer
							communication in one connected app.
						</p>
						<div class="tad-actions">
							<a href="#features">Explore features</a>
							<a href="/contact/#tgd-enquiry">Talk to us</a>
						</div>
					</div>
					<figure class="tad-hero-image">
						<img src="/images/tad-the-business-hero.png" alt="TAD The Business trades app branding" />
					</figure>
				</div>
			</section>

			<section class="tad-section tad-demo" aria-labelledby="tad-demo-title">
				<div class="tad-container">
					<p class="tad-eyebrow">Demo video</p>
					<h2 id="tad-demo-title">See TAD The Business in action.</h2>
					<div class="tad-video-frame">
						<video
							controls
							playsinline
							preload="metadata"
							poster="/images/tad-the-business-hero.png"
							src="/videos/tad-the-business-demo.mp4"
						>
							Your browser does not support the video tag.
						</video>
					</div>
				</div>
			</section>

			<section id="features" class="tad-section">
				<div class="tad-container">
					<p class="tad-eyebrow">One system. Every part. One business.</p>
					<h2>Your team, jobs, safety, data, plant and profit in one place.</h2>
					<div class="tad-feature-grid">
						{featureCards.map(([title, text]) => (
							<article>
								<h3>{title}</h3>
								<p>{text}</p>
							</article>
						))}
					</div>
				</div>
			</section>

			<section class="tad-section tad-office">
				<div class="tad-container">
					<p class="tad-eyebrow">Back office built in</p>
					<h2>Less chasing paperwork. More control of the business.</h2>
					<div class="tad-office-grid">
						{officeCards.map((item) => (
							<article>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))}
					</div>
				</div>
			</section>

			<section class="tad-section tad-install">
				<div class="tad-container tad-install-box">
					<div>
						<p class="tad-eyebrow">Installable app</p>
						<h2>Use it on phone, tablet or desktop.</h2>
						<p>
							TAD The Business is designed as an installable app experience. iPhone and iPad users
							can add it from Safari, Android users can install from Chrome, and desktop users can
							install from Chrome or Edge.
						</p>
					</div>
					<a href="/contact/#tgd-enquiry">Register interest</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.tad-page {
		--bg: #030407;
		--panel: rgba(10, 13, 18, 0.84);
		--fg: #f8fafc;
		--muted: #c7d0dc;
		--soft: rgba(255, 107, 0, 0.22);
		--accent: #ff6b00;
		background:
			linear-gradient(180deg, rgba(3, 4, 7, 0.02), rgba(3, 4, 7, 0.24) 42%, rgba(3, 4, 7, 0.36)),
			url("/images/tad-building-site-bg.png") center top / cover fixed,
			var(--bg);
		color: var(--fg);
		overflow-x: hidden;
	}

	.tad-page * {
		box-sizing: border-box;
	}

	.tad-container {
		width: min(1180px, calc(100% - 32px));
		margin: 0 auto;
	}

	.tad-hero {
		padding: clamp(46px, 7vw, 92px) 0;
		background: radial-gradient(circle at 74% 18%, rgba(255, 107, 0, 0.2), transparent 28%);
	}

	.tad-hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.92fr) minmax(320px, 1.08fr);
		gap: clamp(28px, 5vw, 62px);
		align-items: center;
	}

	.tad-eyebrow {
		margin: 0 0 12px;
		color: var(--accent);
		font-size: 0.78rem;
		font-weight: 950;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	h1,
	h2,
	h3,
	p {
		margin-top: 0;
	}

	h1 {
		max-width: 720px;
		margin-bottom: 18px;
		font-size: clamp(3.2rem, 8vw, 7rem);
		line-height: 0.92;
		letter-spacing: -0.055em;
	}

	h2 {
		max-width: 850px;
		margin-bottom: 18px;
		font-size: clamp(2rem, 4.2vw, 4rem);
		line-height: 1;
		letter-spacing: -0.045em;
	}

	h3 {
		margin-bottom: 10px;
		font-size: 1.2rem;
	}

	p {
		color: var(--muted);
		line-height: 1.65;
	}

	.tad-lead {
		max-width: 680px;
		font-size: clamp(1.05rem, 1.7vw, 1.3rem);
	}

	.tad-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 30px;
	}

	.tad-actions a,
	.tad-install-box > a {
		display: inline-flex;
		min-height: 48px;
		align-items: center;
		justify-content: center;
		padding: 13px 18px;
		border: 1px solid var(--accent);
		border-radius: 8px;
		background: var(--accent);
		color: #070707;
		font-weight: 950;
		text-decoration: none;
	}

	.tad-actions a:nth-child(2) {
		background: transparent;
		color: var(--fg);
	}

	.tad-hero-image {
		margin: 0;
	}

	.tad-hero-image img {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid rgba(255, 107, 0, 0.38);
		border-radius: 12px;
		box-shadow: 0 28px 90px rgba(0, 0, 0, 0.5), 0 0 46px rgba(255, 107, 0, 0.14);
	}

	.tad-section {
		padding: clamp(58px, 8vw, 96px) 0;
	}

	.tad-demo {
		padding-top: clamp(38px, 6vw, 76px);
	}

	.tad-video-frame {
		margin-top: 30px;
		border: 1px solid rgba(255, 107, 0, 0.38);
		border-radius: 12px;
		background: #000;
		box-shadow: 0 28px 90px rgba(0, 0, 0, 0.5), 0 0 46px rgba(255, 107, 0, 0.14);
		overflow: hidden;
	}

	.tad-video-frame video {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		background: #000;
	}

	.tad-feature-grid,
	.tad-office-grid {
		display: grid;
		gap: 18px;
		margin-top: 36px;
	}

	.tad-feature-grid {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.tad-office-grid {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.tad-feature-grid article,
	.tad-office-grid article,
	.tad-install-box {
		border: 1px solid var(--soft);
		border-radius: 10px;
		background: var(--panel);
		box-shadow: 0 20px 54px rgba(0, 0, 0, 0.34);
	}

	.tad-feature-grid article,
	.tad-office-grid article {
		padding: 26px;
	}

	.tad-install {
		background: radial-gradient(circle at 14% 16%, rgba(255, 107, 0, 0.14), transparent 30%);
	}

	.tad-install-box {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 28px;
		align-items: center;
		padding: clamp(26px, 4vw, 44px);
	}

	.tad-install-box p:last-child {
		margin-bottom: 0;
	}

	@media (max-width: 920px) {
		.tad-hero-grid,
		.tad-install-box {
			grid-template-columns: 1fr;
		}

		.tad-feature-grid,
		.tad-office-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 620px) {
		.tad-feature-grid,
		.tad-office-grid {
			grid-template-columns: 1fr;
		}

		.tad-actions,
		.tad-actions a,
		.tad-install-box > a {
			width: 100%;
		}
	}
</style>
