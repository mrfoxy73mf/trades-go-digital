---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE } from "../consts";

export const prerender = false;

const policies = [
	{
		"title": "Terms of Service",
		"paragraphs": [
			"These Terms govern access to TGD Trades (the “Service”), operated by Trades Go Digital (“we”, “us” or “our”). Contact: hello@trades-go-digital.co.uk. By creating an account or using the Service, you agree to these Terms.",
			"The Service is intended primarily for UK sole traders, self-employed tradespeople and small businesses. If you subscribe for a business, you confirm that you have authority to bind that business. If you use the Service as a consumer, your mandatory consumer rights are not excluded or restricted by these Terms.",
			"We grant you a limited, non-exclusive, non-transferable and revocable right to use the Service for your own lawful business purposes while your account and subscription remain active. You must provide accurate account information, keep login details secure and tell us promptly about suspected unauthorised access.",
			"You retain ownership of the information, documents, images and other material you upload or create (“Customer Data”). You give us a limited licence to host, copy, process and transmit Customer Data only as needed to provide, secure, support and improve the Service, comply with law and follow your instructions.",
			"We own, or have permission to use, the Service, its software, design, branding and content. These Terms do not transfer those rights to you. Feedback may be used to improve the Service without payment or obligation, but it does not give us ownership of your Customer Data.",
			"The Service may rely on third-party hosting, payment, email, storage and AI providers. Their availability can affect the Service. We may update, replace or discontinue features where reasonably necessary, and will give reasonable notice where a change materially reduces the paid Service.",
			"We aim to keep the Service available and secure but cannot promise uninterrupted or error-free operation. You are responsible for checking quotes, invoices, certificates, calculations and other outputs before relying on or sending them, and for keeping exports or copies needed for your business records.",
			"We may suspend access where reasonably necessary for security, maintenance, suspected misuse, legal compliance or overdue payment. Where practical, we will explain the reason and give you an opportunity to correct it. Either party may end the agreement as described under Subscription, Cancellation & Refunds.",
			"Nothing in these Terms limits liability that cannot legally be limited, including liability for death or personal injury caused by negligence, fraud or fraudulent misrepresentation. Subject to that, and to the fullest extent permitted by law, we are not liable for indirect or consequential loss, loss of profit, revenue, contracts, goodwill or anticipated savings. Our total liability arising in any 12-month period is limited to the fees you paid for the Service in that period. This paragraph does not reduce any mandatory consumer remedy.",
			"These Terms and disputes arising from them are governed by the law of England and Wales. The courts of England and Wales have jurisdiction, except that a consumer may have the right to bring proceedings in the part of the UK where they live. If one provision is unenforceable, the remaining provisions continue to apply. A failure to enforce a provision is not a waiver."
		]
	},
	{
		"title": "Privacy Notice",
		"paragraphs": [
			"Trades Go Digital is the controller of account, billing, support and website information described in this notice. For business records you enter about your customers, staff or subcontractors, your business will normally be the controller and we will process that information to provide the Service. Privacy enquiries and rights requests can be sent to hello@trades-go-digital.co.uk.",
			"We may collect account and contact details; business and subscription information; payment status and transaction references supplied by our payment provider (we do not receive full card details); Customer Data such as customer contacts, jobs, quotes, invoices, expenses, mileage, certificates, files and receipt images; support messages; and technical, security and usage records.",
			"We use this information to create and administer accounts, provide requested features, process and reconcile subscriptions, respond to support requests, secure and troubleshoot the Service, meet legal and accounting obligations, and improve the Service. We do not sell personal information or share it with third parties for their own advertising.",
			"Our lawful bases under UK data protection law depend on the purpose: performance of our contract for account and Service delivery; legal obligation for tax, accounting and regulatory records; legitimate interests in security, fraud prevention, support and proportionate product improvement; and consent where the law requires it. You may withdraw consent at any time, although this does not affect earlier lawful processing.",
			"We share only the information reasonably necessary with service providers that support hosting, databases, file storage, payments, email, monitoring, customer support and AI features; professional advisers; a purchaser of the business where appropriate safeguards apply; and public authorities where law requires it. Providers act under their own terms and, where they process information for us, appropriate contractual protections.",
			"Some providers may process information outside the UK. Where UK data protection law requires safeguards, we use an applicable adequacy regulation or contractual safeguards such as the UK International Data Transfer Agreement or UK Addendum, together with supplementary measures where appropriate.",
			"We keep account and Customer Data while the account is active and for only as long afterwards as needed for recovery, legal obligations, disputes and legitimate business purposes. Billing and tax records may need to be kept longer by law. Backup copies are removed through normal backup rotation and may not be deleted immediately. We will publish or provide more specific periods when the relevant systems and legal requirements are confirmed.",
			"Subject to legal conditions, you may ask for access, correction, deletion, restriction or portability of your personal information, or object to certain processing. You may also complain to the Information Commissioner’s Office at ico.org.uk. We normally respond within one month and may need to verify your identity.",
			"We use appropriate technical and organisational measures designed to protect information, including access controls and encrypted connections. No online service can guarantee absolute security. Please contact us promptly if you believe an account or personal information has been compromised.",
			"The Service is not directed to children and account holders must be at least 18. We use essential cookies or similar storage needed for login, security and core operation. If we introduce non-essential analytics or advertising technologies, we will update this notice and request consent where required."
		]
	},
	{
		"title": "AI Features & Disclaimer",
		"paragraphs": [
			"AI and voice features are optional productivity tools. When you choose to use them, the information included in your request may be sent to an AI, transcription or related service provider so the feature can respond. Do not submit unnecessary special-category, confidential or sensitive personal information.",
			"AI output may be inaccurate, incomplete, biased or out of date. It is not legal, tax, accounting, financial, health-and-safety, gas, electrical or other regulated professional advice. Check important facts against current official guidance or a suitably qualified professional.",
			"You remain responsible for reviewing and approving every quote, invoice, certificate, calculation, message and business decision, whether or not AI helped create it. We do not guarantee that AI output is suitable for a particular purpose.",
			"Use of AI features may be subject to fair-use limits, usage allowances or additional charges shown in the Service or at checkout. We will not apply a new charge without making it clear before the charge is incurred."
		]
	},
	{
		"title": "Subscription, Cancellation & Refunds",
		"paragraphs": [

			"Payments are processed by a third-party payment provider. A paid subscription renews automatically for the stated billing period until cancelled. You authorise the provider to collect each amount due using your selected payment method.",
			"You can cancel through the billing portal or by emailing hello@trades-go-digital.co.uk. Cancellation normally takes effect at the end of the current paid period, and no further renewal is charged. Except where the law requires otherwise or a charge resulted from our error, fees already paid are not refunded or prorated.",
			"If a payment fails, we may retry it and restrict paid features after reasonable notice. We may change future prices by giving at least 30 days’ notice; the new price will apply no earlier than the first renewal after that notice period. You may cancel before it takes effect.",
			"The Service is sold primarily to businesses. If you are legally a consumer, any cancellation, quality, refund or other statutory rights that apply to you remain unaffected. We will not treat use of the Service as a waiver of a consumer cancellation right unless the law allows it and the required express request and acknowledgement were obtained.",
			"On termination, export any records you need promptly. Access may end when the paid period expires. We may retain or delete information in accordance with the Privacy Notice, legal obligations and the technical backup cycle."
		]
	},
	{
		"title": "Acceptable Use",
		"paragraphs": [
			"You must use the Service lawfully and only for genuine business purposes. You are responsible for having a valid legal basis and any necessary notices or permissions for personal information you enter, upload or send through the Service.",
			"You must not use the Service for fraud, unlawful or infringing material, harassment, spam, phishing or unsolicited bulk messaging; attempt to access another account or bypass security; introduce malware; scrape, reverse engineer or overload the Service except where a right cannot legally be restricted; or use automated requests in a way that harms the Service or other users.",
			"Unless your plan says otherwise, an account covers one business and must not be shared outside that business. Each person with access must use authorised credentials and follow these Terms. Contact us if you need additional users or businesses.",
			"We may investigate suspected misuse and take proportionate steps including rate limits, content removal or suspension. We may act without advance notice where necessary to protect users, systems or comply with law."
		]
	},
	{
		"title": "Data, Exports & Backups",
		"paragraphs": [
			"Your Customer Data remains yours. Where export tools are available, use them regularly and check that the exported material contains the records you need. Export formats and the categories included may change as the Service develops.",
			"Operational and disaster-recovery backups are intended to restore the Service, not to replace your own records or statutory record-keeping. Restoration of an individual file or record may not always be possible.",
			"You may request account deletion by emailing hello@trades-go-digital.co.uk from your registered address. We will delete or anonymise information when required, subject to identity checks, legal retention duties, fraud prevention, dispute records and normal backup rotation.",
			"Do not rely on the Service as the only copy of information that is legally or commercially important. You remain responsible for retention periods that apply to your business, including HMRC, employment, health-and-safety and trade-specific requirements."
		]
	},
	{
		"title": "Changes & Contact",
		"paragraphs": [
			"We may update these policies to reflect changes to the Service, providers or law. We will post the revised version with a new date and, for a material change affecting an active paid subscription, give reasonable notice by email or in the Service. Changes will not retrospectively remove rights that have already arisen.",
			"Notices and questions can be sent to hello@trades-go-digital.co.uk. You should keep the email address on your account current so we can send important Service and legal notices.",

		]
	}
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Legal & Policies | ${SITE_TITLE}`}
			description="Terms of service, privacy, billing, AI use and data handling policies for TGD Trades."
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="terms-hero">
				<p class="eyebrow">Legal &amp; Policies</p>
				<h1>Legal information for TGD Trades.</h1>
				<p>Terms, privacy, billing, AI use and data handling for TGD Trades.</p>
				<p class="updated">Last updated 27 October 2026.</p>
			</section>

			<section class="policy-list" aria-label="Legal and policy dropdowns">
				{
					policies.map((policy, index) => (
						<details class="policy-item" open={index === 0}>
							<summary>
								<span>{policy.title}</span>
								<span class="summary-icon" aria-hidden="true">&gt;</span>
							</summary>
							<div class="policy-content">
								{policy.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
							</div>
						</details>
					))
				}
			</section>
		</main>
		<Footer />
		<script>
			const policyItems = document.querySelectorAll(".policy-item");

			policyItems.forEach((item) => {
				item.addEventListener("toggle", () => {
					if (!item.open) return;

					policyItems.forEach((otherItem) => {
						if (otherItem !== item) {
							otherItem.removeAttribute("open");
						}
					});
				});
			});
		</script>
	</body>
</html>

<style>
	body {
		min-height: 100vh;
		margin: 0;
		background: #f5f8fb;
		color: #0b1930;
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
	}

	main {
		width: min(960px, calc(100% - 32px));
		margin: 0 auto;
		padding: 72px 0;
	}

	.terms-hero {
		margin-bottom: 30px;
	}

	.eyebrow {
		margin: 0 0 12px;
		color: #b58a1f;
		font-size: 0.78rem;
		font-weight: 900;
		text-transform: uppercase;
	}

	h1 {
		max-width: 860px;
		margin: 0 0 14px;
		font-size: clamp(1.85rem, 4vw, 2.6rem);
		font-weight: 800;
		line-height: 1.15;
	}

	.terms-hero p {
		max-width: 760px;
		margin: 0 0 10px;
		color: #536174;
		font-size: 1.05rem;
		line-height: 1.7;
	}

	.updated {
		font-weight: 900;
	}

	.policy-list {
		display: grid;
		gap: 14px;
	}

	details {
		overflow: hidden;
		border: 1px solid rgba(7, 17, 31, 0.11);
		border-radius: 12px;
		background: #ffffff;
		box-shadow: 0 14px 34px rgba(12, 31, 55, 0.06);
		transition:
			border-color 180ms ease,
			box-shadow 180ms ease,
			transform 180ms ease;
	}

	details[open] {
		border-color: rgba(255, 107, 24, 0.4);
		box-shadow: 0 20px 46px rgba(12, 31, 55, 0.1), 0 0 0 1px rgba(255, 107, 24, 0.08);
		transform: translateY(-1px);
	}

	summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 21px 22px;
		color: #0b1930;
		font-size: 1.08rem;
		font-weight: 900;
		cursor: pointer;
		list-style: none;
		outline: none;
		transition: background 180ms ease;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary:hover,
	summary:focus-visible {
		background: #f8fbff;
	}

	summary:focus-visible {
		box-shadow: inset 0 0 0 3px rgba(105, 213, 255, 0.32);
	}

	.summary-icon {
		flex: 0 0 auto;
		color: #ff6b18;
		font-size: 1.35rem;
		font-weight: 900;
		line-height: 1;
		transition: transform 180ms ease;
	}

	details[open] .summary-icon {
		transform: rotate(90deg);
	}

	.policy-content {
		display: grid;
		gap: 12px;
		padding: 0 22px 24px;
		border-top: 1px solid rgba(7, 17, 31, 0.08);
		background:
			linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
	}

	.policy-content p {
		margin: 0;
		color: #536174;
		font-size: 1rem;
		line-height: 1.7;
	}

	.policy-content p:first-child {
		padding-top: 20px;
	}

	@media (max-width: 720px) {
		main {
			padding: 48px 0;
		}

		summary {
			padding: 18px;
		}

		.policy-content {
			padding: 0 18px 20px;
		}
	}
</style>
