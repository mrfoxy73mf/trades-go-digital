---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
export const prerender = false;
---
<html lang="en-GB"><head><BaseHead title="Create a work pack | SafeWork AI" description="Prepare a job-specific SafeWork AI draft work pack." /></head><body class="safework-office"><Header/><main class="workspace"><a href="/health-and-safety">← Health &amp; Safety</a><p class="eyebrow">SAFEWORK AI / WORK PACKS</p><h1>Create your work pack</h1><p>Describe the job. Review the details and price before paying. Your pack is a draft for competent-person review.</p><div class="layout"><form id="pack-form"><label>Company name<input name="company" required maxlength="200" autocomplete="organization" /></label><label>Company address <span>(optional)</span><input name="companyAddress" maxlength="500" /></label><label>Contact telephone <span>(optional)</span><input name="contact" maxlength="200" type="tel" /></label><label>Job description<textarea name="description" required minlength="8" maxlength="12000" rows="8" placeholder="Describe the work, workforce, tools, materials, access and known site conditions."></textarea></label><label>Job address<textarea name="address" required minlength="5" maxlength="500" rows="2"></textarea></label><label>Confirmed emergency arrangements <span>(optional)</span><textarea name="emergency" maxlength="1500" rows="3" placeholder="Site contact, first aider and other verified emergency information. Leave unknown details blank."></textarea></label><label class="check"><input type="checkbox" name="reviewAccepted" required/>I understand this is an AI-generated draft that must be checked by a competent person before use.</label><label class="check"><input type="checkbox" name="processingAccepted" required/>I agree to send these job details to OpenAI to prepare the pack and store the order with Trades Go Digital. I will not include unnecessary personal or sensitive information.</label><button id="review" type="submit" disabled>Review order</button></form><aside><h2>Your work pack</h2><ul><li>Company-branded draft</li><li>Method statement and work sequence</li><li>Risk assessment and controls</li><li>Relevant COSHH assessments</li><li>Emergency and briefing records</li><li>Applicable supporting forms</li><li>A4 document download and repeat access</li></ul><p id="price">Checking availability…</p><p>No subscription. One purchase covers one job description.</p><p>Download as HTML and use your browser’s Print / Save as PDF. Review and complete the document before work.</p></aside></div><section id="confirmation" hidden><h2>Check your order</h2><pre id="summary"></pre><p id="total"></p><p>If generation fails, return to this order and retry without paying again.</p><button id="pay">Continue to Stripe</button> <button id="edit" class="secondary">Edit details</button></section><p role="status" id="message"></p><section id="recovery" hidden><h2>Keep your private order link</h2><p>This link gives access to your order and document. Save it somewhere private before continuing.</p><a id="order-link">Open / save order link</a><p><a id="stripe-link" class="button">Continue to payment →</a></p></section></main><Footer/></body></html>
<script>
const form=document.querySelector<HTMLFormElement>('#pack-form')!;
const msg=document.querySelector<HTMLElement>('#message')!;
const review=document.querySelector<HTMLButtonElement>('#review')!;
const confirmation=document.querySelector<HTMLElement>('#confirmation')!;
const pay=document.querySelector<HTMLButtonElement>('#pay')!;
let payload:Record<string,unknown>={};let price='';
fetch('/api/safework/checkout').then(r=>r.json()).then(c=>{price=typeof c.amount==='number'?new Intl.NumberFormat('en-GB',{style:'currency',currency:'GBP'}).format(c.amount/100):'';document.querySelector('#price')!.textContent=c.enabled?`${price} total${c.mode==='test'?' — TEST CHECKOUT, no real payment':''}`:'Online sales are not open yet.';review.disabled=!c.enabled;}).catch(()=>{document.querySelector('#price')!.textContent='Availability could not be checked. Please reload.';});
form.addEventListener('submit',e=>{e.preventDefault();const data=new FormData(form);payload=Object.fromEntries(data);payload.reviewAccepted=data.has('reviewAccepted');payload.processingAccepted=data.has('processingAccepted');document.querySelector('#summary')!.textContent=`Company: ${data.get('company')}\nJob: ${data.get('description')}\nAddress: ${data.get('address')}\nEmergency details: ${data.get('emergency') || 'To be confirmed before work'}`;document.querySelector('#total')!.textContent=`Total: ${price} for one draft work pack.`;form.hidden=true;confirmation.hidden=false;confirmation.scrollIntoView({behavior:'smooth'});});
document.querySelector('#edit')!.addEventListener('click',()=>{form.hidden=false;confirmation.hidden=true;});
pay.addEventListener('click',async()=>{pay.disabled=true;msg.textContent='Opening your order…';try{const r=await fetch('/api/safework/checkout',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});const d=await r.json();if(!r.ok)throw new Error(d.error);const link=document.querySelector<HTMLAnchorElement>('#order-link')!;link.href=d.returnUrl;const stripe=document.querySelector<HTMLAnchorElement>('#stripe-link')!;stripe.href=d.url;document.querySelector<HTMLElement>('#recovery')!.hidden=false;confirmation.hidden=true;msg.textContent='Order saved. Keep your private link, then continue to Stripe.';}catch(e){msg.textContent=e instanceof Error?e.message:'Checkout failed.';pay.disabled=false;}});
</script>
<style>
body{background:#f4f6f2;color:#17392d}.workspace{max-width:1100px;margin:auto;padding:35px 22px 70px}.eyebrow{font-size:12px;letter-spacing:.14em;margin-top:30px}h1{font-size:38px;line-height:1.15}.layout{display:grid;grid-template-columns:1.5fr 1fr;gap:32px}form,aside,#confirmation,#recovery{background:white;border:1px solid #d5dfd6;border-radius:8px;padding:26px}aside{align-self:start}label{display:block;font-weight:700;margin-bottom:18px}label span{font-weight:400}input:not([type=checkbox]),textarea{display:block;width:100%;padding:12px;border:1px solid #aebeb2;border-radius:4px;font:inherit;margin-top:6px}textarea{resize:vertical}.check{display:flex;align-items:flex-start;gap:10px;font-size:14px;font-weight:400}.check input{margin-top:5px}button,.button{background:#17392d;color:white;padding:13px 20px;border:0;border-radius:4px;font:inherit;font-weight:700;cursor:pointer;display:inline-block}button:disabled{opacity:.5;cursor:not-allowed}.secondary{background:#e2eadf;color:#17392d}#price{font-size:24px;font-weight:800}pre{white-space:pre-wrap;font:inherit;overflow-wrap:anywhere}[hidden]{display:none!important}a:focus-visible,button:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid #b18123;outline-offset:3px}@media(max-width:720px){.layout{grid-template-columns:1fr}.workspace{padding:24px 16px}h1{font-size:30px}form,aside{padding:20px}}

body{background:#07111f url('/images/safework-office-background.png') center top / cover fixed no-repeat;color:#10243b}
.workspace{max-width:1180px;min-height:100vh;background:linear-gradient(90deg,rgba(7,17,31,.78),rgba(7,17,31,.55));padding:44px 40px 80px}
.workspace>h1,.workspace>a,.workspace>.eyebrow,.workspace>p{color:#fff}.workspace>.eyebrow{color:#ffb66e}.workspace>p{max-width:760px}
form,aside,#confirmation,#recovery{background:#fff;border-color:#dce3eb;box-shadow:0 16px 40px #0003;border-radius:10px}aside{border-top:4px solid #f58220}
button,.button{background:#f58220;color:#07111f}.secondary{background:#e7edf3;color:#10243b}
input:not([type=checkbox]),textarea{background:#fafbfd;color:#10243b;border-color:#a9b7c5}
@media(max-width:720px){body{background-attachment:scroll}.workspace{padding:28px 16px 50px;background:rgba(7,17,31,.72)}}

:global(body.safework-office){background-color:#07111f;background-image:linear-gradient(rgba(7,17,31,.48),rgba(7,17,31,.48)),url('/images/safework-office-background.png');background-size:auto, max(100vw,1200px) auto;background-position:center top;background-repeat:repeat;background-attachment:scroll}
:global(body.safework-office main){background:transparent}
:global(body.safework-office>header),:global(body.safework-office>footer){background:rgba(7,17,31,.76);border:0}
:global(body.safework-office footer .footer-brand),:global(body.safework-office footer .footer-contact-list),:global(body.safework-office footer .footer-links),:global(body.safework-office footer .footer-bottom),:global(body.safework-office footer li),:global(body.safework-office footer .footer-contact-list p){border:0;box-shadow:none}
:global(body.safework-office footer .footer-contact-list),:global(body.safework-office footer .footer-links){background:transparent}
.hero,.advice{background:rgba(7,17,31,.48)}
.hero .lead,.advice p:not(.eyebrow){color:#fff}

:global(html){min-height:100%;background:#07111f}
:global(body.safework-office){position:relative;isolation:isolate;background:none}
:global(body.safework-office)::before{content:"";position:fixed;inset:0;z-index:-1;pointer-events:none;background:linear-gradient(rgba(7,17,31,.65),rgba(7,17,31,.65)),url('/images/safework-office-background.png') center center / cover no-repeat}
:global(body.safework-office>header),:global(body.safework-office>footer),:global(body.safework-office main),.hero,.advice,.workspace{background:transparent}
</style>
