---
import BaseHead from '../../components/BaseHead.astro';
export const prerender = false;
Astro.response.headers.set('Referrer-Policy','no-referrer');
Astro.response.headers.set('Cache-Control','no-store');
---
<html lang="en-GB"><head><BaseHead title="Your work pack | SafeWork AI" description="Return to your private SafeWork order."/><meta name="robots" content="noindex,nofollow"/></head><body><main><a href="/health-and-safety">Trades Go Digital / SafeWork AI</a><h1>Your work pack</h1><p id="status" role="status">Loading your order…</p><section id="generation-progress" hidden aria-live="polite"><span class="progress-spinner" aria-hidden="true"></span><span><strong>Payment confirmed — generating your work pack</strong><small>Keep this page open. This can take a few minutes.</small></span></section><div id="actions"><button id="refresh">Refresh status</button><button id="generate" hidden>Generate my paid pack</button><a id="checkout" hidden>Return to payment</a><button id="preview" hidden>View work pack</button><button id="download" hidden>Download fillable PDF</button></div><section id="signoff" hidden><p class="eyebrow">DIGITAL APPROVAL</p><h2>Approve and brief your team</h2><p>Review and amend the pack for the actual site before signing. Once submitted, this record is locked and added to future downloads.</p><form id="signoff-form"><label>Approving supervisor’s name<input name="supervisorName" required maxlength="150"></label><label>Role<input name="supervisorRole" required maxlength="150" placeholder="For example: chargehand or site supervisor"></label><div id="worker-names"></div><label class="check"><input type="checkbox" name="approved" required>I have reviewed and approved the pack for this job.</label><label class="check"><input type="checkbox" name="workersConfirmed" required>The named workers have been briefed and acknowledged the pack.</label><button type="submit">Lock digital sign-off</button></form><p id="signoff-status" role="status"></p></section><p id="note"></p><p>Keep this page’s full private link to return to your order. Anyone with the link can access the pack.</p><p>Need help? <a href="mailto:support@trades-go-digital.co.uk">Contact support</a> and quote order <strong id="reference"></strong>. Do not send your private access link.</p><p>AI-generated documents require competent-person review before use. Use <strong>Download fillable PDF</strong> to save the complete document for your records or digital-signing service.</p></main><dialog id="pack-preview"><div class="preview-bar"><strong>Work pack preview</strong><div><button id="print-pack" type="button">Print / Save as PDF</button><button id="close-preview" type="button">Close preview</button></div></div><iframe title="Generated SafeWork work pack" sandbox="allow-modals allow-same-origin"></iframe></dialog></body></html>
<script>
import html2canvas from 'html2canvas';
import { AcroFormTextField, jsPDF } from 'jspdf';
const id=new URL(location.href).searchParams.get('id')||'';const access=location.hash.slice(1);
const status=document.querySelector<HTMLElement>('#status')!;const generationProgress=document.querySelector<HTMLElement>('#generation-progress')!;const generate=document.querySelector<HTMLButtonElement>('#generate')!;const preview=document.querySelector<HTMLButtonElement>('#preview')!;const download=document.querySelector<HTMLButtonElement>('#download')!;const checkout=document.querySelector<HTMLAnchorElement>('#checkout')!;const previewDialog=document.querySelector<HTMLDialogElement>('#pack-preview')!;const previewFrame=previewDialog.querySelector('iframe')!;
document.querySelector('#reference')!.textContent=id;
const headers={Authorization:`Bearer ${access}`};const endpoint=(name:string)=>`/api/safework/${name}?id=${encodeURIComponent(id)}`;
let generationStarted=false;
async function loadSignoff(){const section=document.querySelector<HTMLElement>('#signoff')!;const r=await fetch(endpoint('signoff'),{headers});if(!r.ok)return;const d=await r.json();section.hidden=false;const form=document.querySelector<HTMLFormElement>('#signoff-form')!;const message=document.querySelector<HTMLElement>('#signoff-status')!;if(d.signed){form.hidden=true;message.textContent=`Digitally approved by ${d.approval.supervisorName}. Future downloads include the locked audit sheet.`;return;}const workers=document.querySelector<HTMLElement>('#worker-names')!;if(!workers.children.length)for(let n=1;n<=d.workerCount;n++){const label=document.createElement('label');label.textContent=`Worker ${n} name`;const input=document.createElement('input');input.name='workerName';input.required=true;input.maxLength=150;label.append(input);workers.append(label);}}
async function refresh(){try{const r=await fetch(endpoint('order'),{headers});const d=await r.json();if(!r.ok)throw new Error(d.error);status.textContent=d.status==='ready'?'Your draft pack is ready to view and download.':d.status==='paid'?'Payment confirmed. Preparing your work pack…':'Payment has not been confirmed. If you cancelled checkout, you can return below.';generationProgress.hidden=d.status!=='paid'&&d.status!=='ready';generationProgress.classList.toggle('ready',d.status==='ready');generationProgress.querySelector('strong')!.textContent=d.status==='ready'?'Work pack ready':'Payment confirmed — generating your work pack';generationProgress.querySelector('small')!.textContent=d.status==='ready'?'View or download the completed PDF below.':'Keep this page open. This can take a few minutes.';generate.hidden=d.status!=='paid';generate.disabled=d.working||!d.retryAvailable;preview.hidden=d.status!=='ready';download.hidden=d.status!=='ready';checkout.hidden=!d.checkoutUrl;if(d.checkoutUrl)checkout.href=d.checkoutUrl;document.querySelector('#note')!.textContent=d.working?'Generation is running. Refresh shortly.':!d.retryAvailable&&d.status!=='ready'?'Contact support to complete this order. Do not pay again.':'';if(d.status==='ready')await loadSignoff();if(d.status==='paid'&&!d.working&&d.retryAvailable&&!generationStarted){generationStarted=true;await runGeneration();}}catch(e){status.textContent=e instanceof Error?e.message:'Unable to retrieve order.';}}
document.querySelector('#refresh')!.addEventListener('click',refresh);
async function runGeneration(){generate.disabled=true;status.textContent='Payment confirmed. Preparing your draft pack; this can take a few minutes. Keep this page open.';generationProgress.hidden=false;generationProgress.classList.remove('ready');try{const r=await fetch(endpoint('generate'),{method:'POST',headers});const d=await r.json();if(!r.ok)throw new Error(d.error);await refresh();}catch(e){generationStarted=false;status.textContent=e instanceof Error?e.message:'Connection interrupted. Refresh the order before retrying; do not pay again.';generate.disabled=false;generate.hidden=false;}}
generate.addEventListener('click',runGeneration);
async function fetchPack(){const r=await fetch(endpoint('download'),{headers,cache:'no-store'});if(!r.ok)throw new Error('Work pack unavailable. Please refresh.');return {html:await r.text(),filename:r.headers.get('X-SafeWork-Filename')||`SafeWork-${id.slice(0,8)}.html`};}
preview.addEventListener('click',async()=>{preview.disabled=true;status.textContent='Opening the correct work pack…';try{const pack=await fetchPack();const responsive='<style>@media screen and (max-width:850px){html,body{overflow-x:hidden}.sheet{width:100%!important;min-height:auto!important;margin:8px 0!important;padding:20px!important}.cover-sheet{padding:0!important}.cover-sheet>header,.cover-sheet>footer{margin-left:20px!important;margin-right:20px!important}.cover{min-height:700px!important;padding:50px 28px!important}.two{grid-template-columns:1fr!important}table{font-size:9px!important}}</style>';previewFrame.addEventListener('load',()=>{const doc=previewFrame.contentDocument,sheet=doc?.querySelector<HTMLElement>('.sheet');if(doc&&sheet&&previewFrame.clientWidth>850){const scale=Math.min(1.55,(previewFrame.clientWidth-36)/sheet.offsetWidth);doc.documentElement.style.setProperty('--preview-scale',String(scale));}},{once:true});previewFrame.srcdoc=pack.html.replace('</head>',responsive.replace('</style>','.sheet{zoom:var(--preview-scale,1)}</style>')+'</head>');previewDialog.showModal();status.textContent='Your draft pack is open for inspection.';}catch(e){status.textContent=e instanceof Error?e.message:String(e);}finally{preview.disabled=false;}});
document.querySelector('#close-preview')!.addEventListener('click',()=>previewDialog.close());
document.querySelector<HTMLFormElement>('#signoff-form')!.addEventListener('submit',async(e)=>{e.preventDefault();const form=e.currentTarget;const data=new FormData(form);const message=document.querySelector<HTMLElement>('#signoff-status')!;if(!confirm('Lock this approval and workforce acknowledgement? It cannot be edited afterwards.'))return;const r=await fetch(endpoint('signoff'),{method:'POST',headers:{...headers,'Content-Type':'application/json'},body:JSON.stringify({supervisorName:data.get('supervisorName'),supervisorRole:data.get('supervisorRole'),workers:data.getAll('workerName'),approved:data.has('approved'),workersConfirmed:data.has('workersConfirmed')})});const d=await r.json();message.textContent=r.ok?'Digital sign-off locked. Download the pack again to include its audit sheet.':d.error;if(r.ok)await loadSignoff();});
const loadPackFrame=(html:string)=>new Promise<void>((resolve,reject)=>{const timer=setTimeout(()=>reject(new Error('The PDF preview took too long to load.')),20000);previewFrame.addEventListener('load',()=>{clearTimeout(timer);resolve();},{once:true});previewFrame.srcdoc=html;});
const addEditableFields=(pdf:jsPDF,sheet:HTMLElement,pageIndex:number)=>{const sheetRect=sheet.getBoundingClientRect();let fieldIndex=0;const addField=(element:HTMLElement,kind:'cell'|'signature'|'notes')=>{const rect=element.getBoundingClientRect();if(rect.width<18||rect.height<10)return;const x=(rect.left-sheetRect.left)/sheetRect.width*210;let y=(rect.top-sheetRect.top)/sheetRect.height*297;const width=rect.width/sheetRect.width*210;let height=rect.height/sheetRect.height*297;if(kind==='signature'){const labelHeight=Math.min(height*.45,4.5);y+=labelHeight;height-=labelHeight;}if(width<4||height<2.5)return;const field=new AcroFormTextField();field.fieldName=`page_${pageIndex+1}_field_${++fieldIndex}`;field.x=Math.max(0,x+.6);field.y=Math.max(0,y+.5);field.width=Math.max(3,width-1.2);field.height=Math.max(2.5,height-1);field.fontSize=kind==='notes'?8:7;field.multiline=kind==='notes'||height>9;field.doNotScroll=false;field.hasAppearanceStream=true;field.textAlign='left';pdf.addField(field);};sheet.querySelectorAll<HTMLElement>('td').forEach(cell=>{const text=(cell.textContent||'').replace(/\u00a0/g,'').trim();if(!text)addField(cell,'cell');});sheet.querySelectorAll<HTMLElement>('.signature-block span').forEach(field=>addField(field,'signature'));sheet.querySelectorAll<HTMLElement>('.sketch').forEach(field=>addField(field,'notes'));};
download.addEventListener('click',async()=>{download.disabled=true;status.textContent='Preparing your fillable PDF…';try{const pack=await fetchPack();if(!previewDialog.open)previewDialog.showModal();await loadPackFrame(pack.html);const frameDocument=previewFrame.contentDocument;if(!frameDocument)throw new Error('The work pack could not be opened for PDF creation.');const sheets=[...frameDocument.querySelectorAll<HTMLElement>('.sheet')];if(!sheets.length)throw new Error('No A4 pages were found in this work pack.');const pdf=new jsPDF({orientation:'portrait',unit:'mm',format:'a4',compress:true});for(let index=0;index<sheets.length;index++){status.textContent=`Creating fillable PDF page ${index+1} of ${sheets.length}…`;const canvas=await html2canvas(sheets[index],{scale:1.5,backgroundColor:'#ffffff',logging:false,useCORS:false});if(index)pdf.addPage('a4','portrait');pdf.addImage(canvas.toDataURL('image/jpeg',.9),'JPEG',0,0,210,297,undefined,'FAST');addEditableFields(pdf,sheets[index],index);canvas.width=1;canvas.height=1;}pdf.save(pack.filename.replace(/\.html$/i,'-fillable.pdf'));previewDialog.close();status.textContent='Your fillable PDF has downloaded. Open it in Adobe Acrobat, Microsoft Edge or another PDF app to enter details, signatures and notes, then save the completed copy.';}catch(e){status.textContent=e instanceof Error?e.message:String(e);}finally{download.disabled=false;}});
document.querySelector('#print-pack')!.addEventListener('click',()=>previewFrame.contentWindow?.print());
if(!/^[a-f0-9]{64}$/.test(access))status.textContent='The private access code is missing. Open the full order link you saved before payment.';else refresh();
</script>
<style>#generation-progress{display:flex;align-items:center;gap:16px;margin:22px 0;padding:18px 22px;border:2px solid #15803d;border-radius:10px;background:#dcfce7;color:#14532d;box-shadow:0 8px 24px #15803d22}#generation-progress[hidden]{display:none}#generation-progress span:last-child{display:grid;gap:3px}#generation-progress strong{font-size:19px}#generation-progress small{font-size:14px}.progress-spinner{width:28px;height:28px;border:4px solid #86efac;border-top-color:#15803d;border-radius:50%;animation:pack-spin .9s linear infinite}#generation-progress.ready .progress-spinner{border:0;background:#15803d;animation:none;display:grid;place-items:center}#generation-progress.ready .progress-spinner:after{content:"✓";color:#fff;font-weight:900;font-size:18px}@keyframes pack-spin{to{transform:rotate(360deg)}}body{background:#f1f5ef;color:#183b2c;font-family:system-ui}main{max-width:900px;margin:50px auto;padding:30px;background:white;border:1px solid #ccd9cd;border-radius:8px}h1{font-size:36px}#actions{display:flex;gap:12px;flex-wrap:wrap}button,#checkout{padding:13px 18px;background:#183b2c;color:white;border:0;border-radius:4px;font:inherit;cursor:pointer}#preview{background:#f97316}button:disabled{opacity:.5}[hidden]{display:none!important}p{line-height:1.65}#status{font-size:20px}strong{overflow-wrap:anywhere}#signoff{margin:28px 0;padding:30px;border:2px solid #f97316;border-radius:12px;background:#fffaf5}.eyebrow{font-size:12px;font-weight:800;letter-spacing:.12em;color:#a43d00}#signoff-form>label{display:block;font-weight:700;margin:18px 0}#signoff-form input[type=text],#signoff-form input:not([type]){box-sizing:border-box;display:block;width:100%;min-width:0;margin-top:7px;padding:13px;border:1px solid #9fb0a7;border-radius:6px;background:#fff;font:inherit}#worker-names{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px 20px;margin:24px 0;padding:22px;border:1px solid #d7dfd8;border-radius:8px;background:#fff}#worker-names :global(label){display:grid;grid-template-columns:1fr;gap:7px;min-width:0;margin:0;font-weight:700}#worker-names :global(input){box-sizing:border-box;display:block;width:100%;min-width:0;margin:0;padding:13px;border:1px solid #9fb0a7;border-radius:6px;background:#fff;font:inherit}.check{display:grid!important;grid-template-columns:24px 1fr;gap:12px;align-items:start;font-weight:600!important}.check input{width:20px;height:20px;margin:2px 0 0}#signoff-form>button[type=submit]{width:100%;margin-top:8px;padding:15px;font-weight:800}dialog{width:100vw;height:100vh;max-width:none;max-height:none;padding:0;border:0;border-radius:8px;box-shadow:0 24px 80px #0008}dialog::backdrop{background:#07111fe6}.preview-bar{min-height:58px;padding:10px 14px;background:#07111f;color:#fff;display:flex;align-items:center;justify-content:space-between;gap:12px}.preview-bar>div{display:flex;gap:8px}.preview-bar button{padding:9px 14px;background:#f97316}.preview-bar+iframe{display:block;width:100%;height:calc(100vh - 58px);border:0;background:#e8ece9}@media(max-width:650px){main{margin:15px;padding:20px}#signoff{padding:20px}#worker-names{grid-template-columns:1fr;padding:16px}dialog{width:100vw;height:100vh;max-width:none;max-height:none}.preview-bar{align-items:flex-start}.preview-bar>div{flex-wrap:wrap;justify-content:flex-end}.preview-bar+iframe{height:calc(100vh - 76px)}}</style>
