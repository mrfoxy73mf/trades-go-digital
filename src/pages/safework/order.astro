---
import BaseHead from '../../components/BaseHead.astro';
export const prerender = false;
Astro.response.headers.set('Referrer-Policy','no-referrer');
Astro.response.headers.set('Cache-Control','no-store');
---
<html lang="en-GB"><head><BaseHead title="Your work pack | SafeWork AI" description="Return to your private SafeWork order."/><meta name="robots" content="noindex,nofollow"/></head><body><main><a href="/health-and-safety">Trades Go Digital / SafeWork AI</a><h1>Your work pack</h1><p id="status" role="status">Loading your order…</p><div id="actions"><button id="refresh">Refresh status</button><button id="generate" hidden>Generate my paid pack</button><a id="checkout" hidden>Return to payment</a><button id="download" hidden>Download work pack</button></div><p id="note"></p><p>Keep this page’s full private link to return to your order. Anyone with the link can access the pack.</p><p>Need help? <a href="mailto:support@trades-go-digital.co.uk">Contact support</a> and quote order <strong id="reference"></strong>. Do not send your private access link.</p><p>AI-generated documents require competent-person review before use. Open the downloaded HTML file and choose Print / Save as PDF for a PDF copy.</p></main></body></html>
<script>
const id=new URL(location.href).searchParams.get('id')||'';const access=location.hash.slice(1);
const status=document.querySelector<HTMLElement>('#status')!;const generate=document.querySelector<HTMLButtonElement>('#generate')!;const download=document.querySelector<HTMLButtonElement>('#download')!;const checkout=document.querySelector<HTMLAnchorElement>('#checkout')!;
document.querySelector('#reference')!.textContent=id;
const headers={Authorization:`Bearer ${access}`};const endpoint=(name:string)=>`/api/safework/${name}?id=${encodeURIComponent(id)}`;
let generationStarted=false;
async function refresh(){try{const r=await fetch(endpoint('order'),{headers});const d=await r.json();if(!r.ok)throw new Error(d.error);status.textContent=d.status==='ready'?'Your draft pack is ready to download.':d.status==='paid'?'Payment confirmed. Preparing your work pack…':'Payment has not been confirmed. If you cancelled checkout, you can return below.';generate.hidden=d.status!=='paid';generate.disabled=d.working||!d.retryAvailable;download.hidden=d.status!=='ready';checkout.hidden=!d.checkoutUrl;if(d.checkoutUrl)checkout.href=d.checkoutUrl;document.querySelector('#note')!.textContent=d.working?'Generation is running. Refresh shortly.':!d.retryAvailable&&d.status!=='ready'?'Contact support to complete this order. Do not pay again.':'';if(d.status==='paid'&&!d.working&&d.retryAvailable&&!generationStarted){generationStarted=true;await runGeneration();}}catch(e){status.textContent=e instanceof Error?e.message:'Unable to retrieve order.';}}
document.querySelector('#refresh')!.addEventListener('click',refresh);
async function runGeneration(){generate.disabled=true;status.textContent='Payment confirmed. Preparing your draft pack; this can take a few minutes. Keep this page open.';try{const r=await fetch(endpoint('generate'),{method:'POST',headers});const d=await r.json();if(!r.ok)throw new Error(d.error);await refresh();}catch(e){generationStarted=false;status.textContent=e instanceof Error?e.message:'Connection interrupted. Refresh the order before retrying; do not pay again.';generate.disabled=false;generate.hidden=false;}}
generate.addEventListener('click',runGeneration);
download.addEventListener('click',async()=>{download.disabled=true;try{const r=await fetch(endpoint('download'),{headers});if(!r.ok)throw new Error('Download unavailable. Please refresh.');const url=URL.createObjectURL(await r.blob());const link=document.createElement('a');link.href=url;link.download='SafeWork-draft-work-pack.html';link.click();setTimeout(()=>URL.revokeObjectURL(url),10000);}catch(e){status.textContent=String(e);}finally{download.disabled=false;}});
if(!/^[a-f0-9]{64}$/.test(access))status.textContent='The private access code is missing. Open the full order link you saved before payment.';else refresh();
</script>
<style>body{background:#f1f5ef;color:#183b2c;font-family:system-ui}main{max-width:760px;margin:50px auto;padding:30px;background:white;border:1px solid #ccd9cd;border-radius:8px}h1{font-size:36px}#actions{display:flex;gap:12px;flex-wrap:wrap}button,#checkout{padding:13px 18px;background:#183b2c;color:white;border:0;border-radius:4px;font:inherit;cursor:pointer}button:disabled{opacity:.5}[hidden]{display:none!important}p{line-height:1.65}#status{font-size:20px}strong{overflow-wrap:anywhere}@media(max-width:650px){main{margin:15px;padding:20px}}</style>
