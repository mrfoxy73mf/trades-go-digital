---
import BaseHead from '../../components/BaseHead.astro';
export const prerender = false;
Astro.response.headers.set('Referrer-Policy','no-referrer');
Astro.response.headers.set('Cache-Control','no-store');
---
<html lang="en-GB"><head><BaseHead title="Your work pack | SafeWork AI" description="Return to your private SafeWork order."/><meta name="robots" content="noindex,nofollow"/></head><body><main><a href="/health-and-safety">Trades Go Digital / SafeWork AI</a><h1>Your work pack</h1><p id="status" role="status">Loading your order…</p><div id="actions"><button id="refresh">Refresh status</button><button id="generate" hidden>Generate my paid pack</button><a id="checkout" hidden>Return to payment</a><button id="preview" hidden>View work pack</button><button id="download" hidden>Download work pack</button></div><p id="note"></p><p>Keep this page’s full private link to return to your order. Anyone with the link can access the pack.</p><p>Need help? <a href="mailto:support@trades-go-digital.co.uk">Contact support</a> and quote order <strong id="reference"></strong>. Do not send your private access link.</p><p>AI-generated documents require competent-person review before use. Use <strong>View work pack</strong> to inspect it properly, then download it or choose Print / Save as PDF.</p></main><dialog id="pack-preview"><div class="preview-bar"><strong>Work pack preview</strong><button id="close-preview" type="button">Close preview</button></div><iframe title="Generated SafeWork work pack" sandbox></iframe></dialog></body></html>
<script>
const id=new URL(location.href).searchParams.get('id')||'';const access=location.hash.slice(1);
const status=document.querySelector<HTMLElement>('#status')!;const generate=document.querySelector<HTMLButtonElement>('#generate')!;const preview=document.querySelector<HTMLButtonElement>('#preview')!;const download=document.querySelector<HTMLButtonElement>('#download')!;const checkout=document.querySelector<HTMLAnchorElement>('#checkout')!;const previewDialog=document.querySelector<HTMLDialogElement>('#pack-preview')!;const previewFrame=previewDialog.querySelector('iframe')!;
document.querySelector('#reference')!.textContent=id;
const headers={Authorization:`Bearer ${access}`};const endpoint=(name:string)=>`/api/safework/${name}?id=${encodeURIComponent(id)}`;
let generationStarted=false;
async function refresh(){try{const r=await fetch(endpoint('order'),{headers});const d=await r.json();if(!r.ok)throw new Error(d.error);status.textContent=d.status==='ready'?'Your draft pack is ready to view and download.':d.status==='paid'?'Payment confirmed. Preparing your work pack…':'Payment has not been confirmed. If you cancelled checkout, you can return below.';generate.hidden=d.status!=='paid';generate.disabled=d.working||!d.retryAvailable;preview.hidden=d.status!=='ready';download.hidden=d.status!=='ready';checkout.hidden=!d.checkoutUrl;if(d.checkoutUrl)checkout.href=d.checkoutUrl;document.querySelector('#note')!.textContent=d.working?'Generation is running. Refresh shortly.':!d.retryAvailable&&d.status!=='ready'?'Contact support to complete this order. Do not pay again.':'';if(d.status==='paid'&&!d.working&&d.retryAvailable&&!generationStarted){generationStarted=true;await runGeneration();}}catch(e){status.textContent=e instanceof Error?e.message:'Unable to retrieve order.';}}
document.querySelector('#refresh')!.addEventListener('click',refresh);
async function runGeneration(){generate.disabled=true;status.textContent='Payment confirmed. Preparing your draft pack; this can take a few minutes. Keep this page open.';try{const r=await fetch(endpoint('generate'),{method:'POST',headers});const d=await r.json();if(!r.ok)throw new Error(d.error);await refresh();}catch(e){generationStarted=false;status.textContent=e instanceof Error?e.message:'Connection interrupted. Refresh the order before retrying; do not pay again.';generate.disabled=false;generate.hidden=false;}}
generate.addEventListener('click',runGeneration);
async function fetchPack(){const r=await fetch(endpoint('download'),{headers,cache:'no-store'});if(!r.ok)throw new Error('Work pack unavailable. Please refresh.');return {html:await r.text(),filename:r.headers.get('X-SafeWork-Filename')||`SafeWork-${id.slice(0,8)}.html`};}
preview.addEventListener('click',async()=>{preview.disabled=true;status.textContent='Opening the correct work pack…';try{const pack=await fetchPack();const responsive='<style>@media screen and (max-width:850px){html,body{overflow-x:hidden}.sheet{width:100%!important;min-height:auto!important;margin:8px 0!important;padding:20px!important}.cover-sheet{padding:0!important}.cover-sheet>header,.cover-sheet>footer{margin-left:20px!important;margin-right:20px!important}.cover{min-height:700px!important;padding:50px 28px!important}.two{grid-template-columns:1fr!important}table{font-size:9px!important}}</style>';previewFrame.srcdoc=pack.html.replace('</head>',responsive+'</head>');previewDialog.showModal();status.textContent='Your draft pack is open for inspection.';}catch(e){status.textContent=e instanceof Error?e.message:String(e);}finally{preview.disabled=false;}});
document.querySelector('#close-preview')!.addEventListener('click',()=>previewDialog.close());
download.addEventListener('click',async()=>{download.disabled=true;try{const pack=await fetchPack();const url=URL.createObjectURL(new Blob([pack.html],{type:'text/html;charset=utf-8'}));const link=document.createElement('a');link.href=url;link.download=pack.filename;document.body.append(link);link.click();link.remove();setTimeout(()=>URL.revokeObjectURL(url),10000);status.textContent=`Downloaded ${pack.filename}.`;}catch(e){status.textContent=e instanceof Error?e.message:String(e);}finally{download.disabled=false;}});
if(!/^[a-f0-9]{64}$/.test(access))status.textContent='The private access code is missing. Open the full order link you saved before payment.';else refresh();
</script>
<style>body{background:#f1f5ef;color:#183b2c;font-family:system-ui}main{max-width:760px;margin:50px auto;padding:30px;background:white;border:1px solid #ccd9cd;border-radius:8px}h1{font-size:36px}#actions{display:flex;gap:12px;flex-wrap:wrap}button,#checkout{padding:13px 18px;background:#183b2c;color:white;border:0;border-radius:4px;font:inherit;cursor:pointer}#preview{background:#f97316}button:disabled{opacity:.5}[hidden]{display:none!important}p{line-height:1.65}#status{font-size:20px}strong{overflow-wrap:anywhere}dialog{width:min(1120px,96vw);height:94vh;padding:0;border:0;border-radius:8px;box-shadow:0 24px 80px #0008}dialog::backdrop{background:#07111fe6}.preview-bar{height:58px;padding:10px 14px;background:#07111f;color:#fff;display:flex;align-items:center;justify-content:space-between}.preview-bar button{padding:9px 14px;background:#f97316}.preview-bar+iframe{display:block;width:100%;height:calc(94vh - 58px);border:0;background:#e8ece9}@media(max-width:650px){main{margin:15px;padding:20px}dialog{width:100vw;height:100vh;max-width:none;max-height:none}.preview-bar+iframe{height:calc(100vh - 58px)}}</style>
