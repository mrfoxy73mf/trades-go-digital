---
import BaseHead from '../../components/BaseHead.astro';
export const prerender = false;
Astro.response.headers.set('Referrer-Policy','no-referrer');
Astro.response.headers.set('Cache-Control','no-store');
---
<html lang="en-GB"><head><BaseHead title="Your work pack | SafeWork AI" description="Return to your private SafeWork order."/><meta name="robots" content="noindex,nofollow"/></head><body><main><a href="/health-and-safety">Trades Go Digital / SafeWork AI</a><h1>Your work pack</h1><p id="status" role="status">Loading your order…</p><div id="actions"><button id="refresh">Refresh status</button><button id="generate" hidden>Generate my paid pack</button><a id="checkout" hidden>Return to payment</a><button id="preview" hidden>View work pack</button><button id="download" hidden>Print / Save as PDF</button></div><section id="signoff" hidden><p class="eyebrow">DIGITAL APPROVAL</p><h2>Approve and brief your team</h2><p>Review and amend the pack for the actual site before signing. Once submitted, this record is locked and added to future downloads.</p><form id="signoff-form"><label>Approving supervisor’s name<input name="supervisorName" required maxlength="150"></label><label>Role<input name="supervisorRole" required maxlength="150" placeholder="For example: chargehand or site supervisor"></label><div id="worker-names"></div><label class="check"><input type="checkbox" name="approved" required>I have reviewed and approved the pack for this job.</label><label class="check"><input type="checkbox" name="workersConfirmed" required>The named workers have been briefed and acknowledged the pack.</label><button type="submit">Lock digital sign-off</button></form><p id="signoff-status" role="status"></p></section><p id="note"></p><p>Keep this page’s full private link to return to your order. Anyone with the link can access the pack.</p><p>Need help? <a href="mailto:support@trades-go-digital.co.uk">Contact support</a> and quote order <strong id="reference"></strong>. Do not send your private access link.</p><p>AI-generated documents require competent-person review before use. Open the rendered work pack, then use <strong>Print / Save as PDF</strong>. Customers never need to open an HTML source file.</p></main><dialog id="pack-preview"><div class="preview-bar"><strong>Work pack preview</strong><div><button id="print-pack" type="button">Print / Save as PDF</button><button id="close-preview" type="button">Close preview</button></div></div><iframe title="Generated SafeWork work pack" sandbox="allow-modals allow-same-origin"></iframe></dialog></body></html>
<script>
const id=new URL(location.href).searchParams.get('id')||'';const access=location.hash.slice(1);
const status=document.querySelector<HTMLElement>('#status')!;const generate=document.querySelector<HTMLButtonElement>('#generate')!;const preview=document.querySelector<HTMLButtonElement>('#preview')!;const download=document.querySelector<HTMLButtonElement>('#download')!;const checkout=document.querySelector<HTMLAnchorElement>('#checkout')!;const previewDialog=document.querySelector<HTMLDialogElement>('#pack-preview')!;const previewFrame=previewDialog.querySelector('iframe')!;
document.querySelector('#reference')!.textContent=id;
const headers={Authorization:`Bearer ${access}`};const endpoint=(name:string)=>`/api/safework/${name}?id=${encodeURIComponent(id)}`;
let generationStarted=false;
async function loadSignoff(){const section=document.querySelector<HTMLElement>('#signoff')!;const r=await fetch(endpoint('signoff'),{headers});if(!r.ok)return;const d=await r.json();section.hidden=false;const form=document.querySelector<HTMLFormElement>('#signoff-form')!;const message=document.querySelector<HTMLElement>('#signoff-status')!;if(d.signed){form.hidden=true;message.textContent=`Digitally approved by ${d.approval.supervisorName}. Future downloads include the locked audit sheet.`;return;}const workers=document.querySelector<HTMLElement>('#worker-names')!;if(!workers.children.length)for(let n=1;n<=d.workerCount;n++){const label=document.createElement('label');label.textContent=`Worker ${n} name`;const input=document.createElement('input');input.name='workerName';input.required=true;input.maxLength=150;label.append(input);workers.append(label);}}
async function refresh(){try{const r=await fetch(endpoint('order'),{headers});const d=await r.json();if(!r.ok)throw new Error(d.error);status.textContent=d.status==='ready'?'Your draft pack is ready to view and download.':d.status==='paid'?'Payment confirmed. Preparing your work pack…':'Payment has not been confirmed. If you cancelled checkout, you can return below.';generate.hidden=d.status!=='paid';generate.disabled=d.working||!d.retryAvailable;preview.hidden=d.status!=='ready';download.hidden=d.status!=='ready';checkout.hidden=!d.checkoutUrl;if(d.checkoutUrl)checkout.href=d.checkoutUrl;document.querySelector('#note')!.textContent=d.working?'Generation is running. Refresh shortly.':!d.retryAvailable&&d.status!=='ready'?'Contact support to complete this order. Do not pay again.':'';if(d.status==='ready')await loadSignoff();if(d.status==='paid'&&!d.working&&d.retryAvailable&&!generationStarted){generationStarted=true;await runGeneration();}}catch(e){status.textContent=e instanceof Error?e.message:'Unable to retrieve order.';}}
document.querySelector('#refresh')!.addEventListener('click',refresh);
async function runGeneration(){generate.disabled=true;status.textContent='Payment confirmed. Preparing your draft pack; this can take a few minutes. Keep this page open.';try{const r=await fetch(endpoint('generate'),{method:'POST',headers});const d=await r.json();if(!r.ok)throw new Error(d.error);await refresh();}catch(e){generationStarted=false;status.textContent=e instanceof Error?e.message:'Connection interrupted. Refresh the order before retrying; do not pay again.';generate.disabled=false;generate.hidden=false;}}
generate.addEventListener('click',runGeneration);
async function fetchPack(){const r=await fetch(endpoint('download'),{headers,cache:'no-store'});if(!r.ok)throw new Error('Work pack unavailable. Please refresh.');return {html:await r.text(),filename:r.headers.get('X-SafeWork-Filename')||`SafeWork-${id.slice(0,8)}.html`};}
preview.addEventListener('click',async()=>{preview.disabled=true;status.textContent='Opening the correct work pack…';try{const pack=await fetchPack();const responsive='<style>@media screen and (max-width:850px){html,body{overflow-x:hidden}.sheet{width:100%!important;min-height:auto!important;margin:8px 0!important;padding:20px!important}.cover-sheet{padding:0!important}.cover-sheet>header,.cover-sheet>footer{margin-left:20px!important;margin-right:20px!important}.cover{min-height:700px!important;padding:50px 28px!important}.two{grid-template-columns:1fr!important}table{font-size:9px!important}}</style>';previewFrame.srcdoc=pack.html.replace('</head>',responsive+'</head>');previewDialog.showModal();status.textContent='Your draft pack is open for inspection.';}catch(e){status.textContent=e instanceof Error?e.message:String(e);}finally{preview.disabled=false;}});
document.querySelector('#close-preview')!.addEventListener('click',()=>previewDialog.close());
document.querySelector<HTMLFormElement>('#signoff-form')!.addEventListener('submit',async(e)=>{e.preventDefault();const form=e.currentTarget;const data=new FormData(form);const message=document.querySelector<HTMLElement>('#signoff-status')!;if(!confirm('Lock this approval and workforce acknowledgement? It cannot be edited afterwards.'))return;const r=await fetch(endpoint('signoff'),{method:'POST',headers:{...headers,'Content-Type':'application/json'},body:JSON.stringify({supervisorName:data.get('supervisorName'),supervisorRole:data.get('supervisorRole'),workers:data.getAll('workerName'),approved:data.has('approved'),workersConfirmed:data.has('workersConfirmed')})});const d=await r.json();message.textContent=r.ok?'Digital sign-off locked. Download the pack again to include its audit sheet.':d.error;if(r.ok)await loadSignoff();});
download.addEventListener('click',async()=>{download.disabled=true;status.textContent='Preparing the rendered A4 pack…';try{const pack=await fetchPack();previewFrame.srcdoc=pack.html;previewDialog.showModal();previewFrame.addEventListener('load',()=>previewFrame.contentWindow?.print(),{once:true});status.textContent='Choose “Save as PDF” in the print window to save the finished document.';}catch(e){status.textContent=e instanceof Error?e.message:String(e);}finally{download.disabled=false;}});
document.querySelector('#print-pack')!.addEventListener('click',()=>previewFrame.contentWindow?.print());
if(!/^[a-f0-9]{64}$/.test(access))status.textContent='The private access code is missing. Open the full order link you saved before payment.';else refresh();
</script>
<style>body{background:#f1f5ef;color:#183b2c;font-family:system-ui}main{max-width:760px;margin:50px auto;padding:30px;background:white;border:1px solid #ccd9cd;border-radius:8px}h1{font-size:36px}#actions{display:flex;gap:12px;flex-wrap:wrap}button,#checkout{padding:13px 18px;background:#183b2c;color:white;border:0;border-radius:4px;font:inherit;cursor:pointer}#preview{background:#f97316}button:disabled{opacity:.5}[hidden]{display:none!important}p{line-height:1.65}#status{font-size:20px}strong{overflow-wrap:anywhere}#signoff{margin:28px 0;padding:24px;border:2px solid #f97316;border-radius:8px;background:#fffaf5}.eyebrow{font-size:12px;font-weight:800;letter-spacing:.12em;color:#a43d00}label{display:block;font-weight:700;margin:14px 0}input[type=text],input:not([type]){display:block;width:100%;margin-top:6px;padding:12px;border:1px solid #9fb0a7;border-radius:4px;font:inherit}.check{display:flex;gap:9px;align-items:flex-start;font-weight:500}.check input{margin-top:5px}dialog{width:min(1120px,96vw);height:94vh;padding:0;border:0;border-radius:8px;box-shadow:0 24px 80px #0008}dialog::backdrop{background:#07111fe6}.preview-bar{min-height:58px;padding:10px 14px;background:#07111f;color:#fff;display:flex;align-items:center;justify-content:space-between;gap:12px}.preview-bar>div{display:flex;gap:8px}.preview-bar button{padding:9px 14px;background:#f97316}.preview-bar+iframe{display:block;width:100%;height:calc(94vh - 58px);border:0;background:#e8ece9}@media(max-width:650px){main{margin:15px;padding:20px}dialog{width:100vw;height:100vh;max-width:none;max-height:none}.preview-bar{align-items:flex-start}.preview-bar>div{flex-wrap:wrap;justify-content:flex-end}.preview-bar+iframe{height:calc(100vh - 76px)}}</style>
