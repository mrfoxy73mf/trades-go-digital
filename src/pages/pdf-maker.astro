---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en-GB">
<head>
	<BaseHead title="PDF Maker | Trades Go Digital" description="A structured Word-style PDF maker for trade quotes and invoices." />
</head>
<body class="tgd-pdf-office">
	<Header />
	<main class="pdf-studio">
		<header class="studio-top no-print">
			<a class="studio-brand" href="/"><img src="/images/trades-go-digital-icon-stripe.png" alt="" /><span><strong>Trades Go Digital</strong><small>PDF Maker</small></span></a>
		<div class="studio-actions"><span id="status">Checking payment availability…</span><button id="save" type="button">Save</button><button id="download" type="button" disabled>Download PDF</button></div>
		</header>

		<div class="studio-grid">
			<aside class="builder no-print">
				<section class="builder-intro">
					<p>Option 4</p>
					<h1>Word-style PDF builder.</h1>
					<span>Structured fields on the left. Finished A4 document on the right.</span>
					<a class="maker-price" href="/pricing#tools">View pricing</a>
				</section>

				<section class="panel open">
					<h2><button class="drawer-toggle" type="button">Document <span>Template</span></button></h2>
					<div class="choice-grid" id="doc-types"></div>
				</section>

				<section class="panel two">
					<h2><button class="drawer-toggle" type="button">Business <span>Company details</span></button></h2>
					<label class="wide logo-row">Logo <span><figure id="logo-preview">TGD</figure><em><label class="upload">Choose logo<input id="logo" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml" /></label><button id="import-logo" type="button">Import from Logo Maker</button><button id="remove-logo" type="button">Remove</button></em></span></label>
					<label>Business name<input id="business" /></label>
					<label>Email<input id="email" /></label>
					<label>Phone<input id="phone" /></label>
					<label>VAT number<input id="vatNumber" /></label>
					<label class="logo-size-control">Logo width <span><input id="logoWidth" type="range" min="36" max="220" step="2" /><output id="logoWidthValue">98px</output></span></label>
					<label class="logo-size-control">Logo height <span><input id="logoHeight" type="range" min="36" max="140" step="2" /><output id="logoHeightValue">98px</output></span></label>
					<label>Logo shape<select id="logoShape"><option value="rounded">Rounded</option><option value="square">Square</option><option value="circle">Circle</option><option value="none">No box</option></select></label>
					<label class="wide">Address<textarea id="businessAddress" rows="3"></textarea></label>
				</section>

				<section class="panel two" id="customer-panel">
					<h2><button class="drawer-toggle" type="button">Customer <span>Job details</span></button></h2>
					<label><span id="customer-label">Customer</span><input id="customer" /></label>
					<label><span id="reference-label">Reference</span><input id="reference" /></label>
					<label><span id="date-label">Date</span><input id="date" /></label>
					<label><span id="due-label">Due / valid until</span><input id="due" /></label>
					<label class="receipt-only" id="payment-method-field">Payment method<input id="paymentMethod" placeholder="Bank transfer, card or cash" /></label>
					<label class="wide receipt-only" id="payment-reference-field">Payment / transaction reference<input id="paymentReference" placeholder="Transaction or original invoice reference" /></label>
					<label class="signoff-only" id="job-status-field">Completion status<select id="jobStatus"><option>Completed</option><option>Completed with snagging</option><option>Partially completed</option><option>Return visit required</option></select></label>
					<label class="wide"><span id="site-label">Site address</span><textarea id="siteAddress" rows="3"></textarea></label>
					<label class="wide"><span id="scope-label">Scope of work</span><textarea id="scope" rows="4"></textarea></label>
					<label class="wide signoff-only" id="handover-field">Handover details<textarea id="handover" rows="3"></textarea></label>
					<label class="wide signoff-only" id="snagging-field">Snagging / outstanding work<textarea id="snagging" rows="3"></textarea></label>
				</section>

				<section class="panel two rams-only" id="rams-panel" hidden>
					<h2><button class="drawer-toggle" type="button">RAMS details <span>Four-page safety pack</span></button></h2>
					<label>Prepared by<input id="ramsPreparedBy" /></label>
					<label>Approved by<input id="ramsApprovedBy" /></label>
					<label>Assessment date<input id="ramsAssessmentDate" /></label>
					<label>Review date<input id="ramsReviewDate" /></label>
					<label class="wide">People who may be affected<textarea id="ramsPeople" rows="3"></textarea></label>
					<label class="wide">Significant hazards<textarea id="ramsHazards" rows="6"></textarea></label>
					<label class="wide">Control measures<textarea id="ramsControls" rows="7"></textarea></label>
					<label class="wide">Sequence / method of work<textarea id="ramsMethod" rows="9"></textarea></label>
					<label class="wide">Plant, tools and equipment<textarea id="ramsEquipment" rows="4"></textarea></label>
					<label class="wide">PPE and RPE<textarea id="ramsPpe" rows="4"></textarea></label>
					<label class="wide">Training, competence and supervision<textarea id="ramsCompetence" rows="4"></textarea></label>
					<label class="wide">Access, segregation and welfare<textarea id="ramsAccess" rows="4"></textarea></label>
					<label class="wide">COSHH / hazardous substances<textarea id="ramsCoshh" rows="5"></textarea></label>
					<label class="wide">Emergency, fire and first-aid arrangements<textarea id="ramsEmergency" rows="5"></textarea></label>
					<label class="wide">Environmental and waste controls<textarea id="ramsEnvironment" rows="4"></textarea></label>
					<label class="wide">Monitoring, change and review<textarea id="ramsMonitoring" rows="4"></textarea></label>
					<label class="wide">Briefing and acknowledgement notes<textarea id="ramsBriefing" rows="4"></textarea></label>
				</section>

				<section class="panel two permit-only" id="permit-panel" hidden>
					<h2><button class="drawer-toggle" type="button">Permit details <span>Type, controls and authority</span></button></h2>
					<label class="wide">Permit type<select id="permitType"></select></label>
					<p class="wide permit-guidance" id="permit-guidance"></p>
					<div class="wide excavation-tools" id="excavation-tools" hidden>
						<h3>CAT & Genny service-location equipment</h3>
						<label class="wide">Underground service plans / drawing reference<input id="servicePlanReference" /></label>
						<label>CAT make and model<input id="catMakeModel" /></label>
						<label>CAT serial number<input id="catSerial" /></label>
						<label>CAT calibration / service date<input id="catCalibrationDate" /></label>
						<label>CAT next calibration due<input id="catCalibrationDue" /></label>
						<label>Genny make and model<input id="gennyMakeModel" /></label>
						<label>Genny serial number<input id="gennySerial" /></label>
						<label>Genny calibration / service date<input id="gennyCalibrationDate" /></label>
						<label>Genny next calibration due<input id="gennyCalibrationDue" /></label>
						<label>Locator operator<input id="locatorOperator" /></label>
						<label>Scan date and time<input id="locatorScanDate" /></label>
						<label class="wide">Scan modes, findings and marked service routes<textarea id="locatorFindings" rows="4"></textarea></label>
					</div>
					<label>Issuer / authorising person<input id="permitIssuer" /></label>
					<label>Person in charge of work<input id="permitReceiver" /></label>
					<label>Valid from<input id="permitValidFrom" /></label>
					<label>Valid until<input id="permitValidUntil" /></label>
					<label class="wide">Exact work location / equipment<textarea id="permitLocation" rows="3"></textarea></label>
					<label class="wide">Hazards and interactions<textarea id="permitHazards" rows="5"></textarea></label>
					<label class="wide">Required precautions and controls<textarea id="permitPrecautions" rows="7"></textarea></label>
					<label class="wide">Isolations, lock-off and stored energy<textarea id="permitIsolations" rows="5"></textarea></label>
					<label class="wide">Tests, inspections and atmosphere readings<textarea id="permitTests" rows="5"></textarea></label>
					<label class="wide">PPE, competence and supervision<textarea id="permitPpe" rows="4"></textarea></label>
					<label class="wide">Linked RAMS, permits and certificates<textarea id="permitLinks" rows="4"></textarea></label>
					<label class="wide">Emergency and rescue arrangements<textarea id="permitEmergency" rows="5"></textarea></label>
					<label class="wide">Shift handover / extension requirements<textarea id="permitHandover" rows="4"></textarea></label>
					<label class="wide">Completion, reinstatement and close-out checks<textarea id="permitCloseout" rows="5"></textarea></label>
				</section>

				<section class="panel" id="items-panel">
					<h2><button class="drawer-toggle" type="button"><strong id="items-title">Line Items</strong> <span id="items-subtitle">Rows and totals</span></button></h2>
					<div class="items" id="items"></div>
					<button class="add" id="add-item" type="button">+ Add item</button>
					<div class="two mini" id="totals-controls">
						<label>VAT %<input id="vatRate" type="number" step="1" /></label>
						<label id="deposit-field"><span id="deposit-label">Deposit paid</span><input id="deposit" type="number" step="0.01" /></label>
					</div>
				</section>

				<section class="panel two" id="content-panel">
					<h2><button class="drawer-toggle" type="button">Content <span>Notes and signatures</span></button></h2>
					<label class="wide"><span id="terms-label">Terms</span><textarea id="terms" rows="4"></textarea></label>
					<label class="wide"><span id="notes-label">Notes</span><textarea id="notes" rows="3"></textarea></label>
					<label class="wide invoice-only" id="payment-details-field">Payment details<textarea id="paymentDetails" rows="3" placeholder="Bank name, sort code, account number and payment reference"></textarea></label>
					<label class="wide check-row"><input id="signatures" type="checkbox" /> Show signature boxes</label>
				</section>

				<section class="panel two">
					<h2><button class="drawer-toggle" type="button">Design <span>Change the PDF</span></button></h2>
					<label>Design<select id="design"><option value="letterhead">Premium letterhead</option><option value="trade">Bold trade</option><option value="accounts">Accounts office</option><option value="minimal">Clean minimal</option><option value="executive">Executive slate</option><option value="site">Site pack</option></select></label>
					<label>Font<select id="font"><option value="inter">Modern sans</option><option value="serif">Formal serif</option><option value="mono">Technical mono</option></select></label>
					<label>Spacing<select id="density"><option value="comfortable">Comfortable</option><option value="compact">Compact</option><option value="spacious">Spacious</option></select></label>
					<label>Header<select id="headerStyle"><option value="standard">Standard</option><option value="banner">Full banner</option><option value="boxed">Boxed details</option></select></label>
					<label>Accent<input id="accent" type="color" /></label>
					<label class="wide">Watermark<input id="watermark" placeholder="Optional watermark, e.g. DRAFT" /></label>
				</section>
			</aside>

			<section class="preview">
				<div class="preview-head no-print">
					<span>Live A4 preview</span>
					<label class="zoom-control">Zoom
						<input id="previewZoom" type="range" min="0.45" max="1.3" step="0.01" />
						<output id="previewZoomValue">80%</output>
					</label>
					<strong id="preview-total">£0.00</strong>
				</div>
				<div class="sheet-stage" id="sheet-stage">
					<article class="sheet" id="sheet"></article>
				</div>
			</section>
		</div>
	</main>

	<script>
		const docs = {
			quote: { label: "Quote", title: "Quotation", ref: "Q-001", due: "Valid for 30 days", terms: "This quotation is valid for 30 days. Price assumes clear access, normal working hours and no hidden defects unless stated.", notes: "Customer acceptance confirms the scope, price and proposed dates are agreed." },
			invoice: { label: "Invoice", title: "Invoice", ref: "INV-001", due: "Due within 14 days", terms: "Payment is due within 14 days. Please use the invoice reference when paying by bank transfer.", notes: "Thank you for your business." },
			receipt: { label: "Receipt", title: "Payment Receipt", ref: "REC-001", due: "Paid in full", terms: "This receipt confirms payment has been received for the work or invoice stated.", notes: "Keep this receipt for your records." },
			signoff: { label: "Sign-off", title: "Job Sign-off", ref: "JOB-001", due: "Customer approval", terms: "Customer sign-off confirms that the listed works have been completed and handed over.", notes: "Any snagging items should be listed before final approval." },
			rams: { label: "RAMS", title: "RAMS Pack", ref: "RAMS-001", due: "Site safety pack", terms: "All operatives must read the risk assessments and method statement before starting work.", notes: "Emergency access, PPE and site-specific hazards must be confirmed on arrival." },
			permit: { label: "Permit", title: "Permit to Work", ref: "PTW-001", due: "Controlled work", terms: "This permit must be authorised before controlled work starts and closed once work is complete.", notes: "Supervisor to confirm isolation, controls and final checks." }
		};
		const permitTypes = {
			general: {label:"General / cold work", guidance:"Controlled maintenance or non-routine work not covered by a more specific permit.", checks:["Work area identified and secured","Task risk assessment and method agreed","Adjacent activities checked for conflict"]},
			hot: {label:"Hot work", guidance:"Welding, flame cutting, grinding, brazing or any activity capable of producing heat, sparks or flame.", checks:["Combustibles removed or protected","Fire watch and extinguishers provided","Area checked during and after work","Gas testing completed where required"]},
			confined: {label:"Confined-space entry", guidance:"Entry into a substantially enclosed place where specified risks may arise.", checks:["Entry avoided unless necessary","Atmosphere tested and monitored","Ventilation and communications provided","Rescue plan, equipment and team ready"]},
			electrical: {label:"Electrical work / isolation", guidance:"Work on or near electrical systems, including proving dead and controlled re-energisation.", checks:["Correct circuit/equipment identified","Supply isolated, locked and tagged","Stored energy discharged","Proved dead with suitable test equipment"]},
			mechanical: {label:"Mechanical isolation / machinery", guidance:"Maintenance requiring plant shutdown, prevention of movement or release of stored energy.", checks:["All energy sources identified","Plant stopped, isolated and locked","Stored pressure/energy released","Moving parts blocked or restrained"]},
			containment: {label:"Breaking containment / line break", guidance:"Opening pipework, vessels or equipment that contains or has contained hazardous or pressurised material.", checks:["Contents and pressure confirmed","Drained, vented, purged and isolated","Spill/exposure controls ready","Correct PPE/RPE and disposal route provided"]},
			excavation: {label:"Excavation / ground disturbance", guidance:"Digging, drilling, boring, piling or disturbing ground where services or instability may present risk.", checks:["Service plans reviewed and area scanned","Services marked and trial holes agreed","Excavation support/access arranged","Spoil, plant and edge protection controlled"]},
			height: {label:"Work at height", guidance:"Work where a person could fall and be injured, including temporary access equipment.", checks:["Work at height avoided where practicable","Safe access and edge protection provided","Equipment inspected and suitable","Rescue plan agreed where fall arrest is used"]},
			roof: {label:"Roof access / fragile roof", guidance:"Access to roofs, including work near edges, openings or fragile surfaces.", checks:["Fragile surfaces identified and protected","Safe access and edge protection installed","Weather and roof condition checked","Materials and falling objects controlled"]},
			lifting: {label:"Lifting operation / crane", guidance:"Planned lifting using cranes, hoists or other lifting equipment.", checks:["Lift plan and competent roles confirmed","Equipment/accessories inspected and suitable","Ground conditions and exclusion zone checked","Load weight, radius and landing area confirmed"]},
			demolition: {label:"Demolition / structural alteration", guidance:"Demolition, dismantling or work that may affect structural stability.", checks:["Engineering information and sequence agreed","Services isolated","Exclusion and debris controls installed","Temporary works and stability checks confirmed"]},
			asbestos: {label:"Asbestos-controlled work", guidance:"Work involving known or suspected asbestos. This permit does not replace licensing, notification or specialist controls where required.", checks:["Current asbestos information reviewed","Material and work category confirmed","Competent contractor and plan of work verified","Air/clearance arrangements confirmed where required"]},
			chemical: {label:"Hazardous substances / chemical work", guidance:"Use, transfer, cleaning or disturbance of substances hazardous to health.", checks:["COSHH assessment and SDS available","Exposure routes and limits considered","Containment/ventilation controls provided","Spill response and waste route agreed"]},
			pressure: {label:"Pressure systems", guidance:"Work on boilers, compressed-air, steam, hydraulic or other pressurised systems.", checks:["System positively identified and isolated","Pressure safely released and verified","Temperature and stored energy controlled","Reinstatement test and examination agreed"]},
			radiation: {label:"Radiation / radiography", guidance:"Work involving ionising radiation sources or industrial radiography.", checks:["Authorised radiation personnel appointed","Controlled area and barriers established","Source, monitoring and contingency checks complete","Other workers notified and access controlled"]},
			fire: {label:"Fire-system impairment", guidance:"Isolation or impairment of alarms, detection, sprinklers or other fire precautions.", checks:["Affected area and duration recorded","Fire authority/site management notified","Temporary detection/fire watch arranged","System reinstatement and test planned"]},
			water: {label:"Work over or near water", guidance:"Work presenting a foreseeable risk of falling into water or requiring water rescue.", checks:["Edge/fall controls and safe access provided","Buoyancy equipment suitable","Rescue equipment and competent cover ready","Weather, flow and tide conditions checked"]},
			restricted: {label:"Restricted-area / plant-room access", guidance:"Controlled access to operational, secure or higher-risk areas.", checks:["Access authority and boundaries confirmed","Area hazards and prohibited actions briefed","Entry/exit and communication method agreed","Occupancy recorded"]},
			energisation: {label:"Energisation / commissioning", guidance:"Controlled introduction of electrical, mechanical, pressure or process energy for testing or service.", checks:["Commissioning plan and boundaries agreed","People, tools and temporary connections cleared","Warnings, barriers and communications active","Abort and emergency arrangements confirmed"]},
			heavy: {label:"Heavy-equipment movement", guidance:"Movement or positioning of heavy plant where services, structures or people may be affected.", checks:["Route, clearances and ground bearing checked","Banksman and communication agreed","Underground/overhead services protected","Exclusion zone established"]},
			other: {label:"Other / site-specific permit", guidance:"Use for a controlled activity defined by the client or site permit system.", checks:["Permit scope and boundaries clearly defined","Site-specific hazards and controls recorded","Authorised roles and interfaces agreed","Close-out and handback process confirmed"]}
		};
		const fresh = () => ({ doc:"quote", design:"letterhead", font:"inter", density:"comfortable", headerStyle:"standard", previewZoom:0.8, logoSize:"large", logoWidth:98, logoHeight:98, logoShape:"rounded", accent:"#f97316", watermark:"", signatures:true, logo:"", business:"Your Business", email:"hello@yourbusiness.co.uk", phone:"01234 567890", vatNumber:"VAT 000 0000 00", businessAddress:"Business address\nTown / City\nPostcode", customer:"Customer name", reference:"Q-001", date:new Intl.DateTimeFormat("en-GB").format(new Date()), due:"Valid for 30 days", siteAddress:"Site address\nTown / City\nPostcode", scope:"Supply labour, materials and plant to complete the works described in this document.", items:[{desc:"Labour",qty:2,unit:"days",price:280},{desc:"Materials",qty:1,unit:"sum",price:325},{desc:"Waste removal",qty:1,unit:"sum",price:85}], vatRate:20, deposit:0, terms:docs.quote.terms, notes:docs.quote.notes, paymentDetails:"Bank: Your Bank\nSort code: 00-00-00\nAccount: 00000000", paymentMethod:"Bank transfer", paymentReference:"INV-001", jobStatus:"Completed", handover:"Operating instructions, keys and relevant documents have been handed to the customer.", snagging:"No outstanding defects or snagging items at the time of handover.", ramsPreparedBy:"Name / role", ramsApprovedBy:"Name / role", ramsAssessmentDate:new Intl.DateTimeFormat("en-GB").format(new Date()), ramsReviewDate:"Before work starts and whenever conditions change", ramsPeople:"Operatives, other contractors, client staff, visitors and members of the public who may be affected.", ramsHazards:"List each significant, site-specific hazard.\n\nExamples to consider where relevant: work at height; electricity; plant and vehicles; manual handling; dust and fumes; noise and vibration; hot work; slips and trips; confined spaces; asbestos; members of the public.", ramsControls:"For each hazard, state the precautions required to eliminate the risk or reduce it so far as reasonably practicable. Include who is responsible and any action required before work begins.", ramsMethod:"1. Confirm authorisation, drawings, permits and site conditions.\n2. Brief the team and establish the work area.\n3. Isolate services and install access or protection measures.\n4. Carry out the work in the planned safe sequence.\n5. Inspect, test and make good.\n6. Remove waste, leave the area safe and hand over.", ramsEquipment:"List plant, access equipment, tools, inspection requirements and pre-use checks.", ramsPpe:"List task-specific PPE/RPE after higher-order controls have been considered. Include standards, face-fit requirements and replacement arrangements where relevant.", ramsCompetence:"State required skills, training, authorisations, supervision and any specialist competence.", ramsAccess:"Describe access, exclusion zones, pedestrian/vehicle separation, housekeeping, welfare and protection of others.", ramsCoshh:"List hazardous substances and process-generated dusts/fumes. Reference current safety data and COSHH assessments, exposure routes and control measures.", ramsEmergency:"Give emergency contacts, site address/access, alarm and evacuation arrangements, first aider/first-aid kit, fire controls, rescue arrangements and spill response as relevant.", ramsEnvironment:"Describe waste segregation/disposal, spill prevention, dust/noise controls and protection of drains, ground and neighbouring property.", ramsMonitoring:"Name the supervisor. Explain inspections, stop-work authority, how changes will be assessed, and when this RAMS must be reviewed and re-briefed.", ramsBriefing:"Everyone carrying out the work must be briefed on this RAMS, understand the controls, and raise any change or concern before continuing.", permitType:"general", permitIssuer:"Name / authorised role", permitReceiver:"Name / person in charge", permitValidFrom:"Date and time", permitValidUntil:"Date and time", permitLocation:"Identify the exact area, plant, equipment, circuit, line or boundary covered by this permit.", permitHazards:"Record task-specific hazards, stored energy, nearby operations and anyone who may be affected.", permitPrecautions:"State every precaution that must be in place and verified before work starts, maintained during the work, and checked before handback.", permitIsolations:"List electrical, mechanical, hydraulic, pneumatic, pressure, chemical or process isolations. Record lock/tag numbers and who controls the keys.", permitTests:"Record required inspections, proving dead, gas/atmosphere readings, pressure checks or other test results, including time and tester.", permitPpe:"State task-specific PPE/RPE, competence, authorisations, supervision and communication arrangements.", permitLinks:"List the associated risk assessment, method statement, isolation certificates and any linked or simultaneous permits.", permitEmergency:"State alarm, evacuation, first aid, fire watch, rescue, spill response and emergency contact arrangements relevant to this work.", permitHandover:"State how the permit will be suspended, extended or transferred between shifts and who must revalidate the conditions.", permitCloseout:"Confirm work is complete or suspended; people, tools and temporary earths/connections are removed; guards are replaced; the area is safe; isolations are controlled; and plant is formally handed back.", servicePlanReference:"Utility plans / drawing number and revision", catMakeModel:"Cable avoidance tool make / model", catSerial:"CAT serial number", catCalibrationDate:"Calibration or service date", catCalibrationDue:"Next due date", gennyMakeModel:"Signal generator make / model", gennySerial:"Genny serial number", gennyCalibrationDate:"Calibration or service date", gennyCalibrationDue:"Next due date", locatorOperator:"Trained operator name", locatorScanDate:"Date and time of scan", locatorFindings:"Record modes used, detected services, route markings and any areas of uncertainty. Rescan frequently as excavation progresses." });
		let state = fresh();
		const $ = id => document.getElementById(id);
		const esc = v => String(v ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[c]));
		const money = n => new Intl.NumberFormat("en-GB",{style:"currency",currency:"GBP"}).format(Number(n||0));
		const initials = v => String(v||"TGD").split(/\s+/).map(w=>w[0]).join("").slice(0,3).toUpperCase();
		function totals(){const subtotal=state.items.reduce((a,i)=>a+(Number(i.qty)||0)*(Number(i.price)||0),0);const vat=subtotal*(Number(state.vatRate)||0)/100;const gross=subtotal+vat;return{subtotal,vat,gross,total:gross-(Number(state.deposit)||0)}}
		function setDoc(key){state.doc=key;state.reference=docs[key].ref;state.due=docs[key].due;state.terms=docs[key].terms;state.notes=docs[key].notes;state.vatRate=["signoff","rams","permit"].includes(key)?0:20;if(key==="receipt")state.deposit=0;if(key==="signoff")state.items=[{desc:"Agreed work completed",status:"Complete"},{desc:"Work area left clean and safe",status:"Complete"},{desc:"Customer handover completed",status:"Complete"}];if(key==="rams")state.items=[{desc:"Risk assessments",qty:1,unit:"pack",price:0},{desc:"Method statement",qty:1,unit:"pack",price:0},{desc:"COSHH assessments",qty:1,unit:"pack",price:0}];if(key==="permit")state.items=[{desc:"Permit controls checked",qty:1,unit:"item",price:0},{desc:"Permit authorised",qty:1,unit:"item",price:0}];render()}
		function renderControls(){
			$("doc-types").innerHTML=Object.entries(docs).map(([k,d])=>`<button class="${state.doc===k?"active":""}" data-doc="${k}"><strong>${d.label}</strong><small>${d.title}</small></button>`).join("");
			$("permitType").innerHTML=Object.entries(permitTypes).map(([key,type])=>`<option value="${key}">${esc(type.label)}</option>`).join("");
			["business","email","phone","vatNumber","logoWidth","logoHeight","logoShape","businessAddress","customer","reference","date","due","siteAddress","scope","vatRate","deposit","terms","notes","paymentDetails","paymentMethod","paymentReference","jobStatus","handover","snagging","ramsPreparedBy","ramsApprovedBy","ramsAssessmentDate","ramsReviewDate","ramsPeople","ramsHazards","ramsControls","ramsMethod","ramsEquipment","ramsPpe","ramsCompetence","ramsAccess","ramsCoshh","ramsEmergency","ramsEnvironment","ramsMonitoring","ramsBriefing","permitType","permitIssuer","permitReceiver","permitValidFrom","permitValidUntil","permitLocation","permitHazards","permitPrecautions","permitIsolations","permitTests","permitPpe","permitLinks","permitEmergency","permitHandover","permitCloseout","servicePlanReference","catMakeModel","catSerial","catCalibrationDate","catCalibrationDue","gennyMakeModel","gennySerial","gennyCalibrationDate","gennyCalibrationDue","locatorOperator","locatorScanDate","locatorFindings","design","font","density","headerStyle","accent","watermark","previewZoom"].forEach(k=>$(k).value=state[k]??"");
			$("logoWidthValue").textContent=`${state.logoWidth}px`;$("logoHeightValue").textContent=`${state.logoHeight}px`;
			$("signatures").checked=Boolean(state.signatures);
			$("payment-details-field").hidden=state.doc!=="invoice";
			$("payment-method-field").hidden=state.doc!=="receipt";$("payment-reference-field").hidden=state.doc!=="receipt";$("deposit-field").hidden=state.doc==="receipt";
