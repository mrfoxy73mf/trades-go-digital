---
import BaseHead from "../components/BaseHead.astro";
---

<!doctype html>
<html lang="en-GB">
<head>
	<BaseHead title="PDF Maker | Trades Go Digital" description="Design professional invoices, quotes, wage slips, certificates and job sign-off sheets online." />
</head>
<body>
	<main class="studio" data-paid="false">
		<header class="studio-bar no-print">
			<a class="studio-brand" href="/" aria-label="Trades Go Digital home"><img src="/images/trades-go-digital-icon-stripe.png" alt="" /><span><strong>Trades Go Digital</strong><small>PDF Maker</small></span></a>
			<div class="top-actions"><span id="save-state">Your design is saved locally</span><button id="save">Save design</button><button class="unlock" id="download">Unlock PDF · £4.99</button></div>
		</header>

		<div class="workspace">
			<aside class="editor no-print">
				<div class="editor-title"><div><small>CREATE YOUR DOCUMENT</small><h1>PDF Designer</h1></div><span id="word-count">0 words</span></div>
				<section class="tool-group">
					<div class="tool-heading"><label>Start with a template</label><button id="new-document">Reset</button></div>
					<div class="templates" id="templates"></div>
				</section>
				<section class="tool-group fields">
					<div class="logo-field full"><label>Company logo</label><div><figure id="logo-preview">TG</figure><span><label class="file-button">Choose logo<input id="logo" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml" /></label><button id="remove-logo" hidden>Remove</button><small>PNG, JPG, WebP or SVG · Max 2 MB</small></span></div></div>
					<label>Business name<input id="company" /></label><label>Contact email<input id="email" type="email" /></label>
					<label>Prepared for<input id="client" /></label><label>Date<input id="date" /></label>
					<label class="full">Document title<input id="title" /></label><label class="full">Subtitle<textarea id="subtitle" rows="2"></textarea></label>
				</section>
				<section class="tool-group">
					<div class="tool-heading"><label>Document sections</label><button id="add-section">+ Add</button></div>
					<div class="section-list" id="section-list"></div>
				</section>
				<section class="tool-group section-editor" id="section-editor">
					<div class="tool-heading"><label>Edit selected section</label><span><button id="duplicate" title="Duplicate section">⧉</button><button id="move-up" title="Move up">↑</button><button id="move-down" title="Move down">↓</button><button class="danger" id="remove-section" title="Remove">×</button></span></div>
					<label>Heading<input id="section-heading" /></label><label>Content<textarea id="section-body" rows="9"></textarea></label>
				</section>
				<section class="tool-group">
					<label>Professional design</label><div class="designs" id="designs"></div>
					<div class="style-fields"><label>Font<select id="font"><option value="modern">Modern sans</option><option value="classic">Classic serif</option><option value="clean">Clean geometric</option></select></label><label>Spacing<select id="spacing"><option value="compact">Compact</option><option value="comfortable">Comfortable</option><option value="airy">Airy</option></select></label></div>
					<label>Text size<div class="range"><span>A</span><input id="scale" type="range" min="0.85" max="1.2" step="0.05" /><b>A</b></div></label>
					<label>Brand colour<div class="colours" id="colours"></div></label>
					<label class="toggle"><span><b>Document footer</b><small>Business, email and page number</small></span><input id="footer-toggle" type="checkbox" /></label>
				</section>
				<p class="status" id="status">Choose a template or start with a blank PDF.</p>
			</aside>

			<section class="preview-wrap">
				<div class="preview-bar no-print"><span><i></i> LIVE PREVIEW</span><span>A4 · PORTRAIT</span></div>
				<article class="pdf-page" id="pdf-page">
					<div class="watermark no-print">TRADES-GO-DIGITAL</div>
					<header class="doc-header"><div class="doc-brand"><figure id="doc-logo">TG</figure><strong id="doc-company"></strong></div><div class="doc-meta"><span>PREPARED FOR <b id="doc-client"></b></span><span id="doc-date"></span></div></header>
					<div class="title-block"><span id="doc-type"></span><h2 id="doc-title"></h2><p id="doc-subtitle"></p></div>
					<div class="doc-sections" id="doc-sections"></div>
					<footer class="doc-footer" id="doc-footer"><span id="doc-email"></span><span id="footer-company"></span><span>Page 1</span></footer>
				</article>
				<p class="print-tip no-print">Your clean PDF unlocks after secure checkout.</p>
			</section>
		</div>

		<div class="checkout no-print" id="checkout" hidden><section><button class="close" id="close-checkout">×</button><img src="/images/trades-go-digital-icon-stripe.png" alt="" /><small>YOUR FINISHED DOCUMENT</small><h2>Download without the watermark</h2><p>Unlock your finished, print-ready PDF with your content, colours and logo.</p><ul><li>Watermark-free PDF</li><li>Professional A4 quality</li><li>Your branding included</li><li>Secure Stripe checkout</li></ul><div class="price"><span>One PDF unlock</span><strong>£4.99</strong></div><button class="pay" id="pay">Pay securely and download</button><em>Payments are processed securely by Stripe.</em></section></div>
	</main>

	<script>
		const templateData = {
			blank:{label:'Blank PDF',icon:'+',title:'Untitled document',subtitle:'Add a clear subtitle or short introduction.',client:'Customer name',sections:[['Start writing','Select this section to replace this text, or add another section to build your document.']]},
			invoice:{label:'Invoice',icon:'£',title:'Invoice',subtitle:'Invoice no. INV-001 · Due within 14 days',client:'Customer name',sections:[['Bill to','Customer name\nCustomer address\nTown / City\nPostcode'],['Work and charges','Call-out and inspection                         £85.00\nLabour · 4 hours @ £55.00                   £220.00\nMaterials                                      £146.00\n\nSubtotal                                       £451.00\nVAT @ 20%                                       £90.20\nTOTAL                                           £541.20'],['Payment details','Account name: Your Business Ltd\nSort code: 00-00-00\nAccount number: 00000000\nReference: INV-001'],['Terms','Payment is due within 14 days of the invoice date. Thank you for your business.']]},
			wage:{label:'Wage slip',icon:'▦',title:'Wage slip',subtitle:'Pay period ending 31 August 2026',client:'Employee name',sections:[['Employee details','Employee: Employee name\nEmployee number: 001\nNational Insurance no: AB 12 34 56 C\nTax code: 1257L\nPayment date: 31 August 2026'],['Earnings','Basic pay · 160 hours                       £2,800.00\nOvertime · 8 hours                             £210.00\nBonus                                            £100.00\nGROSS PAY                                     £3,110.00'],['Deductions','Income tax                                      £382.40\nNational Insurance                              £164.18\nPension                                           £93.30\nTOTAL DEDUCTIONS                                £639.88'],['Net pay','NET PAY                                      £2,470.12\nPayment method: Bank transfer\nTaxable pay year to date: £18,660.00']]},
			quote:{label:'Quote',icon:'◇',title:'Quotation',subtitle:'Quote no. Q-001 · Valid for 30 days',client:'Customer name',sections:[['Prepared for','Customer name\nSite address\nTown / City\nPostcode'],['Scope of work','Supply the labour, materials and equipment required to complete the work described below.\n\n- Remove existing fitting and make safe\n- Supply and install replacement\n- Test, commission and leave the work area clean'],['Price breakdown','Labour                                           £440.00\nMaterials                                        £325.00\nWaste removal                                     £45.00\n\nSubtotal                                         £810.00\nVAT @ 20%                                        £162.00\nQUOTED TOTAL                                     £972.00'],['Terms and acceptance','This quotation is valid for 30 days and is subject to site access and final inspection.\n\nCustomer signature: ____________________    Date: __________']]},
			certificate:{label:'Certificate',icon:'✓',title:'Certificate of completion',subtitle:'Certificate no. CERT-001',client:'Customer name',sections:[['Customer and property','Customer: Customer name\nInstallation address: Site address\nDate of work: 9 August 2026\nJob reference: JOB-001'],['Work completed','Describe the installation, service, inspection or repair completed, including the relevant locations and equipment.'],['Inspection and checks','Visual inspection completed                         PASS\nOperational test completed                          PASS\nWork area left safe and tidy                         PASS\nCustomer instructions provided                      YES'],['Declaration','I confirm that the work described above has been completed and checked in accordance with the stated scope. This general completion certificate does not replace any legally required trade-specific certificate.\n\nEngineer name: ____________________\nRegistration no: __________________\nSignature: ________________________    Date: __________']]},
			signoff:{label:'Job sign-off',icon:'☑',title:'Job sign-off sheet',subtitle:'Customer approval for completed work · Any trade',client:'Customer name',sections:[['Job details','Job reference: JOB-001\nCustomer: Customer name\nSite address: Site address\nCompletion date: 9 August 2026\nOperative: Engineer name'],['Work completed','Describe the work completed, materials installed, tests carried out and any changes agreed with the customer.'],['Handover checklist','Work explained to customer                           YES\nControls / operation demonstrated                    YES\nCertificates or documents supplied                   YES\nWork area left clean and tidy                         YES\nOutstanding items recorded                            NONE'],['Customer sign-off','I confirm that the work described has been completed and the relevant handover information has been provided.\n\nCustomer name: ____________________\nCustomer signature: _______________    Date: __________\n\nOperative signature: ______________    Date: __________']]}
		};
		const designData={executive:{label:'Executive',note:'Confident and structured',accent:'#0b1930',font:'modern',spacing:'comfortable'},precision:{label:'Precision',note:'Crisp and technical',accent:'#1976a3',font:'clean',spacing:'compact'},minimal:{label:'Minimal',note:'Quiet and premium',accent:'#9b751b',font:'classic',spacing:'airy'}};
		const colourData=['#0b1930','#1976a3','#0f766e','#9b751b','#7c3aed','#be123c'];
		const fresh=()=>({template:'blank',company:'Your Business',email:'hello@yourbusiness.co.uk',client:'Customer name',date:new Intl.DateTimeFormat('en-GB',{day:'numeric',month:'long',year:'numeric'}).format(new Date()),title:'Untitled document',subtitle:'Add a clear subtitle or short introduction.',sections:templateData.blank.sections.map(([heading,body])=>({id:crypto.randomUUID(),heading,body})),logo:'',design:'executive',accent:'#0b1930',font:'modern',spacing:'comfortable',scale:1,footer:true});
		let state=fresh(); let active=''; let paid=false;
		const $=(id)=>document.getElementById(id); const setStatus=(text)=>{$('status').textContent=text};
		function applyTemplate(key){const t=templateData[key];state={...state,template:key,title:t.title,subtitle:t.subtitle,client:t.client,sections:t.sections.map(([heading,body])=>({id:crypto.randomUUID(),heading,body}))};active=state.sections[0].id;render();setStatus(`${t.label} template applied.`)}
		function applyDesign(key){const d=designData[key];state={...state,design:key,accent:d.accent,font:d.font,spacing:d.spacing};render();setStatus(`${d.label} design applied.`)}
		function bind(id,key,event='input'){ $(id).addEventListener(event,e=>{state[key]=e.target.type==='checkbox'?e.target.checked:e.target.type==='range'?Number(e.target.value):e.target.value;render()}) }
		function save(){localStorage.setItem('tgd-pdf-design',JSON.stringify(state));setStatus('Design saved on this device.');$('save-state').textContent='Saved just now'}
		function render(){
			if(!active||!state.sections.some(s=>s.id===active))active=state.sections[0]?.id;
			const root=document.querySelector('.studio');root.className=`studio design-${state.design} font-${state.font} spacing-${state.spacing} ${paid?'paid':'unpaid'}`;root.style.setProperty('--accent',state.accent);root.style.setProperty('--scale',state.scale);
			for(const [id,key] of [['company','company'],['email','email'],['client','client'],['date','date'],['title','title'],['subtitle','subtitle'],['font','font'],['spacing','spacing'],['scale','scale']]) $(id).value=state[key];$('footer-toggle').checked=state.footer;
			$('templates').innerHTML=Object.entries(templateData).map(([key,t])=>`<button data-template="${key}" class="${state.template===key?'active':''}"><i>${t.icon}</i>${t.label}</button>`).join('');
			$('designs').innerHTML=Object.entries(designData).map(([key,d])=>`<button data-design="${key}" class="${state.design===key?'active':''}"><i><b></b><b></b><b></b></i><span><strong>${d.label}</strong><small>${d.note}</small></span></button>`).join('');
			$('colours').innerHTML=colourData.map(c=>`<button data-colour="${c}" class="${state.accent===c?'active':''}" style="background:${c}" aria-label="Use ${c}"></button>`).join('')+`<input id="custom-colour" type="color" value="${state.accent}" aria-label="Custom brand colour" />`;
			$('section-list').innerHTML=state.sections.map((s,i)=>`<button data-section="${s.id}" class="${s.id===active?'active':''}"><span>${String(i+1).padStart(2,'0')}</span><strong>${escapeHtml(s.heading||'Untitled section')}</strong><i>⋮⋮</i></button>`).join('');
			const selected=state.sections.find(s=>s.id===active);$('section-heading').value=selected?.heading||'';$('section-body').value=selected?.body||'';
			$('doc-company').textContent=state.company;$('doc-client').textContent=state.client;$('doc-date').textContent=state.date;$('doc-type').textContent=templateData[state.template]?.label||'Document';$('doc-title').textContent=state.title;$('doc-subtitle').textContent=state.subtitle;$('doc-email').textContent=state.email;$('footer-company').textContent=state.company;$('doc-footer').hidden=!state.footer;
			const initials=(state.company||'TG').split(/\s+/).map(x=>x[0]).join('').slice(0,2).toUpperCase();for(const id of ['logo-preview','doc-logo']){const node=$(id);node.innerHTML=state.logo?`<img src="${state.logo}" alt="Company logo" />`:initials}
			$('remove-logo').hidden=!state.logo;$('doc-sections').innerHTML=state.sections.map((s,i)=>`<section data-preview-section="${s.id}" class="${s.id===active?'selected':''}"><span>${String(i+1).padStart(2,'0')}</span><div><h3>${escapeHtml(s.heading)}</h3><p>${escapeHtml(s.body)}</p></div></section>`).join('');
			const words=[state.title,state.subtitle,...state.sections.flatMap(s=>[s.heading,s.body])].join(' ').trim().split(/\s+/).filter(Boolean).length;$('word-count').textContent=`${words} words`;
		}
		function escapeHtml(value=''){return String(value).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]))}
		for(const [id,key,event] of [['company','company'],['email','email'],['client','client'],['date','date'],['title','title'],['subtitle','subtitle'],['font','font','change'],['spacing','spacing','change'],['scale','scale'],['footer-toggle','footer','change']])bind(id,key,event);
		$('templates').addEventListener('click',e=>{const b=e.target.closest('[data-template]');if(b)applyTemplate(b.dataset.template)});$('designs').addEventListener('click',e=>{const b=e.target.closest('[data-design]');if(b)applyDesign(b.dataset.design)});$('colours').addEventListener('click',e=>{const b=e.target.closest('[data-colour]');if(b){state.accent=b.dataset.colour;render()}});$('colours').addEventListener('input',e=>{if(e.target.id==='custom-colour'){state.accent=e.target.value;render()}});
		$('section-list').addEventListener('click',e=>{const b=e.target.closest('[data-section]');if(b){active=b.dataset.section;render()}});$('doc-sections').addEventListener('click',e=>{const s=e.target.closest('[data-preview-section]');if(s){active=s.dataset.previewSection;render()}});
		$('section-heading').addEventListener('input',e=>{state.sections.find(s=>s.id===active).heading=e.target.value;render()});$('section-body').addEventListener('input',e=>{state.sections.find(s=>s.id===active).body=e.target.value;render()});
		$('add-section').onclick=()=>{const s={id:crypto.randomUUID(),heading:'New section',body:'Add your content here.'};state.sections.push(s);active=s.id;render()};$('duplicate').onclick=()=>{const i=state.sections.findIndex(s=>s.id===active),copy={...state.sections[i],id:crypto.randomUUID(),heading:`${state.sections[i].heading} copy`};state.sections.splice(i+1,0,copy);active=copy.id;render()};
		function move(by){const i=state.sections.findIndex(s=>s.id===active),n=i+by;if(n<0||n>=state.sections.length)return;[state.sections[i],state.sections[n]]=[state.sections[n],state.sections[i]];render()}$('move-up').onclick=()=>move(-1);$('move-down').onclick=()=>move(1);$('remove-section').onclick=()=>{if(state.sections.length===1)return setStatus('Your PDF needs at least one section.');const i=state.sections.findIndex(s=>s.id===active);state.sections.splice(i,1);active=state.sections[Math.max(0,i-1)].id;render()};
		$('logo').onchange=e=>{const file=e.target.files?.[0];e.target.value='';if(!file)return;if(file.size>2097152)return setStatus('Please choose a logo smaller than 2 MB.');const reader=new FileReader();reader.onload=()=>{state.logo=String(reader.result);render();setStatus(`${file.name} added.`)};reader.readAsDataURL(file)};$('remove-logo').onclick=()=>{state.logo='';render()};$('save').onclick=save;$('new-document').onclick=()=>{if(confirm('Start a new blank PDF? Your current design will be replaced.')){state=fresh();active=state.sections[0].id;render()}};
		$('download').onclick=()=>{if(!paid){$('checkout').hidden=false;return}window.print()};$('close-checkout').onclick=()=>{$('checkout').hidden=true};$('pay').onclick=async()=>{save();setStatus('Opening secure checkout...');const response=await fetch('/api/pdf-payment/checkout',{method:'POST'});const result=await response.json().catch(()=>({}));if(!response.ok||!result.url){$('checkout').hidden=true;return setStatus(result.error||'Checkout is not available yet.')}location.assign(result.url)};
		try{const saved=JSON.parse(localStorage.getItem('tgd-pdf-design'));if(saved?.sections?.length)state=saved}catch{} active=state.sections[0]?.id;render();
		const sessionId=new URLSearchParams(location.search).get('session_id');if(sessionId){fetch(`/api/pdf-payment/verify?session_id=${encodeURIComponent(sessionId)}`).then(r=>r.json()).then(result=>{if(result.paid){paid=true;history.replaceState({},'',location.pathname);$('download').textContent='Download PDF';document.querySelector('.watermark').hidden=true;render();setStatus('Payment confirmed. Your clean PDF is ready.')}else throw new Error(result.error||'Payment is not complete.')}).catch(e=>setStatus(e.message))}
	</script>
</body>
</html>

<style is:global>
	body{background:#edf1f5;color:#0b1930}.studio{--accent:#0b1930;--scale:1;min-height:100vh}.studio-bar{height:72px;background:#07111f;color:#fff;display:flex;align-items:center;justify-content:space-between;padding:0 26px;position:sticky;top:0;z-index:20}.studio-brand{display:flex;align-items:center;gap:11px;text-decoration:none}.studio-brand img{width:39px;height:39px;border-radius:9px;background:#fff}.studio-brand span{display:grid;line-height:1.15}.studio-brand strong{font-size:15px}.studio-brand small{color:#69d5ff;font-size:10px;text-transform:uppercase;letter-spacing:.12em}.top-actions{display:flex;align-items:center;gap:9px}.top-actions>span{color:#aebed0;font-size:11px;margin-right:5px}.top-actions button{border:1px solid #31435b;background:#12233a;color:#fff;border-radius:8px;padding:9px 13px;font-weight:900}.top-actions .unlock{background:linear-gradient(135deg,#f0c85a,#d6a935);border:0;color:#07111f}.workspace{display:grid;grid-template-columns:420px minmax(630px,1fr)}.editor{background:#fff;border-right:1px solid #dbe1e8;padding:25px;display:flex;flex-direction:column;gap:23px;max-height:calc(100vh - 72px);overflow:auto;position:sticky;top:72px}.editor-title{display:flex;justify-content:space-between;align-items:end}.editor-title small,.tool-group>label,.tool-heading>label{color:#1976a3;font-size:9px;font-weight:950;letter-spacing:.12em;text-transform:uppercase}.editor-title h1{font-size:26px;letter-spacing:-.04em;margin:2px 0}.editor-title>span{background:#f2f4f6;color:#7a8492;border-radius:99px;padding:5px 8px;font-size:9px}.tool-group{border-top:1px solid #e7eaee;padding-top:18px;display:grid;gap:10px}.tool-heading{display:flex;justify-content:space-between;align-items:center}.tool-heading button{border:0;background:transparent;color:#1976a3;font-weight:900}.templates{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}.templates button{min-height:72px;border:1px solid #dfe4e9;background:#f8fafb;color:#5c6777;border-radius:9px;font-size:9px;font-