			$("layouts").innerHTML=Object.entries(layouts).map(([k,v])=>`<button class="${state.layout===k?"active":""}" data-layout="${k}"><strong>${v}</strong><small>${k}</small></button>`).join("");
			$("shapes").innerHTML=Object.entries(shapes).map(([k,v])=>`<button class="${state.shape===k?"active":""}" data-shape="${k}" title="${v.label}"><svg viewBox="0 0 100 100" aria-hidden="true"><path d="${v.d}"/></svg><span>${v.label}</span></button>`).join("");
			$("mockups").innerHTML=Object.entries(mockups).map(([k,v])=>`<button class="${state.mockup===k?"active":""}" data-mockup="${k}">${v}</button>`).join("");
			$("logo-preview").innerHTML=logoSvg();
