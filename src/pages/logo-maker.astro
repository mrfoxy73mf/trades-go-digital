		const fileName=extension=>`${String(state.name||"trade-logo").trim().replace(/[^a-z0-9]+/gi,"-").replace(/^-|-$/g,"").toLowerCase()||"trade-logo"}.${extension}`;
		$("svg").onclick=()=>logoPaid?download(fileName("svg"),"image/svg+xml",logoData()):openLogoCheckout("svg");
		$("png").onclick=()=>{if(!logoPaid){openLogoCheckout("png");return}const img=new Image(),svg=logoSvg(state.transparentExport);img.onload=()=>{const baseW=state.layout==="wide"?900:720,baseH=state.layout==="wide"?320:520,width=Number(state.pngWidth)||2000,c=document.createElement("canvas");c.width=width;c.height=Math.round(width*baseH/baseW);const x=c.getContext("2d");if(!state.transparentExport){x.fillStyle=state.background;x.fillRect(0,0,c.width,c.height)}x.drawImage(img,0,0,c.width,c.height);download(fileName("png"),"image/png",c.toDataURL("image/png"))};img.src="data:image/svg+xml;charset=utf-8,"+encodeURIComponent(svg)};
		$("reset").onclick=()=>{state=fresh();render()};try{const saved=JSON.parse(localStorage.getItem("tgd-logo-maker"));if(saved?.name)state={...fresh(),...saved}}catch{}render();initialiseLogoPayment();
	</script>
