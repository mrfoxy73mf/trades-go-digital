---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en-GB">
<head>
	<BaseHead title="Logo Maker | Trades Go Digital" description="Design a simple business logo and export it as SVG or PNG." />
</head>
<body class="tgd-logo-office">
	<Header />
	<main class="logo-studio">
		<header class="studio-top">
			<a class="brand" href="/"><img src="/images/trades-go-digital-icon-stripe.png" alt="" /><span><strong>Trades Go Digital</strong><small>Logo Maker</small></span></a>
			<div class="actions"><span id="payment-status">Checking payment…</span><button id="reset" type="button">Reset</button><button id="use-pdf" type="button">Use in PDF Maker</button><button id="use-work-pack" type="button" disabled>Use in Work Pack</button><button id="use-tm-pack" type="button" disabled>Use in TM Pack</button><button id="svg" type="button" disabled>Download SVG</button><button id="png" type="button" disabled>Download PNG</button></div>
		</header>
		<div class="studio-grid">
			<aside class="tools">
				<section class="intro">
					<p>Brand Studio</p>
					<h1>Build a sharp trade logo.</h1>
					<span>Create a clean logo mark for vans, quotes, invoices, websites and social posts.</span>
					<a class="maker-price" href="/pricing#tools">View pricing</a>
				</section>
				<section class="panel open">
					<h2><button class="drawer" type="button">Business <span>Words</span></button></h2>
					<label>Business name<input id="name" /></label>
					<label>Short mark<input id="mark" maxlength="4" /></label>
					<label>Tagline<input id="tagline" /></label>
					<label>Trade type<select id="trade"><option>Construction</option><option>Plumbing</option><option>Electrical</option><option>Landscaping</option><option>Roofing</option><option>Groundworks</option><option>Cleaning</option><option>General Trades</option></select></label>
				</section>
				<section class="panel">
					<h2><button class="drawer" type="button">Templates <span>Starting point</span></button></h2>
					<div class="choice-grid" id="templates"></div>
				</section>
				<section class="panel">
					<h2><button class="drawer" type="button">Style <span>Layout</span></button></h2>
					<div class="choice-grid" id="layouts"></div>
					<div class="shape-grid" id="shapes"></div>
					<label>Badge treatment<select id="shapeStyle"><option value="solid">Solid fill</option><option value="outline">Outline only</option><option value="inset">Inset panel</option><option value="split">Split colour</option><option value="double">Double frame</option><option value="ghost">Soft ghost</option><option value="none">Symbol only</option></select></label>
					<label>Finish<select id="finish"><option value="clean">Clean</option><option value="metal">Metal</option><option value="stamp">Stamp</option><option value="neon">Neon</option><option value="cutout">Cut-out</option><option value="plate">Name plate</option><option value="carbon">Carbon</option><option value="hazard">Hazard stripe</option><option value="outline">Double outline</option><option value="luxury">Luxury foil</option><option value="glass">Glass panel</option></select></label>
				</section>
				<section class="panel two">
					<h2><button class="drawer" type="button">Symbol <span>Icon controls</span></button></h2>
					<label class="wide">Icon<select id="symbol"><option value="auto">Automatic for trade</option><option value="wrench">Wrench</option><option value="hammer">Hammer</option><option value="bolt">Lightning bolt</option><option value="plug">Electrical plug</option><option value="pipe">Pipework</option><option value="tap">Tap</option><option value="roof">Roof</option><option value="house">House</option><option value="spade">Spade</option><option value="leaf">Leaf</option><option value="brush">Cleaning brush</option><option value="flame">Flame</option><option value="shield">Shield tick</option><option value="none">No icon</option></select></label>
					<label>Icon size<input id="iconSize" type="range" min="55" max="145" /></label>
					<label>Badge size<input id="badgeScale" type="range" min="65" max="140" /></label>
					<label>Icon rotation<input id="iconRotation" type="range" min="-180" max="180" /></label>
					<label>Stroke width<input id="iconStroke" type="range" min="1" max="5" step="0.25" /></label>
					<label>Badge rotation<input id="badgeRotation" type="range" min="-25" max="25" /></label>
				</section>
				<section class="panel two">
					<h2><button class="drawer" type="button">Text <span>Size and position</span></button></h2>
					<label class="wide">Typeface<select id="font"><option value="industrial">Industrial sans</option><option value="condensed">Condensed trade</option><option value="geometric">Geometric modern</option><option value="classic">Classic serif</option><option value="technical">Technical mono</option><option value="rounded">Friendly rounded</option></select></label>
					<label>Name weight<select id="nameWeight"><option value="700">Bold</option><option value="800">Heavy</option><option value="900">Extra heavy</option></select></label>
					<label>Text style<select id="textStyle"><option value="normal">Straight</option><option value="italic">Italic</option></select></label>
					<label>Mark size<input id="markSize" type="range" min="18" max="72" /></label>
					<label>Name size<input id="nameSize" type="range" min="40" max="110" /></label>
					<label>Tagline size<input id="taglineSize" type="range" min="12" max="36" /></label>
					<label>Letter spacing<input id="letterSpace" type="range" min="0" max="14" /></label>
					<label>Text X<input id="textX" type="range" min="-120" max="120" /></label>
					<label>Text Y<input id="textY" type="range" min="-120" max="120" /></label>
					<label>Mark X<input id="markX" type="range" min="-140" max="140" /></label>
					<label>Mark Y<input id="markY" type="range" min="-100" max="120" /></label>
					<label class="check"><input id="uppercaseName" type="checkbox" /> Uppercase business name</label>
					<label class="check"><input id="showTagline" type="checkbox" /> Show tagline</label>
				</section>
				<section class="panel two">
					<h2><button class="drawer" type="button">Colours <span>Brand</span></button></h2>
					<label>Accent<input id="accent" type="color" /></label>
					<label>Secondary<input id="secondary" type="color" /></label>
					<label>Background<input id="background" type="color" /></label>
					<label>Background 2<input id="background2" type="color" /></label>
					<label>Text<input id="text" type="color" /></label>
					<label>Icon<input id="iconColor" type="color" /></label>
				</section>
				<section class="panel two">
					<h2><button class="drawer" type="button">Effects <span>Surface and frame</span></button></h2>
					<label class="wide">Background style<select id="backgroundStyle"><option value="solid">Solid</option><option value="gradient">Gradient</option><option value="split">Diagonal split</option><option value="transparent">Transparent</option></select></label>
					<label>Pattern<select id="pattern"><option value="none">None</option><option value="diagonal">Diagonal lines</option><option value="grid">Technical grid</option><option value="dots">Dot texture</option></select></label>
					<label>Pattern strength<input id="patternOpacity" type="range" min="0" max="35" /></label>
					<label>Border width<input id="borderWidth" type="range" min="0" max="18" /></label>
					<label>Corner radius<input id="cornerRadius" type="range" min="0" max="80" /></label>
					<label>Shadow<input id="shadowStrength" type="range" min="0" max="60" /></label>
				</section>
				<section class="panel two">
					<h2><button class="drawer" type="button">Export <span>File quality</span></button></h2>
					<label class="wide">PNG quality<select id="pngWidth"><option value="1000">Standard · 1000px</option><option value="2000">High resolution · 2000px</option><option value="3000">Print resolution · 3000px</option></select></label>
					<label class="wide check"><input id="transparentExport" type="checkbox" /> Transparent PNG background</label>
				</section>
				<section class="panel">
					<h2><button class="drawer" type="button">Preview <span>Mockups</span></button></h2>
					<div class="mock-tabs" id="mockups"></div>
				</section>
			</aside>
			<section class="preview">
				<div class="canvas-wrap" id="canvas-wrap">
					<div id="logo-preview"></div>
				</div>
				<div class="mockup" id="mockup"></div>
			</section>
		</div>
	</main>
	<script is:inline>
		const fresh=()=>({name:"TGD Trades",mark:"TGD",tagline:"TRADES GO DIGITAL",trade:"Construction",layout:"stacked",shape:"badge",shapeStyle:"solid",finish:"metal",symbol:"auto",font:"industrial",nameWeight:"900",textStyle:"normal",uppercaseName:false,showTagline:true,accent:"#ff6b00",secondary:"#f8fafc",background:"#05070a",background2:"#172033",text:"#ffffff",iconColor:"#05070a",backgroundStyle:"solid",pattern:"none",patternOpacity:12,borderWidth:0,cornerRadius:34,shadowStrength:35,transparentExport:false,pngWidth:"2000",iconSize:100,badgeScale:100,iconRotation:0,iconStroke:2.4,badgeRotation:0,markSize:30,nameSize:78,taglineSize:24,letterSpace:7,textX:0,textY:0,markX:0,markY:0,mockup:"van"});
		const templates={
			trade:{label:"Trade Strong",layout:"stacked",shape:"badge",finish:"metal",accent:"#ff6b00",secondary:"#f8fafc",background:"#05070a",text:"#ffffff",markSize:30,nameSize:78,taglineSize:24,letterSpace:7,textX:0,textY:0,markX:0,markY:0},
			shield:{label:"Safety Shield",layout:"emblem",shape:"shield",finish:"plate",accent:"#f97316",secondary:"#facc15",background:"#111827",text:"#ffffff",markSize:34,nameSize:72,taglineSize:22,letterSpace:6,textX:0,textY:8,markX:0,markY:0},
			van:{label:"Van Side",layout:"wide",shape:"tab",finish:"clean",accent:"#ff6b00",secondary:"#93c5fd",background:"#07111f",text:"#ffffff",markSize:32,nameSize:72,taglineSize:20,letterSpace:5,textX:0,textY:0,markX:0,markY:0},
			premium:{label:"Premium Black",layout:"minimal",shape:"diamond",finish:"neon",accent:"#f59e0b",secondary:"#ffffff",background:"#030712",text:"#ffffff",markSize:28,nameSize:82,taglineSize:20,letterSpace:10,textX:0,textY:-8,markX:0,markY:0},
			local:{label:"Local Trader",layout:"wide",shape:"circle",finish:"stamp",accent:"#16a34a",secondary:"#dcfce7",background:"#052e16",text:"#f8fafc",markSize:28,nameSize:64,taglineSize:18,letterSpace:3,textX:0,textY:0,markX:0,markY:0},
			certified:{label:"Certified",layout:"emblem",shape:"hex",finish:"cutout",accent:"#2563eb",secondary:"#e0f2fe",background:"#0f172a",text:"#ffffff",markSize:36,nameSize:68,taglineSize:19,letterSpace:8,textX:0,textY:10,markX:0,markY:0},
			power:{label:"Power Tools",layout:"wide",shape:"bolt",finish:"hazard",accent:"#f97316",secondary:"#fbbf24",background:"#0b0f14",text:"#ffffff",markSize:34,nameSize:78,taglineSize:20,letterSpace:5,textX:10,textY:0,markX:0,markY:-2},
			workshop:{label:"Workshop",layout:"stacked",shape:"gear",finish:"carbon",accent:"#ff6b00",secondary:"#94a3b8",background:"#06080c",text:"#f8fafc",markSize:30,nameSize:74,taglineSize:22,letterSpace:7,textX:0,textY:4,markX:0,markY:0},
			property:{label:"Property",layout:"emblem",shape:"house",finish:"glass",accent:"#0ea5e9",secondary:"#ffffff",background:"#082f49",text:"#ffffff",markSize:30,nameSize:70,taglineSize:19,letterSpace:6,textX:0,textY:12,markX:0,markY:0},
			classic:{label:"Classic Ribbon",layout:"seal",shape:"ribbon",finish:"outline",accent:"#b45309",secondary:"#fef3c7",background:"#1c1208",text:"#ffffff",markSize:30,nameSize:64,taglineSize:18,letterSpace:7,textX:0,textY:22,markX:0,markY:-12},
			modern:{label:"Modern Pill",layout:"wide",shape:"pill",finish:"luxury",accent:"#f59e0b",secondary:"#ffffff",background:"#09090b",text:"#ffffff",markSize:30,nameSize:70,taglineSize:18,letterSpace:5,textX:0,textY:0,markX:0,markY:0},
			blueprint:{label:"Blueprint",layout:"wide",shape:"slab",finish:"clean",symbol:"house",font:"technical",accent:"#38bdf8",secondary:"#bae6fd",background:"#082f49",background2:"#0c4a6e",backgroundStyle:"gradient",pattern:"grid",patternOpacity:18,text:"#ffffff",iconColor:"#082f49",borderWidth:4,cornerRadius:18,shadowStrength:18,markSize:25,nameSize:66,taglineSize:18,letterSpace:3,textX:4,textY:0,markX:0,markY:0},
			eco:{label:"Eco Trade",layout:"emblem",shape:"circle",finish:"glass",symbol:"leaf",font:"rounded",accent:"#22c55e",secondary:"#dcfce7",background:"#052e16",background2:"#14532d",backgroundStyle:"gradient",pattern:"dots",patternOpacity:12,text:"#ffffff",iconColor:"#052e16",borderWidth:5,cornerRadius:48,shadowStrength:24,markSize:28,nameSize:66,taglineSize:18,letterSpace:4,textX:0,textY:10,markX:0,markY:0},
			electric:{label:"Electric Pulse",layout:"wide",shape:"bolt",finish:"neon",symbol:"plug",font:"condensed",accent:"#facc15",secondary:"#ffffff",background:"#111827",background2:"#312e81",backgroundStyle:"split",pattern:"diagonal",patternOpacity:8,text:"#ffffff",iconColor:"#111827",borderWidth:3,cornerRadius:12,shadowStrength:48,markSize:30,nameSize:82,taglineSize:19,letterSpace:5,textX:5,textY:0,markX:0,markY:0},
			heritage:{label:"Heritage Craft",layout:"seal",shape:"ribbon",finish:"outline",symbol:"hammer",font:"classic",accent:"#d97706",secondary:"#fef3c7",background:"#27160a",background2:"#451a03",backgroundStyle:"gradient",pattern:"none",text:"#fff7ed",iconColor:"#27160a",borderWidth:4,cornerRadius:24,shadowStrength:20,nameWeight:"700",textStyle:"italic",markSize:28,nameSize:62,taglineSize:17,letterSpace:5,textX:0,textY:18,markX:0,markY:-10},
			mono:{label:"Simple Mark",layout:"minimal",shape:"badge",finish:"clean",symbol:"wrench",font:"geometric",accent:"#0f172a",secondary:"#475569",background:"#ffffff",background2:"#f1f5f9",backgroundStyle:"transparent",pattern:"none",text:"#0f172a",iconColor:"#ffffff",borderWidth:0,cornerRadius:0,shadowStrength:0,uppercaseName:true,markSize:24,nameSize:72,taglineSize:17,letterSpace:6,textX:0,textY:-4,markX:0,markY:0}
		};
		const layouts={stacked:"Stacked",wide:"Wide",emblem:"Emblem",minimal:"Minimal",seal:"Seal",corner:"Corner"};
		const shapes={
			badge:{label:"Soft square",d:"M12 6H88Q94 6 94 12V88Q94 94 88 94H12Q6 94 6 88V12Q6 6 12 6Z"},slab:{label:"Workshop slab",d:"M7 7H93V93H7Z"},circle:{label:"Circle",d:"M50 5A45 45 0 1 1 49.9 5Z"},roundel:{label:"Roundel",d:"M50 3A47 47 0 1 1 49.9 3Z"},shield:{label:"Shield",d:"M50 3 93 20V57Q93 85 50 98 7 85 7 57V20Z"},crest:{label:"Crest",d:"M12 7H88V53Q88 84 50 98 12 84 12 53Z"},hex:{label:"Hexagon",d:"M27 5H73L97 50 73 95H27L3 50Z"},diamond:{label:"Diamond",d:"M50 3 97 50 50 97 3 50Z"},arch:{label:"Arch",d:"M8 94V48A42 42 0 0 1 92 48V94Z"},chevron:{label:"Chevron",d:"M5 12H95V62L50 95 5 62Z"},house:{label:"Roof badge",d:"M50 3 96 38V95H4V38Z"},tab:{label:"Angled tab",d:"M5 5H95V95H5V25L25 5Z"},ticket:{label:"Ticket",d:"M5 12Q18 12 18 5H82Q82 12 95 12V88Q82 88 82 95H18Q18 88 5 88Z"},pill:{label:"Pill",d:"M22 5H78A45 45 0 0 1 78 95H22A45 45 0 0 1 22 5Z"},ribbon:{label:"Ribbon",d:"M8 5H92V95L50 79 8 95Z"},gear:{label:"Gear",d:"M42 3H58L62 13 73 8 84 19 79 30 90 34 97 47 88 55 94 67 84 81 71 77 65 91 50 97 40 87 27 92 16 81 21 68 8 62 3 48 13 39 8 27 19 16 32 21Z"},bolt:{label:"Lightning",d:"M59 2 15 57H45L34 98 86 38H57Z"}
		};
		const mockups={van:"Van side",quote:"Quote header",social:"Social avatar",workwear:"Workwear"};
		let state=fresh();
		const $=id=>document.getElementById(id);
		const esc=v=>String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[c]));
		function fittedFontSize(text,fontFamily,fontWeight,fontStyle,requested,maxWidth){
			const canvas=document.createElement("canvas"),context=canvas.getContext("2d"),size=Math.max(10,Number(requested)||10);
			context.font=`${fontStyle||"normal"} ${fontWeight||"700"} ${size}px ${fontFamily}`;
			const measured=context.measureText(String(text||"")).width;
			return measured>maxWidth?Math.max(10,Math.floor(size*maxWidth/measured)):size;
		}
		const symbolPaths={wrench:"M5 19 11 13M14 10l5-5M13 4a5 5 0 0 0 7 7l-9 9a2 2 0 0 1-3-3l9-9a5 5 0 0 0-4-4Z",hammer:"M4 20 13 11M10 6l3-3 8 8-3 3z",bolt:"M13 2 4 14h7l-2 8 9-12h-7l2-8z",plug:"M8 3v6m8-6v6M6 9h12v3a6 6 0 0 1-12 0zM12 18v4",pipe:"M4 7h7v4h6v9M8 4v6M4 4h8",tap:"M4 12h16M8 12V8h8v4M10 8V5h4v3M18 12v4a3 3 0 0 1-3 3",roof:"M3 12 12 4l9 8M6 10v9h12v-9",house:"M4 11 12 4l8 7v9H4zM9 20v-6h6v6",spade:"M12 3v11M8 20h8M7 14h10l-2 6H9z",leaf:"M4 18c6-1 10-6 16-14 0 10-4 17-14 14zM6 18c4-4 7-7 12-11",brush:"M7 4h10v8H7zM9 12v5c0 3-4 3-4 0M13 12v6M17 12v5c0 3 4 3 4 0",flame:"M12 22c-5 0-8-3-7-8 1-4 5-6 5-11 5 4 9 7 9 12 0 4-3 7-7 7zM12 19c-2 0-3-1-3-3 0-2 2-3 3-5 2 2 3 3 3 5 0 2-1 3-3 3z",shield:"M12 3 20 6v6c0 5-3 8-8 10-5-2-8-5-8-10V6zM8 12l3 3 5-6"};
		function icon(){if(state.symbol==="none")return"";if(state.symbol!=="auto")return symbolPaths[state.symbol]||symbolPaths.wrench;return {Plumbing:symbolPaths.pipe,Electrical:symbolPaths.bolt,Landscaping:symbolPaths.leaf,Roofing:symbolPaths.roof,Groundworks:symbolPaths.spade,Cleaning:symbolPaths.brush,"General Trades":symbolPaths.wrench}[state.trade]||symbolPaths.hammer}
		function logoSvg(transparent=false){
			const wide=state.layout==="wide",emblem=state.layout==="emblem",minimal=state.layout==="minimal",seal=state.layout==="seal",corner=state.layout==="corner";
			const w=wide?900:720,h=wide?320:520,baseMarkSize=emblem||seal?190:wide?150:170,markSize=baseMarkSize*((Number(state.badgeScale)||100)/100);
			const markX=(wide?54:(w-markSize)/2)+Number(state.markX||0),markY=(wide?82:54)+Number(state.markY||0);
			const textAnchor=wide||corner?"start":"middle";
			const textBaseX=(wide?250:corner?70:w/2)+Number(state.textX||0),textBaseY=(wide?86:corner?88:minimal?246:260)+Number(state.textY||0);
			const fonts={industrial:'Arial Black, Arial, sans-serif',condensed:'Impact, Arial Narrow, sans-serif',geometric:'Avenir Next, Montserrat, Arial, sans-serif',classic:'Georgia, Times New Roman, serif',technical:'Courier New, monospace',rounded:'Trebuchet MS, Arial, sans-serif'};
			const fontFamily=fonts[state.font]||fonts.industrial,nameText=state.uppercaseName?String(state.name).toUpperCase():state.name,cornerRadius=Number(state.cornerRadius??34),shadow=Number(state.shadowStrength??35)/100,iconScale=(Number(state.iconSize)||100)/100;
			const textPadding=wide?40:56,maxTextWidth=textAnchor==="start"?Math.max(80,w-textBaseX-textPadding):Math.max(80,2*Math.min(textBaseX-textPadding,w-textBaseX-textPadding)),nameSize=fittedFontSize(nameText,fontFamily,state.nameWeight,state.textStyle,Number(state.nameSize)||78,maxTextWidth),taglineSize=fittedFontSize(state.tagline,fontFamily,"700","normal",Number(state.taglineSize)||24,maxTextWidth);
			const shapeD=(shapes[state.shape]||shapes.badge).d,shapeScale=markSize/100,shapeStroke=Math.max(3,markSize*.055);
			const backgroundStyle=transparent?"transparent":state.backgroundStyle;
			const backgroundFill=backgroundStyle==="gradient"?"url(#bg)":state.background;
			const patternMarkup=state.pattern==="diagonal"?`<pattern id="p" width="24" height="24" patternUnits="userSpaceOnUse" patternTransform="rotate(35)"><path d="M0 0V24" stroke="${state.secondary}" stroke-width="7"/></pattern>`:state.pattern==="grid"?`<pattern id="p" width="34" height="34" patternUnits="userSpaceOnUse"><path d="M34 0H0V34" fill="none" stroke="${state.secondary}" stroke-width="2"/></pattern>`:state.pattern==="dots"?`<pattern id="p" width="28" height="28" patternUnits="userSpaceOnUse"><circle cx="5" cy="5" r="3" fill="${state.secondary}"/></pattern>`:"";
			const badgePath=`<path d="${shapeD}"`;
			const badgeMarkup=state.shapeStyle==="none"?"":state.shapeStyle==="outline"?`${badgePath} transform="scale(${shapeScale})" fill="none" stroke="${state.accent}" stroke-width="${shapeStroke/shapeScale}"/>`:state.shapeStyle==="ghost"?`${badgePath} transform="scale(${shapeScale})" fill="${state.accent}" fill-opacity=".16" stroke="${state.accent}" stroke-width="${shapeStroke/shapeScale}"/>`:state.shapeStyle==="inset"?`${badgePath} transform="scale(${shapeScale})" fill="url(#g)"/>${badgePath} transform="translate(${markSize*.1} ${markSize*.1}) scale(${shapeScale*.8})" fill="${state.background}" fill-opacity=".72"/>`:state.shapeStyle==="double"?`${badgePath} transform="scale(${shapeScale})" fill="${state.background}" stroke="${state.accent}" stroke-width="${shapeStroke/shapeScale}"/>${badgePath} transform="translate(${markSize*.1} ${markSize*.1}) scale(${shapeScale*.8})" fill="none" stroke="${state.secondary}" stroke-width="${shapeStroke*.45/shapeScale}"/>`:state.shapeStyle==="split"?`${badgePath} transform="scale(${shapeScale})" fill="${state.accent}"/><g clip-path="url(#badgeClip)"><rect x="${markSize/2}" width="${markSize/2}" height="${markSize}" fill="${state.secondary}"/></g>`:`${badgePath} transform="scale(${shapeScale})" fill="url(#g)"/>`;
			return `<svg xmlns="http://www.w3.org/2000/svg" width="${w}" height="${h}" viewBox="0 0 ${w} ${h}">
				<defs><linearGradient id="g" x1="0" x2="1"><stop stop-color="${state.accent}"/><stop offset="1" stop-color="${state.secondary}"/></linearGradient><linearGradient id="bg" x1="0" y1="0" x2="1" y2="1"><stop stop-color="${state.background}"/><stop offset="1" stop-color="${state.background2}"/></linearGradient><filter id="s"><feDropShadow dx="0" dy="${Math.round(4+shadow*18)}" stdDeviation="${Math.round(2+shadow*18)}" flood-opacity="${shadow}"/></filter><clipPath id="badgeClip"><path d="${shapeD}" transform="scale(${shapeScale})"/></clipPath>${patternMarkup}</defs>
				${backgroundStyle==="transparent"?"":`<rect x="${Number(state.borderWidth)||0}" y="${Number(state.borderWidth)||0}" width="${w-2*(Number(state.borderWidth)||0)}" height="${h-2*(Number(state.borderWidth)||0)}" rx="${state.shape==="circle"?h/2:cornerRadius}" fill="${backgroundFill}" stroke="${state.accent}" stroke-width="${Number(state.borderWidth)||0}"/>`}
				${backgroundStyle==="split"?`<path d="M0 0H${w}L${w*.62} ${h}H0Z" fill="${state.background}"/><path d="M${w} 0V${h}H${w*.62}Z" fill="${state.background2}"/>`:""}
				${state.pattern!=="none"?`<rect width="100%" height="100%" rx="${cornerRadius}" fill="url(#p)" opacity="${Number(state.patternOpacity||0)/100}"/>`:""}
				${state.finish==="metal"?`<path d="M0 ${h*.72}  ${w} ${h*.48} V${h} H0Z" fill="#fff" opacity=".06"/>`:""}
				${state.finish==="stamp"?`<rect x="26" y="26" width="${w-52}" height="${h-52}" rx="22" fill="none" stroke="${state.accent}" stroke-width="6" stroke-dasharray="18 12"/>`:""}
