		function useInSafeWork(path){if(!logoPaid)return;const img=new Image(),svg=logoSvg(true);img.onload=()=>{const baseW=state.layout==="wide"?900:720,baseH=state.layout==="wide"?320:520,width=360,c=document.createElement("canvas");c.width=width;c.height=Math.round(width*baseH/baseW);c.getContext("2d").drawImage(img,0,0,c.width,c.height);const dataUrl=c.toDataURL("image/webp",.86);if(dataUrl.length>40000){$("payment-status").textContent="This design is too detailed for a work-pack header. Try a simpler design.";return}localStorage.setItem("tgd-safework-logo-v1",JSON.stringify({dataUrl,name:state.name,savedAt:Date.now()}));location.href=path};img.src="data:image/svg+xml;charset=utf-8,"+encodeURIComponent(svg)}
