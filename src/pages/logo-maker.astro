		const logoData=()=>"data:image/svg+xml;charset=utf-8,"+encodeURIComponent(logoSvg());
		function render(){
			["name","mark","tagline","trade","shapeStyle","finish","symbol","font","nameWeight","textStyle","accent","secondary","background","background2","text","iconColor","backgroundStyle","pattern","patternOpacity","borderWidth","cornerRadius","shadowStrength","pngWidth","iconSize","badgeScale","iconRotation","iconStroke","badgeRotation","markSize","nameSize","taglineSize","letterSpace","textX","textY","markX","markY"].forEach(k=>$(k).value=state[k]);
