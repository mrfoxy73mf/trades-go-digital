		async function openLogoCheckout(format){const buttons=[$("svg"),$("png")];buttons.forEach(button=>button.disabled=true);$("payment-status").textContent="Opening secure Stripe checkout…";sessionStorage.setItem("tgd-logo-format",format);sessionStorage.setItem("tgd-logo-design-pending",designKey());sessionStorage.setItem("tgd-logo-state-pending",JSON.stringify(state));try{const response=await fetch("/api/logo-payment/checkout",{method:"POST",headers:{"Content-Type":"application/json"}}),data=await response.json();if(!response.ok)throw new Error(data.error);location.href=data.url}catch(error){$("payment-status").textContent=error instanceof Error?error.message:"Checkout could not be opened";buttons.forEach(button=>button.disabled=false)}}
		async function initialiseLogoPayment(){const params=new URLSearchParams(location.search),session=params.get("session_id")||sessionStorage.getItem("tgd-logo-payment")||"";if(params.get("checkout")==="cancelled")$("payment-status").textContent="Payment cancelled — your logo is still saved";try{const availability=await (await fetch("/api/logo-payment/checkout")).json();if(!availability.enabled){$("payment-status").textContent="Logo downloads are temporarily unavailable";return}logoPriceLabel=new Intl.NumberFormat("en-GB",{style:"currency",currency:"GBP"}).format(availability.amount/100);if(session){const check=await (await fetch(`/api/logo-payment/verify?session_id=${encodeURIComponent(session)}`)).json();if(check.paid){const pendingState=sessionStorage.getItem("tgd-logo-state-pending");if(pendingState){try{state={...fresh(),...JSON.parse(pendingState)}}catch{}}paidDesignKey=sessionStorage.getItem("tgd-logo-design-pending")||designKey();sessionStorage.setItem("tgd-logo-paid-design",paidDesignKey);logoPaid=true;sessionStorage.setItem("tgd-logo-payment",session);render();$("payment-status").textContent=`Payment confirmed${availability.mode==="test"?" — TEST MODE":""} — this design is unlocked`;$("svg").textContent="Download SVG";$("png").textContent="Download PNG";$("svg").disabled=false;$("png").disabled=false;$("use-work-pack").disabled=false;$("use-tm-pack").disabled=false;return}}$("payment-status").textContent=`${availability.mode==="test"?"Test payment":"Payment"} required`;$("svg").textContent=`Pay ${logoPriceLabel} & download SVG`;$("png").textContent=`Pay ${logoPriceLabel} & download PNG`;$("svg").disabled=false;$("png").disabled=false}catch{$("payment-status").textContent="Payment availability could not be checked"}}
