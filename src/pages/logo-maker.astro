		document.addEventListener("click",e=>{const d=e.target.closest(".drawer");if(d){document.querySelectorAll(".panel").forEach(p=>p.classList.remove("open"));d.closest(".panel").classList.add("open");return}const t=e.target.closest("[data-template]");if(t){const clean=fresh(),content={name:state.name,mark:state.mark,tagline:state.tagline,trade:state.trade,mockup:state.mockup,pngWidth:state.pngWidth,transparentExport:state.transparentExport};state={...clean,...content,...templates[t.dataset.template]};render()}const l=e.target.closest("[data-layout]");if(l){state.layout=l.dataset.layout;render()}const s=e.target.closest("[data-shape]");if(s){state.shape=s.dataset.shape;render()}const m=e.target.closest("[data-mockup]");if(m){state.mockup=m.dataset.mockup;render()}});
