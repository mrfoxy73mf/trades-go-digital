---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { TGD_APP_URL } from '../consts';
export const prerender = false;
---
<!doctype html><html lang="en-GB"><head><BaseHead title="TGD Trades Pricing | Trades Go Digital" description="TGD Trades subscription pricing for UK tradespeople and small trade businesses." /></head><body><Header /><main>
<section class="hero"><p class="eyebrow">TGD TRADES PRICING</p><h1>One app. One straightforward subscription.</h1><p class="lead">Keep jobs, customers, quotes, invoices, receipts and business paperwork together.</p></section>
<section class="pricing" aria-labelledby="pricing-title"><article class="card"><div><p class="eyebrow">MONTHLY SUBSCRIPTION</p><h2 id="pricing-title">TGD Trades</h2><p class="price">£40 <span>/ month</span></p><p>For your first three months.</p><p class="ongoing"><strong>Then £70 per month.</strong></p><p>Cancel at any time. No long-term contract.</p><a class="button" href={TGD_APP_URL}>Open TGD Trades and subscribe</a></div><div class="included"><h3>Included</h3><ul><li>Jobs, customers and work calendar</li><li>Quotes, materials and invoices</li><li>Receipts, mileage and business records</li><li>Professional PDFs and customer paperwork</li><li>Phone, tablet and computer access</li><li>AI features subject to the allowance shown at checkout</li></ul></div></article><p class="legal">The price, AI allowance and any introductory offer shown at checkout will be confirmed before payment. Read the <a href="/terms-and-conditions">Terms &amp; Conditions</a>.</p></section>
</main><Footer /></body></html>
<style>
:global(*){box-sizing:border-box}:global(body){margin:0;background:#f3f6f9;color:#0b1930;font-family:Inter,ui-sans-serif,system-ui,sans-serif}main{width:min(1050px,calc(100% - 32px));margin:auto;padding:70px 0}.hero{max-width:760px;margin-bottom:38px}.eyebrow{margin:0 0 12px;color:#a84300;font-size:.76rem;font-weight:900;letter-spacing:.1em}.hero h1{margin:0 0 18px;font-size:clamp(2.3rem,6vw,4.6rem);line-height:1.02}.lead{color:#536174;font-size:1.18rem}.card{display:grid;grid-template-columns:1fr 1fr;gap:42px;padding:38px;border-radius:18px;background:#fff;box-shadow:0 18px 50px #07111f17;border-top:5px solid #ff7900}.card h2{margin:0;font-size:2rem}.price{margin:18px 0 6px;font-size:3.4rem;font-weight:900}.price span{font-size:1rem;font-weight:600}.ongoing{font-size:1.1rem}.included{padding:10px 0}.included h3{font-size:1.4rem}.included li{margin:12px 0}.button{display:inline-flex;margin-top:16px;padding:14px 20px;border-radius:8px;background:#ff7900;color:#07111f;font-weight:900;text-decoration:none}.button:hover{background:#ff9b3e}.legal{margin-top:22px;color:#536174;font-size:.9rem}.legal a{font-weight:800;color:#0b1930}@media(max-width:700px){main{padding:45px 0}.card{grid-template-columns:1fr;padding:26px;gap:18px}.hero h1{font-size:2.5rem}}
</style>