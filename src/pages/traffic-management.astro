---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
export const prerender = false;
---
<html lang="en-GB"><head><BaseHead title="Traffic management work packs | Trades Go Digital" description="Create a Chapter 8 traffic-management work pack for a specific road, closure and works location." /></head><body><Header/><main class="workspace"><a href="/health-and-safety">← Health &amp; Safety</a><p class="eyebrow">SAFEWORK AI / TRAFFIC MANAGEMENT</p><h1>Create a traffic-management work pack</h1><p class="intro">Record the actual road, direction, marker-post limits, closure and approved layout information. Your paid pack is generated only after Stripe confirms payment.</p><ol class="steps"><li><b>1</b> Road and works</li><li><b>2</b> Closure and layout</li><li><b>3</b> Emergency details</li><li><b>4</b> Review and pay</li></ol><form id="tm-form"><fieldset><legend>Company and workforce</legend><div class="grid"><label>Company name<input name="company" required maxlength="200"></label><label>Company address <span>(optional)</span><input name="companyAddress" maxlength="500"></label><label>Contact telephone <span>(optional)</span><input name="contact" type="tel" maxlength="200"></label><label>Number of workers<input name="workerCount" type="number" min="1" max="50" value="4" required></label></div></fieldset>
<fieldset><legend>Road and exact works limits</legend><div class="grid"><label>Road number / name<input name="road" required placeholder="A12"></label><label>Direction<select name="direction" required><option value="">Select direction</option><option value="Northbound (N/B)">Northbound (N/B)</option><option value="Southbound (S/B)">Southbound (S/B)</option><option value="Eastbound (E/B)">Eastbound (E/B)</option><option value="Westbound (W/B)">Westbound (W/B)</option><option value="Both directions">Both directions</option></select></label><label>Start marker post / chainage<input name="startMarker" required placeholder="10/01"></label><label>End marker post / chainage<input name="endMarker" required placeholder="12/01"></label><label>Carriageway / lanes affected<input name="lanes" required placeholder="Lane 2 southbound"></label><label>Speed limit<input name="speed" required placeholder="70 mph"></label><label>Nearest junction / landmark<input name="landmark" required></label><label>Planned date, time and duration<input name="duration" required placeholder="16 September, 20:00–06:00"></label></div><label>Work activity<textarea name="activity" required rows="4" minlength="40" placeholder="Describe the traffic-management installation, maintenance or removal work."></textarea></label></fieldset>
<fieldset><legend>Closure and Chapter 8 arrangement</legend><p>Choose every arrangement included in the approved design.</p><div class="ticks"><label><input type="checkbox" name="arrangement" value="Lane closure"> Lane closure</label><label><input type="checkbox" name="arrangement" value="Full road closure"> Full road closure</label><label><input type="checkbox" name="arrangement" value="Hard-shoulder closure"> Hard-shoulder closure</label><label><input type="checkbox" name="arrangement" value="Portable two-way traffic signals"> Portable two-way traffic lights</label><label><input type="checkbox" name="arrangement" value="Portable multi-way traffic signals"> Portable multi-way traffic lights</label><label><input type="checkbox" name="arrangement" value="Stop / Go control"> Stop / Go</label><label><input type="checkbox" name="arrangement" value="Signed diversion route"> Signed diversion</label><label><input type="checkbox" name="arrangement" value="Multi-phase staged traffic-management layout"> Multi-phase / staged layout</label></div><div class="grid"><label>Highway authority / client<input name="authority" required></label><label>TM drawing number and revision<input name="drawing" required></label><label>Road-space booking / permit reference<input name="roadspace" required></label><label>Traffic order / notice / signal approval<input name="orderRef" required placeholder="Enter reference or state not applicable"></label></div><label>Phase sequence and changeover method<textarea name="phases" required rows="4" placeholder="Phase 1 limits and lanes; safe changeover sequence; Phase 2 limits and lanes. State single phase if applicable."></textarea></label><label>Approved layout details<textarea name="layout" required rows="4" placeholder="Works length, lead-in taper, safety zones, signs, cones, barriers, lamps and signal settings — copy from the approved drawing; do not estimate."></textarea></label><label>Pedestrian, cyclist, property and emergency access<textarea name="access" required rows="3"></textarea></label><div class="grid"><label>TM designer / organisation<input name="designer" required></label><label>TM supervisor / foreman<input name="supervisor" required></label><label>Installation team competence<input name="competence" required placeholder="Relevant cards, training and roles"></label><label>Inspection frequency<input name="inspections" required></label></div></fieldset>
<fieldset><legend>Emergency information</legend><div class="grid"><label>Site emergency contact<input name="siteEmergencyContact" required></label><label>Contact telephone<input name="siteEmergencyPhone" type="tel" required></label><label>First aider<input name="firstAider" required></label><label>First aider telephone<input name="firstAiderPhone" type="tel" required></label><label>Nearest hospital / A&amp;E<input name="hospital" required></label><label>Hospital address and postcode<input name="hospitalAddress" required></label></div><label>Breakdown, collision, failed signals and emergency-access plan<textarea name="emergencyPlan" required rows="4"></textarea></label></fieldset>
<div class="notice"><strong>Check the approved information before payment.</strong> The pack will contain blank operational records and signature boxes, but it cannot grant a road-space booking, traffic order, signal approval or Chapter 8 design approval.</div><label class="check"><input type="checkbox" name="reviewAccepted" required> I understand this is an AI-generated draft that must be checked by a competent traffic-management person before use.</label><label class="check"><input type="checkbox" name="processingAccepted" required> I agree to send these job details to OpenAI to prepare the pack and store the order with Trades Go Digital.</label><button id="review" type="submit">Review details and price →</button></form><section id="confirmation" hidden><h2>Review before payment</h2><pre id="summary"></pre><p id="total"></p><button id="pay">Create order</button> <button id="edit" class="secondary">Edit details</button></section><p id="message" role="status"></p><section id="recovery" hidden><h2>Your order is saved</h2><a id="order-link">Open private order link</a><p><a id="stripe-link" class="button">Pay securely with Stripe →</a></p></section></main><Footer/>
<script>
const form=document.querySelector<HTMLFormElement>('#tm-form')!, confirmation=document.querySelector<HTMLElement>('#confirmation')!, msg=document.querySelector<HTMLElement>('#message')!;let payload:Record<string,unknown>={},price='£14.99';
const value=(d:FormData,n:string)=>String(d.get(n)||'').trim();form.addEventListener('submit',e=>{e.preventDefault();const d=new FormData(form), arrangements=d.getAll('arrangement').map(String);if(!arrangements.length){msg.textContent='Choose at least one closure or traffic-control arrangement.';return;}const road=`${value(d,'road')} ${value(d,'direction')}, ${value(d,'lanes')}, marker post ${value(d,'startMarker')} to ${value(d,'endMarker')}`;const planning=[`TRAFFIC-MANAGEMENT JOB: ${value(d,'activity')}`,`Exact road and limits: ${road}; nearest junction/landmark: ${value(d,'landmark')}; speed limit: ${value(d,'speed')}`,`Planned date/time/duration: ${value(d,'duration')}`,`Selected arrangement: ${arrangements.join('; ')}`,`Highway authority/client: ${value(d,'authority')}`,`TM drawing/revision: ${value(d,'drawing')}`,`Road-space booking/permit: ${value(d,'roadspace')}`,`Traffic order/notice/signal approval: ${value(d,'orderRef')}`,`Phase sequence/changeover: ${value(d,'phases')}`,`Approved layout details: ${value(d,'layout')}`,`Road-user/property/emergency access: ${value(d,'access')}`,`Designer: ${value(d,'designer')}; supervisor: ${value(d,'supervisor')}; competence: ${value(d,'competence')}; inspections: ${value(d,'inspections')}`,`Emergency plan: ${value(d,'emergencyPlan')}`];payload={company:value(d,'company'),companyAddress:value(d,'companyAddress'),contact:value(d,'contact'),workerCount:Number(d.get('workerCount')),trialHoleSheets:1,address:road,description:planning.join('\n'),emergency:`Site emergency contact: ${value(d,'siteEmergencyContact')}: ${value(d,'siteEmergencyPhone')}\nFirst aider: ${value(d,'firstAider')}: ${value(d,'firstAiderPhone')}\nHospital 1: ${value(d,'hospital')}: ${value(d,'hospitalAddress')}`,reviewAccepted:d.has('reviewAccepted'),processingAccepted:d.has('processingAccepted')};document.querySelector('#summary')!.textContent=planning.join('\n\n');form.hidden=true;confirmation.hidden=false;msg.textContent='';confirmation.scrollIntoView({behavior:'smooth'});});
fetch('/api/safework/checkout').then(r=>r.json()).then(c=>{price=new Intl.NumberFormat('en-GB',{style:'currency',currency:'GBP'}).format(Number(c.amount)/100);document.querySelector('#total')!.textContent=`Total: ${price}${c.mode==='test'?' — TEST CHECKOUT, no real payment':''}`;});document.querySelector('#edit')!.addEventListener('click',()=>{form.hidden=false;confirmation.hidden=true});document.querySelector('#pay')!.addEventListener('click',async()=>{msg.textContent='Opening your order…';try{const r=await fetch('/api/safework/checkout',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)}),d=await r.json();if(!r.ok)throw new Error(d.error);(document.querySelector('#order-link') as HTMLAnchorElement).href=d.returnUrl;(document.querySelector('#stripe-link') as HTMLAnchorElement).href=d.url;confirmation.hidden=true;document.querySelector<HTMLElement>('#recovery')!.hidden=false;msg.textContent='Order saved. Keep the private link, then continue to Stripe.';}catch(e){msg.textContent=e instanceof Error?e.message:'Checkout failed.';}});
</script>
<style>body{background:#071421;color:#eef6f2}.workspace{width:min(1180px,calc(100% - 32px));margin:auto;padding:42px 0 70px}.workspace>a{color:#d9f3e6}.eyebrow{color:#ff9a48;font-weight:850;letter-spacing:.13em}.intro{max-width:780px;font-size:18px}.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;padding:0;list-style:none}.steps li{background:#fff;color:#071421;padding:15px;border-radius:8px;font-weight:800}.steps b{display:inline-grid;place-items:center;width:26px;height:26px;margin-right:8px;border-radius:50%;background:#ff8129}form,#confirmation,#recovery{background:#fff;color:#102d23;border-radius:12px;padding:30px;margin-top:24px}fieldset{border:1px solid #bfd0c6;border-radius:9px;margin:0 0 25px;padding:22px}legend{padding:0 10px;color:#126747;font-size:22px;font-weight:900}.grid,.ticks{display:grid;grid-template-columns:1fr 1fr;gap:16px}.ticks{grid-template-columns:repeat(2,1fr);margin-bottom:20px}.ticks label,.check{display:flex;gap:9px;align-items:flex-start}label{display:block;font-weight:750}label span{font-weight:400}input:not([type=checkbox]),select,textarea{display:block;width:100%;margin-top:7px;padding:12px;border:1px solid #9eb4a8;border-radius:5px;font:inherit}textarea{resize:vertical}button,.button{display:inline-block;background:#f57f20;color:#071421;border:0;border-radius:5px;padding:14px 20px;font-weight:900;cursor:pointer}.secondary{background:#dfe8e3}.notice{border:2px solid #f57f20;background:#fff6ec;padding:16px;margin:20px 0}.check{margin:15px 0;font-weight:500}pre{white-space:pre-wrap;font:inherit}a{color:inherit}[hidden]{display:none!important}@media(max-width:720px){.grid,.ticks,.steps{grid-template-columns:1fr}form{padding:18px}fieldset{padding:16px}}</style></body></html>
