---
import BaseHead from "../components/BaseHead.astro";
---
<!doctype html><html lang="en-GB"><head><BaseHead title="Support Centre | Trades Go Digital" description="Get help with TGD Trades, ask a question or create a support ticket." /></head>
<body><header><a href="/" aria-label="Trades Go Digital home"><img src="/images/trades-go-digital-logo-stripe.png" alt="Trades Go Digital" /></a><a class="login" href="https://president-trades.onrender.com">Return to TGD Trades</a></header>
<main><section class="hero"><p class="eyebrow">TGD TRADES SUPPORT CENTRE</p><h1>How can we help?</h1><p>Ask a question, create a support ticket or report a business-stopping problem even when you cannot sign in.</p><div class="routes"><a href="#assistant">Ask the support assistant</a><a href="#ticket">Create a support ticket</a><a class="danger" href="#emergency">Emergency support</a></div></section>

<section id="assistant" class="panel"><div><p class="eyebrow">QUICK HELP</p><h2>Support assistant</h2><p>Choose a question or type what you need help with. The assistant explains approved TGD Trades features and will direct you to a ticket when the answer is uncertain.</p></div><div class="assistant-box"><div class="quick"><button type="button">I cannot sign in</button><button type="button">How does Office Mailroom work?</button><button type="button">How do I prepare an accountant report?</button><button type="button">Where are my quotes and jobs?</button></div><label for="question">Your question</label><div class="ask"><input id="question" maxlength="300" placeholder="For example: Where do I upload a supplier receipt?"/><button id="ask" type="button">Ask</button></div><div id="answer" class="answer" aria-live="polite">Select a common question or type your own question.</div><p class="small">The assistant provides guidance only. It cannot access or change your account, and it will not claim a fault has been fixed.</p></div></section>

<section id="ticket" class="panel form-panel"><div><p class="eyebrow">CONTACT SUPPORT</p><h2>Create a support ticket</h2><p>You will receive a numbered reference. We use the account email to match the request to your TGD Trades account.</p></div><form id="support-form"><input name="website" class="trap" tabindex="-1" autocomplete="off"/><div class="grid"><label>Your name<input name="customer_name" maxlength="120" required autocomplete="name"/></label><label>Business name<input name="business_name" maxlength="160" autocomplete="organization"/></label><label>Account email<input name="account_email" type="email" maxlength="254" required autocomplete="email"/></label><label>Contact telephone<input name="phone" type="tel" maxlength="30" autocomplete="tel"/></label><label>Issue category<select name="category" required><option value="">Choose a category</option><option>Login or account access</option><option>Quotes</option><option>Jobs</option><option>Invoices</option><option>Office Mailroom</option><option>Accountant</option><option>Payments</option><option>Documents</option><option>Technical problem</option><option>General help</option></select></label><label>Page or feature<input name="page_name" maxlength="120" placeholder="For example: Quote page"/></label><label class="wide">Short title<input name="subject" maxlength="160" required placeholder="For example: Receipt will not file"/></label><label class="wide">Tell us what happened<textarea name="description" minlength="20" maxlength="5000" rows="6" required></textarea></label><label class="wide">Steps that caused the problem<textarea name="steps" maxlength="3000" rows="4" placeholder="What did you press, and what happened next?"></textarea></label><label>Preferred reply<select name="preferred_reply"><option value="email">Email</option><option value="phone">Telephone</option></select></label><label>Priority<select name="priority" id="priority"><option value="standard">Standard support</option><option value="emergency">Emergency — business stopping</option></select></label></div><div id="emergency" class="emergency"><strong>Emergency reports are only for complete loss of access, business-stopping faults or serious account and data concerns.</strong><span>They are placed at the top of the support queue. We confirm receipt immediately, but do not promise an instant human response.</span></div><label class="uploads">Screenshots — optional, up to three PNG, JPEG or WebP images, 2 MB each<input id="screenshots" type="file" accept="image/png,image/jpeg,image/webp" multiple/></label><div id="files" class="files"></div><label class="consent"><input name="consent" type="checkbox" required/> I understand that I must not include passwords, payment-card details or unnecessary customer information.</label><button class="submit" type="submit">Send support ticket</button><p id="status" role="status" aria-live="polite"></p></form><article id="result" class="result" hidden><p class="eyebrow">TICKET CREATED</p><h2>Your support request has been received</h2><strong id="ticket-number"></strong><p id="ticket-detail"></p><p>Keep this number. The same reference will be used on replies so the conversation remains together.</p><button type="button" id="another">Create another ticket</button></article></section>
</main><footer><span>Trades Go Digital Support</span><a href="mailto:support@trades-go-digital.co.uk">support@trades-go-digital.co.uk</a><a href="/terms-and-conditions#privacy-notice">Privacy Notice</a></footer>
<script>
const knowledge=[[/sign.?in|login|password|access/i,"If you cannot sign in, first check that you are using the account email registered with TGD Trades and use the password-reset option. If access is still blocked, create a ticket below and choose Login or account access. Use Emergency only when the loss of access stops urgent business work."],[/mailroom|receipt|supplier invoice/i,"Office Mailroom receives supported supplier receipts, invoices, bank statements and other business documents. Review the extracted details before filing. Supplier receipts can update approved material prices after review."],[/accountant|report|csv|vat quarter/i,"Open Business Office, Financial, then Accountant. Choose a month, VAT quarter, year to date or custom period. Check Expenses and Office Mailroom for missing documents, then download and review the PDF and CSV before sending."],[/quote|job/i,"Quotes and Jobs are available from the Workflow section. Customer details can be selected from Clients. Materials and Van Stock are available while preparing a quote, and accepted work can continue into the job flow."],[/video|guide/i,"Open Video Help from the TGD Trades Welcome and Support area for guided videos covering the dashboard, Business Office, Accountant and Office Mailroom."],[/invoice/i,"Invoices are stored in Business Office, Financial, Invoices. Check the customer details, totals and delivery status before sending or sharing the document."],[/./,"I cannot answer that confidently from the approved quick-help information. Please create a support ticket below so the support team can check your account and the exact problem."]];
const question=document.querySelector('#question'),answer=document.querySelector('#answer');function ask(value){question.value=value;answer.textContent=(knowledge.find(([rule])=>rule.test(value))||knowledge.at(-1))[1];}document.querySelectorAll('.quick button').forEach(button=>button.addEventListener('click',()=>ask(button.textContent)));document.querySelector('#ask').addEventListener('click',()=>ask(question.value.trim()));
const input=document.querySelector('#screenshots'),files=document.querySelector('#files');let images=[];input.addEventListener('change',async()=>{images=[];files.textContent='';for(const file of [...input.files].slice(0,3)){if(!['image/png','image/jpeg','image/webp'].includes(file.type)||file.size>2000000){files.textContent='Only PNG, JPEG or WebP screenshots up to 2 MB can be included.';images=[];return;}images.push(await new Promise(resolve=>{const reader=new FileReader();reader.onload=()=>resolve(reader.result);reader.readAsDataURL(file);}));}files.textContent=images.length?`${images.length} screenshot${images.length===1?'':'s'} ready to send.`:'No screenshots selected.';});
const form=document.querySelector('#support-form'),status=document.querySelector('#status'),result=document.querySelector('#result');form.addEventListener('submit',async event=>{event.preventDefault();const button=form.querySelector('.submit');button.disabled=true;status.textContent='Creating your ticket…';const data=Object.fromEntries(new FormData(form));data.screenshots=images;try{const response=await fetch('/api/support/tickets',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});const body=await response.json();if(!response.ok)throw new Error(body.error||'The ticket could not be created.');document.querySelector('#ticket-number').textContent=body.ticket_number;document.querySelector('#ticket-detail').textContent=body.priority==='emergency'?'Emergency priority — placed at the top of the queue.':'Standard priority — the support team will review it.';form.hidden=true;result.hidden=false;}catch(error){status.textContent=error.message||'The ticket could not be created. Please email support@trades-go-digital.co.uk.';}finally{button.disabled=false;}});document.querySelector('#another').addEventListener('click',()=>{form.reset();images=[];files.textContent='';status.textContent='';form.hidden=false;result.hidden=true;});
</script>
</body></html>
<style>
:global(*){box-sizing:border-box}:global(html){scroll-behavior:smooth}:global(body){margin:0;background:#eef2f6;color:#0b1930;font-family:Inter,ui-sans-serif,system-ui,sans-serif}header{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:18px max(20px,calc((100% - 1180px)/2));background:#07111f}header img{display:block;width:220px;max-width:55vw;background:#fff;border-radius:9px}.login,.routes a,.submit,.result button{display:inline-flex;align-items:center;justify-content:center;padding:12px 18px;border-radius:8px;background:#f97316;color:#07111f;font-weight:900;text-decoration:none;border:0;cursor:pointer}main{width:min(1180px,calc(100% - 32px));margin:auto;padding:54px 0 70px}.hero{padding:42px;border-radius:20px;background:linear-gradient(140deg,#07111f,#123152);color:#fff}.hero h1{margin:8px 0 12px;font-size:clamp(2.5rem,7vw,5rem);line-height:1}.hero>p:not(.eyebrow){max-width:760px;color:#c7d8e8;font-size:1.1rem}.eyebrow{margin:0;color:#f97316;font-size:.76rem;font-weight:950;letter-spacing:.12em}.routes{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}.routes a{background:#fff}.routes .danger{background:#dc2626;color:#fff}.panel{display:grid;grid-template-columns:minmax(250px,.7fr) minmax(0,1.3fr);gap:36px;margin-top:28px;padding:34px;border-radius:18px;background:#fff;box-shadow:0 12px 34px #07111f12}.panel h2{margin:7px 0 12px;font-size:2rem}.assistant-box{padding:22px;border-radius:14px;background:#f7f9fc}.quick{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:20px}.quick button{padding:9px 12px;border:1px solid #cbd5e1;border-radius:20px;background:#fff;cursor:pointer}.ask{display:grid;grid-template-columns:1fr auto;gap:8px}.ask input,input,select,textarea{width:100%;padding:12px;border:1px solid #b9c5d3;border-radius:8px;font:inherit}.ask button{padding:0 20px;border:0;border-radius:8px;background:#07111f;color:#fff;font-weight:900}.answer{margin-top:14px;padding:16px;border-left:4px solid #f97316;background:#fff;line-height:1.65}.small{color:#64748b;font-size:.82rem}.form-panel{grid-template-columns:1fr}.grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.grid label,.uploads{font-weight:800}.grid input,.grid select,.grid textarea,.uploads input{margin-top:7px;font-weight:400}.wide{grid-column:1/-1}.emergency{display:grid;gap:6px;margin:18px 0;padding:16px;border:1px solid #fecaca;border-radius:10px;background:#fef2f2;color:#991b1b}.uploads{display:block;margin-top:18px}.consent{display:flex;gap:9px;align-items:flex-start;margin:18px 0;color:#475569}.consent input{width:auto;margin-top:4px}.submit{font-size:1rem}.submit:disabled{opacity:.6}.files,#status{color:#475569}.result{padding:24px;border:2px solid #f97316;border-radius:14px;background:#fff7ed}.result>strong{display:block;margin:15px 0;font-size:clamp(1.5rem,4vw,2.4rem)}.trap{position:absolute;left:-9999px}.danger:target{outline:3px solid red}footer{display:flex;flex-wrap:wrap;justify-content:center;gap:16px 28px;padding:28px;background:#07111f;color:#c7d8e8}footer a{color:#fff}@media(max-width:760px){header{align-items:stretch;flex-direction:column}.login{width:100%}main{padding-top:26px}.hero,.panel{padding:24px}.panel{grid-template-columns:1fr}.grid{grid-template-columns:1fr}.wide{grid-column:auto}.ask{grid-template-columns:1fr}.ask button{min-height:44px}}
</style>
