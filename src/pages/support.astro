---
import BaseHead from "../components/BaseHead.astro";
import { SUPPORT_COOKIE, verifySupportToken } from "../lib/support-access";
export const prerender = false;
const env = Astro.locals.runtime.env;
const accessToken = Astro.url.searchParams.get("access") || undefined;
if (accessToken && await verifySupportToken(accessToken, env.SUPPORT_PORTAL_SECRET)) {
	Astro.cookies.set(SUPPORT_COOKIE, accessToken, { httpOnly: true, secure: true, sameSite: "strict", path: "/", maxAge: 3600 });
	return Astro.redirect("/support");
}
const subscriber = await verifySupportToken(Astro.cookies.get(SUPPORT_COOKIE)?.value, env.SUPPORT_PORTAL_SECRET);
if (!subscriber) return Astro.redirect("https://president-trades.onrender.com");
---
<!doctype html><html lang="en-GB"><head><BaseHead title="Support Centre | Trades Go Digital" description="Get help with TGD Trades, ask a question or create a support ticket." /></head>
<body><header><a href="/" aria-label="Trades Go Digital home"><img src="/images/trades-go-digital-logo-stripe.png" alt="Trades Go Digital" /></a><a class="login" href="https://president-trades.onrender.com">Return to TGD Trades</a></header>
<main><section class="hero"><p class="eyebrow">TGD TRADES SUPPORT CENTRE</p><h1>How can we help?</h1><p>Ask a question, create a support ticket or report a business-stopping problem even when you cannot sign in.</p><div class="routes"><a href="#assistant">Ask the support assistant</a><a href="#ticket">Create a support ticket</a><a class="danger" href="#emergency">Emergency support</a></div></section>

<div class="support-workspace"><section id="ticket" class="panel form-panel"><div><p class="eyebrow">CONTACT SUPPORT</p><h2>Create a support ticket</h2><p>You will receive a numbered reference. We use the account email to match the request to your TGD Trades account.</p></div><form id="support-form"><input name="website" class="trap" tabindex="-1" autocomplete="off"/><div class="grid"><label>Your name<input name="customer_name" maxlength="120" required autocomplete="name"/></label><label>Business name<input name="business_name" maxlength="160" autocomplete="organization"/></label><label>Account email<input name="account_email" type="email" maxlength="254" required autocomplete="email"/></label><label>Contact telephone<input name="phone" type="tel" maxlength="30" autocomplete="tel"/></label><label>Issue category<select name="category" required><option value="">Choose a category</option><option>Login or account access</option><option>Quotes</option><option>Jobs</option><option>Invoices</option><option>Office Mailroom</option><option>Accountant</option><option>Payments</option><option>Documents</option><option>Technical problem</option><option>General help</option></select></label><label>Page or feature<input name="page_name" maxlength="120" placeholder="For example: Quote page"/></label><label class="wide">Short title<input name="subject" maxlength="160" required placeholder="For example: Receipt will not file"/></label><label class="wide">Tell us what happened<textarea name="description" minlength="20" maxlength="5000" rows="6" required></textarea></label><label class="wide">Steps that caused the problem<textarea name="steps" maxlength="3000" rows="4" placeholder="What did you press, and what happened next?"></textarea></label><label>Preferred reply<select name="preferred_reply"><option value="email">Email</option><option value="phone">Telephone</option></select></label><label>Priority<select name="priority" id="priority"><option value="standard">Standard support</option><option value="emergency">Emergency — business stopping</option></select></label></div><div id="emergency" class="emergency"><strong>Emergency reports are only for complete loss of access, business-stopping faults or serious account and data concerns.</strong><span>They are placed at the top of the support queue. We confirm receipt immediately, but do not promise an instant human response.</span></div><label class="uploads">Screenshots — optional, up to three PNG, JPEG or WebP images, 2 MB each<input id="screenshots" type="file" accept="image/png,image/jpeg,image/webp" multiple/></label><div id="files" class="files"></div><label class="consent"><input name="consent" type="checkbox" required/> I understand that I must not include passwords, payment-card details or unnecessary customer information.</label><button class="submit" type="submit">Send support ticket</button><p id="status" role="status" aria-live="polite"></p></form><article id="result" class="result" hidden><p class="eyebrow">TICKET CREATED</p><h2>Your support request has been received</h2><strong id="ticket-number"></strong><p id="ticket-detail"></p><p>Keep this number. The same reference will be used on replies so the conversation remains together.</p><button type="button" id="another">Create another ticket</button></article></section>
<aside id="assistant" class="chat-panel" aria-label="TGD Trades AI support"><div class="chat-heading"><div><p class="eyebrow">AI QUICK HELP</p><h2>Ask TGD Support</h2></div><button id="chat-close" type="button" aria-label="Close support chat">×</button></div><p class="chat-intro">Ask about any TGD Trades page or flow. If your problem needs investigation, move the conversation into a ticket.</p><div id="chat-messages" class="chat-messages" aria-live="polite"><div class="message assistant">Hello, I’m the TGD Trades support assistant. What can I help you with?</div></div><div class="quick"><button type="button">I cannot sign in</button><button type="button">How does Office Mailroom work?</button><button type="button">How do I prepare an accountant report?</button><button type="button">Where are my quotes and jobs?</button></div><form id="chat-form" class="chat-form"><label for="chat-question">Your question</label><div class="ask"><input id="chat-question" maxlength="800" autocomplete="off" placeholder="Type your question…" required/><button type="submit">Send</button></div></form><button id="transfer-chat" class="transfer-chat" type="button">Move this chat into a support ticket</button><p class="small">AI guidance can make mistakes. It cannot access or change your account. Never include passwords or card details.</p></aside></div><button id="chat-launcher" class="chat-launcher" type="button" aria-controls="assistant" aria-expanded="false">Chat with TGD Support</button>
</main><footer><span>Trades Go Digital Support</span><a href="mailto:support@trades-go-digital.co.uk">support@trades-go-digital.co.uk</a><a href="/terms-and-conditions#privacy-notice">Privacy Notice</a></footer>
<script>
const chat=document.querySelector('#assistant'),launcher=document.querySelector('#chat-launcher'),closeChat=document.querySelector('#chat-close'),chatForm=document.querySelector('#chat-form'),chatQuestion=document.querySelector('#chat-question'),chatMessages=document.querySelector('#chat-messages'),transferChat=document.querySelector('#transfer-chat');
const conversation=[];function addMessage(role,text){const message=document.createElement('div');message.className=`message ${role}`;message.textContent=text;chatMessages.append(message);chatMessages.scrollTop=chatMessages.scrollHeight;}function setChat(open){chat.classList.toggle('is-open',open);launcher.setAttribute('aria-expanded',String(open));if(open)chatQuestion.focus();}launcher.addEventListener('click',()=>setChat(!chat.classList.contains('is-open')));closeChat.addEventListener('click',()=>setChat(false));
document.querySelector('.routes a[href="#assistant"]').addEventListener('click',event=>{if(window.matchMedia('(max-width: 1050px)').matches){event.preventDefault();setChat(true);}});
async function askSupport(value){const question=value.trim();if(!question)return;addMessage('user',question);conversation.push({role:'user',content:question});chatQuestion.value='';const waiting=document.createElement('div');waiting.className='message assistant waiting';waiting.textContent='Thinking…';chatMessages.append(waiting);chatMessages.scrollTop=chatMessages.scrollHeight;chatForm.querySelector('button').disabled=true;try{const response=await fetch('/api/support/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({messages:conversation.slice(-8)})});const body=await response.json();if(!response.ok)throw new Error(body.error||'AI support is temporarily unavailable.');waiting.remove();addMessage('assistant',body.answer);conversation.push({role:'assistant',content:body.answer});}catch(error){waiting.remove();addMessage('assistant',`${error.message||'AI support is temporarily unavailable.'} You can move this conversation into a support ticket so the team can help.`);}finally{chatForm.querySelector('button').disabled=false;chatQuestion.focus();}}chatForm.addEventListener('submit',event=>{event.preventDefault();askSupport(chatQuestion.value);});document.querySelectorAll('.quick button').forEach(button=>button.addEventListener('click',()=>askSupport(button.textContent)));
transferChat.addEventListener('click',()=>{const userQuestions=conversation.filter(message=>message.role==='user').map(message=>message.content);const fullChat=conversation.map(message=>`${message.role==='user'?'Customer':'AI support'}: ${message.content}`).join('\n\n');const subject=document.querySelector('[name="subject"]'),description=document.querySelector('[name="description"]'),category=document.querySelector('[name="category"]'),pageName=document.querySelector('[name="page_name"]');if(!subject.value)subject.value=(userQuestions.at(-1)||'Support chat follow-up').slice(0,160);if(!description.value)description.value=`Please review this support chat:\n\n${fullChat||'The customer requested help through AI support.'}`.slice(0,5000);category.value='General help';if(!pageName.value)pageName.value='Website AI support';document.querySelector('#ticket').scrollIntoView({behavior:'smooth'});setChat(false);});
const input=document.querySelector('#screenshots'),files=document.querySelector('#files');let images=[];input.addEventListener('change',async()=>{images=[];files.textContent='';for(const file of [...input.files].slice(0,3)){if(!['image/png','image/jpeg','image/webp'].includes(file.type)||file.size>2000000){files.textContent='Only PNG, JPEG or WebP screenshots up to 2 MB can be included.';images=[];return;}images.push(await new Promise(resolve=>{const reader=new FileReader();reader.onload=()=>resolve(reader.result);reader.readAsDataURL(file);}));}files.textContent=images.length?`${images.length} screenshot${images.length===1?'':'s'} ready to send.`:'No screenshots selected.';});
const form=document.querySelector('#support-form'),status=document.querySelector('#status'),result=document.querySelector('#result');form.addEventListener('submit',async event=>{event.preventDefault();const button=form.querySelector('.submit');button.disabled=true;status.textContent='Creating your ticket…';const data=Object.fromEntries(new FormData(form));data.screenshots=images;try{const response=await fetch('/api/support/tickets',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});const body=await response.json();if(!response.ok)throw new Error(body.error||'The ticket could not be created.');document.querySelector('#ticket-number').textContent=body.ticket_number;document.querySelector('#ticket-detail').textContent=body.priority==='emergency'?'Emergency priority — placed at the top of the queue.':'Standard priority — the support team will review it.';form.hidden=true;result.hidden=false;}catch(error){status.textContent=error.message||'The ticket could not be created. Please email support@trades-go-digital.co.uk.';}finally{button.disabled=false;}});document.querySelector('#another').addEventListener('click',()=>{form.reset();images=[];files.textContent='';status.textContent='';form.hidden=false;result.hidden=true;});
</script>
</body></html>
<style>
:global(*){box-sizing:border-box}:global(html){scroll-behavior:smooth}:global(body){margin:0;background:#eef2f6;color:#0b1930;font-family:Inter,ui-sans-serif,system-ui,sans-serif}header{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:18px max(32px,calc((100% - 1720px)/2));background:#07111f}header img{display:block;width:220px;max-width:55vw;background:#fff;border-radius:9px}.login,.routes a,.submit,.result button{display:inline-flex;align-items:center;justify-content:center;padding:12px 18px;border-radius:8px;background:#f97316;color:#07111f;font-weight:900;text-decoration:none;border:0;cursor:pointer}main{width:min(1720px,calc(100% - 64px));margin:auto;padding:42px 0 90px}.hero{padding:52px 58px;border-radius:12px;background:linear-gradient(140deg,#07111f,#123152);color:#fff}.hero h1{margin:8px 0 12px;font-size:clamp(2.5rem,6vw,4.8rem);line-height:1}.hero>p:not(.eyebrow){max-width:900px;color:#c7d8e8;font-size:1.1rem}.eyebrow{margin:0;color:#f97316;font-size:.76rem;font-weight:950;letter-spacing:.12em}.routes{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}.routes a{background:#fff}.routes .danger{background:#dc2626;color:#fff}.support-workspace{display:grid;grid-template-columns:minmax(0,1fr) minmax(480px,560px);gap:60px;align-items:start}.panel{padding:54px 0 64px;border-bottom:1px solid #cbd5e1;background:transparent}.panel h2,.chat-panel h2{margin:7px 0 12px;font-size:2rem}.form-panel>div:first-child{max-width:860px;margin-bottom:34px}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.grid label,.uploads{font-weight:800}.grid input,.grid select,.grid textarea,.uploads input{margin-top:8px;font-weight:400}input,select,textarea{width:100%;padding:13px;border:1px solid #b9c5d3;border-radius:8px;background:#fff;font:inherit}.wide{grid-column:1/-1}.emergency{display:grid;gap:7px;margin:22px 0;padding:18px;border:1px solid #fecaca;border-radius:8px;background:#fef2f2;color:#991b1b}.uploads{display:block;margin-top:22px}.consent{display:flex;gap:9px;align-items:flex-start;margin:22px 0;color:#475569}.consent input{width:auto;margin-top:4px}.submit{font-size:1rem}.submit:disabled{opacity:.6}.files,#status{color:#475569}.result{padding:24px;border:2px solid #f97316;border-radius:10px;background:#fff7ed}.result>strong{display:block;margin:15px 0;font-size:clamp(1.5rem,4vw,2.4rem)}.chat-panel{position:sticky;top:24px;display:flex;flex-direction:column;min-height:720px;max-height:calc(100vh - 48px);margin-top:54px;padding:32px;border-top:6px solid #f97316;border-radius:14px;background:#fff;box-shadow:0 18px 48px #07111f1a}.chat-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:14px}.chat-heading h2{font-size:2rem}.chat-heading button{display:none;border:0;background:transparent;font-size:2rem;line-height:1;cursor:pointer}.chat-intro{max-width:470px;margin:0 0 8px;color:#475569;font-size:1rem;line-height:1.6}.chat-messages{display:flex;flex:1;flex-direction:column;gap:12px;min-height:330px;max-height:500px;margin:10px 0 20px;padding:18px;overflow:auto;border:1px solid #dbe3ec;border-radius:12px;background:#f7f9fc}.message{max-width:86%;padding:13px 15px;border-radius:12px;font-size:.98rem;line-height:1.55;white-space:pre-wrap}.message.assistant{align-self:flex-start;background:#fff;border:1px solid #dbe3ec}.message.user{align-self:flex-end;background:#123152;color:#fff}.message.waiting{color:#64748b;font-style:italic}.quick{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-bottom:20px}.quick button{min-height:44px;padding:9px 12px;border:1px solid #cbd5e1;border-radius:9px;background:#fff;color:#0b1930;text-align:left;cursor:pointer}.chat-form label{display:block;margin-bottom:8px;font-weight:800}.ask{display:grid;grid-template-columns:1fr auto;gap:10px}.ask button{padding:0 20px;border:0;border-radius:8px;background:#07111f;color:#fff;font-weight:900;cursor:pointer}.ask button:disabled{opacity:.6}.transfer-chat{width:100%;margin-top:14px;padding:13px;border:1px solid #f97316;border-radius:8px;background:#fff7ed;color:#9a3412;font-weight:900;cursor:pointer}.small{color:#64748b;font-size:.82rem;line-height:1.55}.chat-launcher{display:none}.trap{position:absolute;left:-9999px}.danger:target{outline:3px solid red}footer{display:flex;flex-wrap:wrap;justify-content:center;gap:16px 28px;padding:28px;background:#07111f;color:#c7d8e8}footer a{color:#fff}@media(max-width:1500px){.support-workspace{grid-template-columns:minmax(0,1fr) minmax(430px,480px);gap:42px}.grid{grid-template-columns:1fr 1fr}.chat-panel{padding:28px}.quick{grid-template-columns:1fr}}@media(max-width:1050px){.support-workspace{display:block}.chat-panel{position:fixed;top:0;right:0;z-index:50;width:min(520px,100%);height:100dvh;min-height:0;max-height:none;margin:0;border-radius:0;transform:translateX(105%);transition:transform .25s ease}.chat-panel.is-open{transform:translateX(0)}.chat-heading button{display:block}.chat-messages{max-height:none}.quick{grid-template-columns:1fr 1fr}.chat-launcher{position:fixed;right:18px;bottom:18px;z-index:40;display:block;padding:14px 18px;border:0;border-radius:28px;background:#f97316;color:#07111f;font-weight:950;box-shadow:0 8px 24px #07111f40;cursor:pointer}}@media(max-width:760px){header{align-items:stretch;flex-direction:column;padding:18px 20px}.login{width:100%}main{width:min(100% - 32px,1720px);padding-top:20px}.hero{padding:28px 24px}.panel{padding:36px 4px 48px}.grid{grid-template-columns:1fr}.wide{grid-column:auto}.chat-panel{padding:24px}.quick{grid-template-columns:1fr}.ask{grid-template-columns:1fr}.ask button{min-height:44px}}
</style>
