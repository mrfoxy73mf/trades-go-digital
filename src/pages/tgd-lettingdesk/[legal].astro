---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

export const prerender = false;

const pages = {
	"buyer-terms": {
		title: "TGD LettingDesk Buyer Terms",
		intro: "The terms applying when a business purchases a TGD LettingDesk source-code licence.",
		sections: [
			["Licence grant", "After cleared payment, the buyer receives a private copy of the TGD LettingDesk application source code under a non-exclusive commercial licence for one business."],
			["Permitted use", "The buyer may install, configure, brand and modify its copy for its own letting-agency or property-operations business."],
			["Restrictions", "The source code may not be resold, sublicensed, redistributed, published or made available to another business or third party."],
			["Installation", "Self-installation guidance is included with the software-only licence. The remote-installation package includes remote installation, initial configuration, branding and acceptance testing. No on-site attendance is provided. The customer must supply a compatible Windows computer, internet connection and authorised remote access. Training, additional development and ongoing support are separate unless expressly included in the order."],
			["Third-party costs", "Hosting, domains, databases, email, monitoring, payment providers and API usage are arranged and paid for separately unless agreed in writing."],
		],
	},
	"commercial-licence": {
		title: "TGD LettingDesk Commercial Licence",
		intro: "The licence governing commercial use of a private TGD LettingDesk copy.",
		sections: [
			["Scope", "The licence permits one business to operate and brand its private copy of TGD LettingDesk for its own commercial property operations."],
			["Non-exclusive licence", "The licence is non-exclusive. Trades Go Digital may license the original software to other businesses."],
			["Ownership", "Trades Go Digital retains ownership of the original software. The buyer owns and controls the operational data entered into its deployed copy."],
			["Updates and support", "The purchase covers the current stable version supplied. Future updates and ongoing support are not automatically included unless agreed separately."],
			["No redistribution", "The buyer may not sell, sublicense, distribute or publish the original or modified source code."],
		],
	},
	"privacy": {
		title: "TGD LettingDesk Privacy Information",
		intro: "How information is handled during sales enquiries and within a customer-controlled deployment.",
		sections: [
			["Sales enquiries", "Trades Go Digital uses contact details supplied during an enquiry to respond, discuss requirements and process an agreed order."],
			["Customer deployments", "Operational data is held on infrastructure selected and controlled by the customer. Trades Go Digital does not access that data unless access is requested for agreed support."],
			["Third-party services", "A customer may choose hosting, email, monitoring, AI or payment providers. Their own privacy terms apply to those services."],
			["Contact", "Privacy questions can be sent to hello@trades-go-digital.co.uk."],
		],
	},
	"terms": {
		title: "TGD LettingDesk Website Terms",
		intro: "Important information about the TGD LettingDesk product pages and published pricing.",
		sections: [
			["Product information", "Website descriptions explain the current product offer but do not replace the final written order, buyer terms or commercial licence."],
			["Pricing", "Published prices are in GBP. Trades Go Digital is not VAT registered, so no VAT is charged. Remote installation is included only in the package that expressly states it. Hosting, third-party services, support and additional work are separate unless specifically included."],
			["Software limitations", "Software is not warranted to be error-free or uninterrupted. AI-assisted features support controlled investigation and do not guarantee autonomous resolution."],
			["Professional advice", "TGD LettingDesk is operational software and is not a substitute for legal, tax or accounting advice."],
			["Governing law", "These terms are governed by the laws of England and Wales."],
		],
	},
};

const slug = Astro.params.legal ?? "";
const page = pages[slug];
if (!page) return Astro.redirect("/tgd-lettingdesk");
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${page.title} | Trades Go Digital`} description={page.intro} />
	</head>
	<body>
		<Header />
		<main>
			<div class="legal-shell">
				<a class="back" href="/tgd-lettingdesk">← Back to TGD LettingDesk</a>
				<p class="eyebrow">TGD LettingDesk</p>
				<h1>{page.title}</h1>
				<p class="intro">{page.intro}</p>
				<div class="sections">
					{page.sections.map(([heading, body]) => (
						<section>
							<h2>{heading}</h2>
							<p>{body}</p>
						</section>
					))}
				</div>
				<p class="contact">Questions: <a href="mailto:hello@trades-go-digital.co.uk">hello@trades-go-digital.co.uk</a></p>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	:global(body) { margin: 0; background: #faf7f2; color: #101a2e; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
	main { padding: 70px 18px 96px; background: radial-gradient(circle at 86% 0, rgba(37,99,235,.10), transparent 28rem); }
	.legal-shell { width: min(860px, 100%); margin: 0 auto; }
	.back { display: inline-flex; margin-bottom: 38px; color: #2563eb; font-weight: 850; text-decoration: none; }
	.eyebrow { margin: 0 0 14px; color: #f97316; font-size: .76rem; font-weight: 950; letter-spacing: .12em; text-transform: uppercase; }
	h1 { max-width: 760px; margin: 0; font-size: clamp(2.4rem, 6vw, 4.6rem); line-height: 1; letter-spacing: -.05em; }
	.intro { max-width: 720px; margin: 22px 0 38px; color: #5b6577; font-size: 1.13rem; line-height: 1.7; }
	.sections { display: grid; gap: 14px; }
	section { padding: 25px; border: 1px solid rgba(16,26,46,.13); border-radius: 16px; background: #fff; box-shadow: 0 16px 42px rgba(16,26,46,.06); }
	h2 { margin: 0 0 10px; font-size: 1.25rem; }
	section p { margin: 0; color: #5b6577; line-height: 1.7; }
	.contact { margin: 28px 0 0; color: #626d80; }
	.contact a { color: #2563eb; font-weight: 850; }
</style>
